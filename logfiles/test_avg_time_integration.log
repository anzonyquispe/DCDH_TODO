. ********************************************************************************
. * Helper: write one row to the comparison CSV
. ********************************************************************************
. capture program drop _write_csv_row

. program _write_csv_row
  1.         syntax, scenario(string) integrated(real) standalone(real) csvfile(string)
  2.         local diff     = `integrated' - `standalone'
  3.         local abs_diff = abs(`diff')
  4.         local pass     = cond(`abs_diff' < 1e-6, "PASS", "FAIL")
  5.         file open _fh using "`csvfile'", write append
  6.         file write _fh "`scenario',`integrated',`standalone',`diff',`pass'" _n
  7.         file close _fh
  8. end

. 
. * Initialise CSV
. local csvfile "logfiles/avg_time_integration_results.csv"

. capture erase "`csvfile'"

. file open _fh using "`csvfile'", write replace
(file logfiles/avg_time_integration_results.csv not found)

. file write _fh "scenario,integrated,standalone,diff,pass" _n

. file close _fh

. 
. * Initialise result locals to missing so the CSV still gets a row on failure
. foreach s in s1 s2 s3 s4 s5 {
  2.         local integrated_`s' .
  3.         local standalone_`s'  .
  4. }

. 
. 
