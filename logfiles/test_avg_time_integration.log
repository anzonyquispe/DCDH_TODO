. foreach s_label in ///
>         "gentzkowetal_eff4_noreset   " ///
>         "gentzkowetal_eff4_dropmiss  " ///
>         "gentzkowetal_eff4_reset1    " ///
>         "fakedata_eff4               " ///
>         "fakedata_eff1               " {
  2.         local idx : word count `s_label'
  3. }

. 
. local labels `" "S1 gentzkow noreset " "S2 gentzkow dropmiss" "S3 gentzkow reset1  " "S4 fakedata eff4    " "S5 fakedata e
> ff1    " "'

. local ints   `integrated_s1'   `integrated_s2'   `integrated_s3'   `integrated_s4'   `integrated_s5'

. local stans  `standalone_s1'   `standalone_s2'   `standalone_s3'   `standalone_s4'   `standalone_s5'

. 
. local n_pass 0

. local n_fail 0

. forvalues k = 1/5 {
  2.         local lbl  : word `k' of `labels'
  3.         local intv : word `k' of `ints'
  4.         local stav : word `k' of `stans'
  5.         if missing(`intv') | missing(`stav') {
  6.                 di as text "`lbl'   (missing — see error above)"
  7.                 local ++n_fail
  8.         }
  9.         else {
 10.                 local d = `intv' - `stav'
 11.                 local status = cond(abs(`d') < 1e-6, "PASS", "FAIL")
 12.                 di as text "`lbl'  " %12.7g `intv' "  " %12.7g `stav' "  " %12.3e `d' "  `status'"
 13.                 if "`status'" == "PASS" local ++n_pass
 14.                 else                    local ++n_fail
 15.         }
 16. }
