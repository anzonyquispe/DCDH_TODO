. qui do "code/avg_cumul_periods_func.do"

. 
. local csvfile "logfiles/switchers_b3.csv"

. capture erase "`csvfile'"

. file open _fh using "`csvfile'", write replace
(file logfiles/switchers_b3.csv not found)

. file write _fh "dataset,spec,reset,effect_num,N_did,N_avg,diff,pass" _n

. file close _fh

. 
. capture program drop _swrow

. program _swrow
  1.     syntax, dataset(string) spec(string) reset(integer) ///
>         effnum(integer) ndid(string) navg(string) csvfile(string)
  2.     if missing(real("`ndid'")) | missing(real("`navg'")) {
  3.         local diff .
  4.         local pass "MISS"
  5.     }
  6.     else {
  7.         local diff = real("`ndid'") - real("`navg'")
  8.         local pass = cond(`diff' == 0, "PASS", "FAIL")
  9.     }
 10.     file open _fh using "`csvfile'", write append
 11.     file write _fh "`dataset',`spec',`reset',`effnum',`ndid',`navg',`diff'
> ,`pass'" _n
 12.     file close _fh
 13.     if "`pass'" == "FAIL" di as error "  FAIL  `dataset' `spec' k=`effnum'
>   did=`ndid'  avg=`navg'"
 14.     else if "`pass'" == "MISS" di as error "  MISS  `dataset' `spec' k=`ef
> fnum'  did=`ndid'  avg=`navg'"
 15.     else                       di as text  "  PASS  `dataset' `spec' k=`ef
> fnum'  did=`ndid'  avg=`navg'"
 16. end

. 
. capture program drop _diagrow

. program _diagrow
  1.     syntax, dataset(string) spec(string) reset(integer) msg(string) csvfil
> e(string)
  2.     file open _fh using "`csvfile'", write append
  3.     file write _fh "`dataset',`spec',`reset',-1,.,.,.,ERROR:`msg'" _n
  4.     file close _fh
  5. end

. 
