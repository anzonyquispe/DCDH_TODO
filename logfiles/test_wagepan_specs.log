. di as text "=== test_wagepan_specs  started: $S_DATE $S_TIME ==="
=== test_wagepan_specs  started: 24 Jun 2026 22:30:21 ===

. 
. * Load the DEV version (overrides any SSC version of did_multiplegt_dyn)
. qui do "code/did_multiplegt_dyn_reset.do"

. 
. ********************************************************************************
. * Dataset & spec configuration
. ********************************************************************************
. local data    "_data/wagepan.dta"

. local y       lwage

. local g       nr

. local t       year

. local d       union

. local cont    hours

. local nonparam black

. local wght    educ

. local clust   hisp

. local n_eff   5

. local n_pl    2

. local b_reps  20

. local b_seed  1234

. local eff_eq  all

. 
. ********************************************************************************
. * CSV setup
. ********************************************************************************
. local csvfile "logfiles/wagepan_specs.csv"

. capture erase "`csvfile'"

. file open _fh using "`csvfile'", write replace
(file logfiles/wagepan_specs.csv not found)

. file write _fh "spec,effect_num,N_std,N_avg,diff,pass" _n

. file close _fh

. 
. capture program drop _wrow

. program _wrow
  1.     syntax, spec(string) effnum(integer) nstd(string) navg(string) csvfile(string)
  2.     if missing(real("`nstd'")) | missing(real("`navg'")) {
  3.         local diff .
  4.         local pass "MISS"
  5.     }
  6.     else {
  7.         local diff = real("`nstd'") - real("`navg'")
  8.         local pass = cond(`diff' == 0, "PASS", "FAIL")
  9.     }
 10.     file open _fh using "`csvfile'", write append
 11.     file write _fh "`spec',`effnum',`nstd',`navg',`diff',`pass'" _n
 12.     file close _fh
 13.     if "`pass'" == "FAIL" di as error "    FAIL `spec' eff=`effnum'  std=`nstd'  avg=`navg'"
 14.     else if "`pass'" == "MISS" di as error "    MISS `spec' eff=`effnum'  std=`nstd'  avg=`navg'"
 15.     else                       di as text  "    PASS `spec' eff=`effnum'  std=`nstd'  avg=`navg'"
 16. end

. 
. capture program drop _err

. program _err
  1.     syntax, spec(string) msg(string) csvfile(string)
  2.     file open _fh using "`csvfile'", write append
  3.     file write _fh "`spec',-1,.,.,.,ERROR:`msg'" _n
  4.     file close _fh
  5. end

. 
. ********************************************************************************
. * Helper macro: run one spec, capture, write rows
. *   Usage: _run_spec "spec_label" "did options without leading comma"
. *   Always appends avg_time_periods to the options.
. ********************************************************************************
. capture program drop _run_spec

. program _run_spec
  1.     args spec opts
  2.     di as text _newline "{hline 78}"
  3.     di as text "SPEC: `spec'    options: `opts'"
  4.     di as text "{hline 78}"
  5. 
.     use "$data_path_int", clear
  6.     capture noisily did_multiplegt_dyn $y_int $g_int $t_int $d_int, ///
>         `opts' avg_time_periods graph_off
  7.     local rc = _rc
  8.     di as text "  rc = `rc'"
  9. 
.     if `rc' != 0 & `rc' != 111 {
 10.         _err, spec("`spec'") msg("rc_`rc'") csvfile("$csvfile_int")
 11.         exit
 12.     }
 13. 
.     forvalues k = 1/$n_eff_int {
 14.         local nstd = e(N_switchers_effect_`k')
 15.         local navg = e(N_switch_avg_`k')
 16.         if missing(real("`nstd'")) & missing(real("`navg'")) {
 17.             continue, break
 18.         }
 19.         _wrow, spec("`spec'") effnum(`k') ///
>             nstd("`nstd'") navg("`navg'") csvfile("$csvfile_int")
 20.     }
 21. end

. 
. * Export config via globals so _run_spec can see them
. global data_path_int   "`data'"

. global y_int           "`y'"

. global g_int           "`g'"

. global t_int           "`t'"

. global d_int           "`d'"

. global n_eff_int       "`n_eff'"

. global csvfile_int     "`csvfile'"

. 
. ********************************************************************************
. * Spec list (Bookmark #1) — only specs where avg_time_periods is meaningful
. * (continuous() is skipped by the avg_time_periods block per the dev file).
. ********************************************************************************
. 
