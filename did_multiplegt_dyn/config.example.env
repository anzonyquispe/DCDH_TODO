# Copy to config.env and fill in. run_tests.sh asks for anything missing.
# Which package versions to test -- there are NO defaults:
#   DCDH_STATA_ADO : a did_multiplegt_dyn.ado file, the folder that contains it, or installed
#   DCDH_R_PKG     : installed, a package source folder (has DESCRIPTION), a .tar.gz, or a library folder
#   DCDH_PY_PKG    : installed, or the folder that contains the did_multiplegt_dyn package (e.g. .../src)
DCDH_STATA_ADO=
DCDH_R_PKG=
DCDH_PY_PKG=
# Optional: interpreters (auto-detected otherwise)
# STATA_BIN=C:/Program Files/Stata18/StataMP-64.exe
# RSCRIPT=Rscript
# PYTHON=python
