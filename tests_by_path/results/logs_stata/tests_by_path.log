. *------------------------------------------------------------------------------
. * 2. Helper programs
. *------------------------------------------------------------------------------
. 
. * Write one CSV row. Every field is optional so empty values are safe.
. capture program drop _bp_write

. program define _bp_write
  1.         syntax , fh(string) case(string) [path(string) order(string) ngroups(string) ///
>                 row(string) est(string) se(string) lb(string) ub(string) n(string)     ///
>                 sw(string) source(string) status(string) msg(string)]
  2.         local q = char(34)
  3.         local msg = subinstr(`"`msg'"', `"""', "'", .)
  4.         file write `fh' `"`case',`q'`path'`q',`order',`ngroups',`row',`est',`se',`lb',`ub',`n',`sw',`source',`status',`q'`msg'`q'"' _n
  5. end

. 
. * Full-precision string of a number; empty when missing.
. capture program drop _bp_num

. program define _bp_num, rclass
  1.         args x
  2.         if missing(`x') return local s ""
  3.         else return local s = strtrim(strofreal(`x', "%21.17g"))
  4. end

. 
. * Parse the text log of one by_path run and write source=display rows.
. * ngroups for each path label comes from the globals left by the command.
. capture program drop _bp_parse_log

. program define _bp_parse_log
  1.         args logfile fh case npaths
  2.         forvalues k = 1/`npaths' {
  3.                 local lab_`k' `"${path_`k'_XX}"'
  4.                 local ng_`k'  `"${num_g_path_`k'_XX}"'
  5.         }
  6.         tempname lf
  7.         local path ""
  8.         local order 0
  9.         local ng ""
 10.         file open `lf' using `"`logfile'"', read text
 11.         file read `lf' line
 12.         while r(eof) == 0 {
 13.                 if ustrregexm(`"`macval(line)'"', "^ *Path \((.*)\) *$") {
 14.                         local p = ustrregexs(1)
 15.                         if `"`p'"' != `"`path'"' {
 16.                                 local path `"`p'"'
 17.                                 local ++order
 18.                                 local ng ""
 19.                                 forvalues k = 1/`npaths' {
 20.                                         if `"`lab_`k''"' == `"`path'"' local ng "`ng_`k''"
 21.                                 }
 22.                         }
 23.                 }
 24.                 else if `"`path'"' != "" & ustrregexm(`"`macval(line)'"', "^ *(Effect_[0-9]+|Av_tot_eff|Placebo_[0-9]+) *\|(.*)$") {
 25.                         local rn = ustrregexs(1)
 26.                         local vals = ustrregexs(2)
 27.                         tokenize `"`vals'"'
 28.                         forvalues j = 1/6 {
 29.                                 if `"``j''"' == "." local `j' ""
 30.                         }
 31.                         _bp_write, fh(`fh') case(`case') path(`path') order(`order') ngroups(`ng') ///
>                                 row(`rn') est(`1') se(`2') lb(`3') ub(`4') n(`5') sw(`6') source(display) status(ok)
 32.                 }
 33.                 else if `"`path'"' != "" & ustrregexm(`"`macval(line)'"', "Test of joint nullity of the (effects|placebos) : p-value = *([^ ]+)") {
 34.                         local which = ustrregexs(1)
 35.                         local pv = ustrregexs(2)
 36.                         if "`pv'" == "." local pv ""
 37.                         local rn = cond("`which'" == "effects", "p_joint_effects", "p_joint_placebos")
 38.                         _bp_write, fh(`fh') case(`case') path(`path') order(`order') ngroups(`ng') ///
>                                 row(`rn') est(`pv') source(display) status(ok)
 39.                 }
 40.                 file read `lf' line
 41.         }
 42.         file close `lf'
 43. end

. 
. * Return in r(last) the label of the last "Path (...)" header printed in a log.
. capture program drop _bp_last_path

. program define _bp_last_path, rclass
  1.         args logfile
  2.         tempname lf
  3.         local last ""
  4.         file open `lf' using `"`logfile'"', read text
  5.         file read `lf' line
  6.         while r(eof) == 0 {
  7.                 if ustrregexm(`"`macval(line)'"', "^ *Path \((.*)\) *$") local last = ustrregexs(1)
  8.                 file read `lf' line
  9.         }
 10.         file close `lf'
 11.         return local last `"`last'"'
 12. end

. 
. * Write source=precise rows for the last path estimated by the latest run.
. capture program drop _bp_write_precise

. program define _bp_write_precise
  1.         args fh case k
  2.         local path `"${path_`k'_XX}"'
  3.         local ng   `"${num_g_path_`k'_XX}"'
  4.         tempname M
  5.         matrix `M' = mat_res_XX
  6.         local rnames : rownames `M'
  7.         local r 0
  8.         foreach rn of local rnames {
  9.                 local ++r
 10.                 forvalues j = 1/6 {
 11.                         _bp_num `M'[`r',`j']
 12.                         local v`j' "`r(s)'"
 13.                 }
 14.                 _bp_write, fh(`fh') case(`case') path(`path') order(`k') ngroups(`ng') row(`rn') ///
>                         est(`v1') se(`v2') lb(`v3') ub(`v4') n(`v5') sw(`v6') source(precise) status(ok)
 15.         }
 16.         foreach w in effects placebo {
 17.                 local rn = cond("`w'" == "effects", "p_joint_effects", "p_joint_placebos")
 18.                 if `"`e(p_joint`w')'"' != "" {
 19.                         _bp_num e(p_joint`w')
 20.                         _bp_write, fh(`fh') case(`case') path(`path') order(`k') ngroups(`ng') ///
>                                 row(`rn') est(`r(s)') source(precise) status(ok)
 21.                 }
 22.         }
 23. end

. 
. * Clear everything a previous run could leave behind.
. capture program drop _bp_reset

. program define _bp_reset
  1.         ereturn clear
  2.         capture matrix drop mat_res_XX
  3.         capture macro drop path_*_XX num_g_path_*_XX
  4. end

. 
. *------------------------------------------------------------------------------
. * 3. Estimation cases
. *------------------------------------------------------------------------------
. import delimited using `"`tb'/cases.csv"', varnames(1) stringcols(_all) clear bindquote(strict)
(encoding automatically selected: ISO-8859-1)
(17 vars, 15 obs)

. local ncases = _N

. local fields case_id dataset outcome group time treatment effects placebo by_path ///
>         controls weight cluster normalized switchers only_never_switchers stata_precise

. forvalues i = 1/`ncases' {
  2.         foreach f of local fields {
  3.                 local `f'_`i' = strtrim(`f'[`i'])
  4.         }
  5. }

. 
. tempname fh

. file open `fh' using `"`res'/stata_results.csv"', write text replace
(file C:\Users\eunic\OneDrive\Documents\GitHub\DCDH_TODO\tests_by_path/results/stata_results.csv not found)

. file write `fh' "case_id,path,path_order,n_groups,row,estimate,se,lb_ci,ub_ci,n,switchers,source,status,message" _n

. 
. local only : env DCDH_ONLY_CASES

. forvalues i = 1/`ncases' {
  2.         local case "`case_id_`i''"
  3.         if `"`only'"' != "" & !`: list case in only' continue
  4. 
.         * option string shared by the display and precise runs
.         local opts "effects(`effects_`i'') placebo(`placebo_`i'') graph_off"
  5.         if "`controls_`i''"  != "" local opts "`opts' controls(`controls_`i'')"
  6.         if "`weight_`i''"    != "" local opts "`opts' weight(`weight_`i'')"
  7.         if "`cluster_`i''"   != "" local opts "`opts' cluster(`cluster_`i'')"
  8.         if "`normalized_`i''" == "1" local opts "`opts' normalized"
  9.         if "`switchers_`i''" != "" local opts "`opts' switchers(`switchers_`i'')"
 10.         if "`only_never_switchers_`i''" == "1" local opts "`opts' only_never_switchers"
 11.         local vars "`outcome_`i'' `group_`i'' `time_`i'' `treatment_`i''"
 12. 
.         di as text _n "{hline 80}" _n "CASE `case': did_multiplegt_dyn `vars', `opts' by_path(`by_path_`i'')" _n "{hline 80}"
 13.         use `"`proj'/`dataset_`i''"', clear
 14. 
.         * --- display run: the real by_path(#) call, logged and parsed -----------
.         _bp_reset
 15.         local caselog `"`logs'/`case'.log"'
 16.         capture log close _bp
 17.         log using `"`caselog'"', text replace name(_bp)
 18.         timer clear 1
 19.         timer on 1
 20.         capture noisily did_multiplegt_dyn `vars', `opts' by_path(`by_path_`i'')
 21.         local rc = _rc
 22.         timer off 1
 23.         log close _bp
 24.         quietly timer list 1
 25.         local secs = r(t1)
 26.         capture confirm matrix mat_res_XX
 27.         if `rc' != 0 | _rc != 0 {
 28.                 _bp_write, fh(`fh') case(`case') source(display) status(case_error) msg(Stata rc=`rc'; no results)
 29.                 continue
 30.         }
 31.         local npaths 0
 32.         while `"${path_`=`npaths'+1'_XX}"' != "" {
 33.                 local ++npaths
 34.         }
 35.         _bp_parse_log `"`caselog'"' `fh' `case' `npaths'
 36.         * every path the command enumerated, printed or not (source = enum)
.         forvalues k = 1/`npaths' {
 37.                 _bp_write, fh(`fh') case(`case') path(${path_`k'_XX}) order(`k') ///
>                         ngroups(${num_g_path_`k'_XX}) source(enum) status(ok)
 38.         }
 39.         di as text "  display run: `npaths' paths in `secs's"
 40. 
.         * --- precise runs: by_path(k) for k = 1..# -------------------------------
.         if "`stata_precise_`i''" == "1" {
 41.                 capture confirm integer number `by_path_`i''
 42.                 if _rc == 0 {
 43.                         local klog `"`logs'/_precise_tmp.log"'
 44.                         forvalues k = 1/`by_path_`i'' {
 45.                                 _bp_reset
 46.                                 capture log close _bpk
 47.                                 log using `"`klog'"', text replace name(_bpk)
 48.                                 capture noisily did_multiplegt_dyn `vars', `opts' by_path(`k')
 49.                                 local rc = _rc
 50.                                 log close _bpk
 51.                                 * mat_res_XX belongs to path k only if path k was the last one
.                                 * printed; when path k produces no output the matrix still holds
.                                 * the previous path's results.
.                                 _bp_last_path `"`klog'"'
 52.                                 local last `"`r(last)'"'
 53.                                 capture confirm matrix mat_res_XX
 54.                                 if `rc' != 0 | _rc != 0 | `"`last'"' != `"${path_`k'_XX}"' {
 55.                                         _bp_write, fh(`fh') case(`case') path(${path_`k'_XX}) order(`k') source(precise) ///
>                                                 status(path_error) msg(by_path(`k') printed no results for this path; rc=`rc')
 56.                                         continue
 57.                                 }
 58.                                 _bp_write_precise `fh' `case' `k'
 59.                         }
 60.                         capture erase `"`klog'"'
 61.                         di as text "  precise runs: done for k = 1..`by_path_`i''"
 62.                 }
 63.         }
 64. }

