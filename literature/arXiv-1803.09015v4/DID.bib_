isbn = {1120617163123},
issn = {0019-7939},
journal = {Industrial and Labor Relations Review},
number = {1},
pages = {55--81},
pmid = {21675331},
title = {Evidence on employment effects of minimum wages and subminimum wage provisions from panel data on state minimum wage laws},
volume = {46},
year = {1992}
}
