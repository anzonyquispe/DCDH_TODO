@article{Glynn2009,
abstract = {In this paper, we discuss an estimator for average treatment effects (ATEs) known as the augmented inverse propensity weighted (AIPW) estimator. This estimator has attractive theoretical properties and only requires practitioners to do two things they are already comfortable with: (1) specify a binary regression model for the propensity score, and (2) specify a regression model for the outcome variable. Perhaps the most interesting property of this estimator is its so-called “double robustness.” Put simply, the estimator remains consistent for the ATE if either the propensity score model or the outcome regression is misspecified but the other is properly specified. After explaining the AIPW estimator, we conduct a Monte Carlo experiment that compares the finite sample performance of the AIPW estimator to three common competitors: a regression estimator, an inverse propensity weighted (IPW) estimator, and a propensity score matching estimator. The Monte Carlo results show that the AIPW estimator has comparable or lower mean square error than the competing estimators when the propensity score and outcome models are both properly specified and, when one of the models is misspecified, the AIPW estimator is superior.},
author = {Glynn, Adam N. and Quinn, Kevin M.},
doi = {10.1093/pan/mpp036},
file = {:C$\backslash$:/Users/santanph/Documents/Mendeley Desktop/Glynn, Quinn - 2009 - Political Analysis.pdf:pdf},
isbn = {1476-4989},
issn = {10471987},
journal = {Political Analysis},
number = {1},
pages = {36--56},
title = {An introduction to the augmented inverse propensity weighted estimator},
volume = {18},
year = {2009}
}
@article{Chernozhukov2017a,
abstract = {Chernozhukov, Chetverikov, Demirer, Duflo, Hansen, and Newey (2016) provide a generic double/de-biased machine learning (DML) approach for obtaining valid inferential statements about focal parameters, using Neyman-orthogonal scores and cross-fitting, in settings where nuisance parameters are estimated using a new generation of nonparametric fitting methods for high-dimensional data, called machine learning methods. In this note, we illustrate the application of this method in the context of estimating average treatment effects (ATE) and average treatment effects on the treated (ATTE) using observational data. A more general discussion and references to the existing literature are available in Chernozhukov, Chetverikov, Demirer, Duflo, Hansen, and Newey (2016).},
archivePrefix = {arXiv},
arxivId = {1701.08687},
author = {Chernozhukov, Victor and Chetverikov, Denis and Demirer, Mert and Duflo, Esther and Hansen, Christian and Newey, Whitney},
doi = {10.1257/aer.p20171038},
eprint = {1701.08687},
file = {:C$\backslash$:/Users/santanph/Documents/Mendeley Desktop/Chernozhukov et al. - 2017 - American Economic Review P{\&}P.pdf:pdf},
issn = {00028282},
journal = {American Economic Review P{\&}P},
number = {5},
pages = {261--265},
title = {Double/debiased/Neyman machine learning of treatment effects},
volume = {107},
year = {2017}
}
@article{Card1990,
abstract = {Using data from the Current Population Survey, this paper describes the effect of the Mariel Boatlift of 1980 on the Miami labor market. The Mariel immigrants increased the Miami labor force by 7{\%}, and the percentage increase in labor supply to less-skilled occupations and industries was even greater because most of the immigrants were relatively unskilled. Nevertheless, the Mariel influx appears to have had virtually no effect on the wages or unemployment rates of less-skilled workers, even among Cubans who had immigrated earlier. The author suggests that the ability of Miami's labor market to rapidly absorb the Mariel immigrants was largely owing to its adjustment to other large waves of immigrants in the two decades before the Mariel Boatlift. (Abstract courtesy JSTOR.)},
archivePrefix = {arXiv},
arxivId = {arXiv:1011.1669v3},
author = {Card, David},
doi = {10.2307/2523702},
eprint = {arXiv:1011.1669v3},
file = {:C$\backslash$:/Users/santanph/Documents/Mendeley Desktop/Card - 1990 - Industrial and Labor Relations Review.pdf:pdf},
isbn = {00197939},
issn = {00197939},
journal = {Industrial and Labor Relations Review},
number = {2},
pages = {245},
pmid = {15991970},
title = {The Impact of the Mariel Boatlift on the Miami Labor Market},
volume = {43},
year = {1990}
}
@article{Mackinnon2018,
abstract = {Inference using difference-in-differences with clustered data requires care. Previous research has shown that t tests based on a cluster-robust variance estimator (CRVE) severely over-reject when there are few treated clusters, that different variants of the wild cluster bootstrap can over-reject or under-reject severely, and that procedures based on randomization show promise. We demonstrate that randomization inference (RI) procedures based on estimated coefficients, such as the one proposed by Conley and Taber (2011), fail when the treated clusters are atypical. We propose an RI procedure based on t statistics which fails only when the treated clusters are atypical and few in number. We also propose a bootstrap-based alternative to randomization inference, which mitigates the discrete nature of RI P values when the number of clusters is small.},
author = {Mackinnon, James G and Webb, Matthew D},
file = {:C$\backslash$:/Users/santanph/Documents/Mendeley Desktop/Mackinnon, Webb - 2018 - Queen's Economics Department Working Papers No. 1355(2).pdf:pdf},
journal = {Queen's Economics Department Working Papers No. 1355},
keywords = {CRVE,DiD,cluster wild bootstrap,clustered data,difference-in-differences,grouped data,panel data,randomization inference},
number = {1355},
pages = {1--44},
title = {Randomization inference for difference-in-differences with few treated clusters},
year = {2018}
}
