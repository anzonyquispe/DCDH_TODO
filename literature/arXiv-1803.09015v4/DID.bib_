@article{Cameron2015,
abstract = {We consider statistical inference for regression when data are grouped into clusters, with regression model errors independent across clusters but correlated within clusters. Examples include data on individuals with clustering on village or region or other category such as industry, and state- year differences- in- differences studies with clustering on state. In such settings, default standard errors can greatly overstate estimator precision. Instead, if the number of clusters is large, statistical inference after OLS should be based on cluster- robust standard errors. We outline the basic method as well as many complications that can arise in practice. These include cluster- specific fixed effects, few clusters, multiway clustering, and estimators other than OLS. I.},
author = {Cameron, A Colin and Miller, Douglas L},
doi = {10.3368/jhr.50.2.317},
file = {:C$\backslash$:/Users/santanph/Documents/Mendeley Desktop/Cameron, Miller - 2015 - Journal of Human Resource.pdf:pdf},
isbn = {0022-166X},
issn = {0022-166X},
journal = {Journal of Human Resource},
number = {2},
pages = {317--372},
title = {A Practitioner ' s Guide to Cluster-Robust Inference A Practitioner ' s Guide to Cluster- Robust Inference},
volume = {50},
year = {2015}
}
@article{Botosaru2017,
abstract = {This paper considers the di¤erence-in-di¤erences (DID) method when the data comes from repeated cross-sections and the treatment status is observed either before or after the implementation of a program. Empirical research that has faced this missing data issue has replaced the unobserved treatment status appearing in the DID estimand by a proxy, without accounting for the fact that the proxy is an imperfect measure of the true treatment status. We show that this method obtains biased results for the average treatment e¤ect on the treated (ATT). Our contribution is at least four-fold: (1) We show that when the proxy satis{\ldots}es an exclusion restriction and the propensity score is stationary, the ATT is identi{\ldots}ed via a DID analysis; (2) We propose two GMM estimators; (3) We provide an overidenti{\ldots}cation test for our assumptions; and (4) We provide both an empirical illustration and an application of our method. Lavergne, and Chris Muris for helpful discussions, and to seminar audiences at TSE, Bristol Econometric Study Group 2013, AMES Singapore, Wisconsin-Madison, UW Seattle, UBC, SFU, Vanderbilt, Yale, LAMES Mexico City, CEA Toronto, and the 5th French Econometrics Conference (Toulouse) for comments and suggestions.},
author = {Botosaru, Irene and Gutierrez, Federico H.},
doi = {10.1002/jae.2583},
file = {:C$\backslash$:/Users/santanph/Documents/Mendeley Desktop/Botosaru, Gutierrez - 2017 - Journal of Applied Econometrics.pdf:pdf},
issn = {10991255},
journal = {Journal of Applied Econometrics},
volume = {33},
number = {1},
pages = {73--90},
title = {Difference-in-differences when the treatment status is observed in only one period},
year = {2018}
}
