file = {:C$\backslash$:/Users/santanph/Documents/Mendeley Desktop/Athey et al. - 2017 - American Economic Review Papers {\&} Proceedings.pdf:pdf},
issn = {0002-8282},
journal = {American Economic Review: Papers {\&} Proceedings},
number = {5},
pages = {278--281},
title = {Estimating Average Treatment Effects: Supplementary Analyses and Remaining Challenges},
url = {http://arxiv.org/abs/1702.01250},
volume = {107},
year = {2017}
}
