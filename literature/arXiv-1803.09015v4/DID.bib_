@article{Malesky2014,
abstract = {Comparative political economy offers a wealth of hypotheses connecting decentralization to improved public service delivery. In recent years, influential formal and experimental work has begun to question the underlying theory and empirical analyses of previous findings. At the same time, many countries have grown dissatisfied with the results of their decentralization efforts and have begun to reverse them. Vietnam is particularly intriguing because of the unique way in which it designed its recentralization, piloting a removal of elected people's councils in 99 districts across the country and stratifying the selection by region, type of province, and urban versus rural setting. We take advantage of the opportunity provided by this quasi experiment to test the core hypotheses regarding the decision to shift administrative and fiscal authority to local governments. We find that recentralization significantly improved public service delivery in areas important to central policy-makers, especially in transportation, healthcare, and communications.},
author = {Malesky, Edmund J. and Nguyen, Cuong Viet and Tran, Anh},
doi = {10.1017/S0003055413000580},
file = {:C$\backslash$:/Users/santanph/Documents/Mendeley Desktop/Malesky, Nguyen, Tran - 2014 - American Political Science Review.pdf:pdf},
issn = {15375943},
journal = {American Political Science Review},
number = {1},
pages = {144--168},
title = {The impact of recentralization on public services: A difference-in- differences analysis of the abolition of elected councils in Vietnam},
volume = {108},
year = {2014}
}

@article{Fan2012,
abstract = {In this paper, we supplement the identification results for the mean treatment effect for the treated in the difference-in-differences framework studied by . Abadie (2005) by establishing partial identification results for the distribution and quantile of the counterfactual outcome and of the treatment effect for the treated. Unlike the mean treatment effect which is identifiable from either the panel or the repeated cross sectional data, we show that the distribution/quantile of either the counterfactual outcome or of the treatment effect is only partially identified and in general the identified interval is tighter with panel than with the repeated cross sectional data. We further illustrate this gain from the panel via a numerical example. {\textcopyright} 2012 Elsevier B.V.},
author = {Fan, Yanqin and Yu, Zhengfei},
doi = {10.1016/j.econlet.2012.01.001},
file = {:C$\backslash$:/Users/santanph/Documents/Mendeley Desktop/Fan, Yu - 2012 - Economics Letters.pdf:pdf},
issn = {01651765},
journal = {Economics Letters},
keywords = {Cross sectional data,Identified interval,Panel data,Program evaluation,Sharp bounds},
number = {3},
pages = {511--515},
publisher = {Elsevier B.V.},
title = {Partial identification of distributional and quantile treatment effects in difference-in-differences models},
volume = {115},
year = {2012}
}
