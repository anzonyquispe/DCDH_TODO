@article{Autor2007,
abstract = {Theory predicts that mandated employment protections may reduce productivity by distorting production choices. Firms facing (non-Coasean) worker dismissal costs will curtail hiring below efficient levels and retain unproductive workers, both of which should affect productivity. These theoretical predictions have rarely been tested. We use the adoption of wrongful-discharge protections by U.S. state courts over the last three decades to evaluate the link between dismissal costs and productivity. Drawing on establishment-level data from the Annual Survey of Manufacturers and the Longitudinal Business Database, our estimates suggest that wrongful-discharge protections reduce employment flows and firm entry rates. Moreover, analysis of plant-level data provides evidence of capital deepening and a decline in total factor productivity following the introduction of wrongful-discharge protections. This last result is potentially quite important, suggesting that mandated employment protections reduce productive efficiency as theory would suggest. However, our analysis also presents some puzzles including, most significantly, evidence of strong employment growth following adoption of dismissal protections. In light of these puzzles, we read our findings as suggestive but tentative.},
author = {Autor, David H and Kerr, William R and Kugler, Adriana D},
doi = {10.3386/w12860},
file = {:C$\backslash$:/Users/santanph/Documents/Mendeley Desktop/Autor, Kerr, Kugler - 2007 - The Economic Journal.pdf:pdf},
journal = {The Economic Journal},
keywords = {Labor Studies,Law and Economics,Productivity},
pages = {189--217},
title = {Do employment protections reduce productivity? Evidence from U.S. states},
volume = {117},
year = {2007}
}
@article{Romano2006,
abstract = {Consider the multiple testing problem of testing null hypotheses {\$}H{\_}1,...,H{\_}s{\$}. A classical approach to dealing with the multiplicity problem is to restrict attention to procedures that control the familywise error rate ({\$}\backslashmathit{\{}FWER{\}}{\$}), the probability of even one false rejection. But if {\$}s{\$} is large, control of the {\$}\backslashmathit{\{}FWER{\}}{\$} is so stringent that the ability of a procedure that controls the {\$}\backslashmathit{\{}FWER{\}}{\$} to detect false null hypotheses is limited. It is therefore desirable to consider other measures of error control. This article considers two generalizations of the {\$}\backslashmathit{\{}FWER{\}}{\$}. The first is the {\$}k-\backslashmathit{\{}FWER{\}}{\$}, in which one is willing to tolerate {\$}k{\$} or more false rejections for some fixed {\$}k\backslashgeq 1{\$}. The second is based on the false discovery proportion ({\$}\backslashmathit{\{}FDP{\}}{\$}), defined to be the number of false rejections divided by the total number of rejections (and defined to be 0 if there are no rejections). Benjamini and Hochberg [J. Roy. Statist. Soc. Ser. B 57 (1995) 289--300] proposed control of the false discovery rate ({\$}\backslashmathit{\{}FDR{\}}{\$}), by which they meant that, for fixed {\$}\backslashalpha{\$}, {\$}E(\backslashmathit{\{}FDP{\}})\backslashleq\backslashalpha{\$}. Here, we consider control of the {\$}\backslashmathit{\{}FDP{\}}{\$} in the sense that, for fixed {\$}\backslashgamma{\$} and {\$}\backslashalpha{\$}, {\$}P\backslash{\{}\backslashmathit{\{}FDP{\}}{\textgreater}\backslashgamma\backslash{\}}\backslashleq \backslashalpha{\$}. Beginning with any nondecreasing sequence of constants and {\$}p{\$}-values for the individual tests, we derive stepup procedures that control each of these two measures of error control without imposing any assumptions on the dependence structure of the {\$}p{\$}-values. We use our results to point out a few interesting connections with some closely related stepdown procedures. We then compare and contrast two {\$}\backslashmathit{\{}FDP{\}}{\$}-controlling procedures obtained using our results with the stepup procedure for control of the {\$}\backslashmathit{\{}FDR{\}}{\$} of Benjamini and Yekutieli [Ann. Statist. 29 (2001) 1165--1188].},
archivePrefix = {arXiv},
arxivId = {math/0611266},
author = {Romano, Joseph P. and Shaikh, Azeem M.},
doi = {10.1214/009053606000000461},
eprint = {0611266},
file = {:C$\backslash$:/Users/santanph/Documents/Mendeley Desktop/Romano, Shaikh - 2006 - Annals of Statistics.pdf:pdf},
issn = {00905364},
journal = {Annals of Statistics},
keywords = {False discovery proportion,False discovery rate,Familywise error rate,Multiple testing,P-value,Stepdown procedure,Stepup procedure},
number = {4},
pages = {1850--1873},
primaryClass = {math},
title = {Stepup procedures for control of generalizations of the familywise error rate},
volume = {34},
year = {2006}
}
@article{Callaway2018,
abstract = {The existing literature on Quantile Treatment Effects on the Treated (QTETs) in Difference in Differences models shows that QTETs are either (i) partially identified or (ii) point identified under strong restrictions on the distribution of unobservables over time. We show that having an additional period of pre-treatment data allows for point identification of QTETs under a different set of assumptions that may be more plausible in many applications. Second, we introduce a propensity score re-weighting technique that makes flexible estimation more feasible when the Difference in Differences Assumption holds only conditional on covariates. We compare the performance of our method to existing methods for estimating QTETs in Difference in Differences models using Lalonde (1986)'s job training dataset. Using this dataset, we find the perfomance of our method compares favorably to the performance of existing methods for estimating QTETs.},
archivePrefix = {arXiv},
arxivId = {1702.03618},
author = {Callaway, Brantly and Li, Tong and Oka, Tatsushi},
doi = {10.1016/j.jeconom.2018.06.008},
eprint = {1702.03618},
file = {:C$\backslash$:/Users/santanph/Documents/Mendeley Desktop/Callaway, Li, Oka - 2018 - Journal of Econometrics.pdf:pdf},
issn = {03044076},
journal = {Journal of Econometrics},
keywords = {and two anonymous referees,c14,c21,c23,c50,chen,copula,for their constructive comments,improved the paper,jel classification,jiti gao,le-yu chen,panel data,quantile treatment effects,we also thank yi-ting,we thank an editor,which have greatly,wolfgang hardle,yu-chin hsu},
month = {oct},
number = {2},
pages = {395--413},
title = {Quantile treatment effects in difference in differences models under dependence restrictions and with only two time periods},
volume = {206},
year = {2018}
}
