. 
. if "`cluster'"==""{
1336.         gen U_Gg_var_glob_eff`i'_sqrd_XX = U_Gg_var_glob_`i'_XX^2*first_obs_by_gp_XX
1337. 
.         sum U_Gg_var_glob_eff`i'_sqrd_XX
1338.         scalar sum_for_var_`i'_XX=r(sum)/G_XX^2
1339. }
1340. 
. // Compute sigma_hat_2_l with clustering: sum U_Gg_var_l within a cluster, and then take average of squa
> re. 
