1195. 
. gegen N_placebo_`i'_XX = total(count`i'_pl_global_XX)
1196. scalar N_placebo_`i'_XX = N_placebo_`i'_XX
1197. 
. if N_switchers_placebo_`i'_XX==0|N_placebo_`i'_XX==0{
1198.         di as error ""
1199.         di as error "Placebo_"`i' " cannot be estimated."
1200.         di as error "There is no switcher or no control"
