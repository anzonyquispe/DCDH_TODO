1317.                 mat se_pl_bs_XX=J(`=l_placebo_XX',1,.)
1318.                 local for_count_2_XX=`=l_XX'+`=l_placebo_XX' // Felix: obsolete
1319.                 local for_count_3_XX=`=l_XX'+1 // Felix: obsolete
1320.                 foreach k of numlist `num_pl_XX'{
1321.                         mat se_pl_bs_XX[`k',1]=bs_out_XX[2,`j']
1322.                         local j=`j'+1
1323.                 }
1324.         }
1325.         
.         if "`trends_lin'"==""{
1326.         // row l_XX+l_placebo_XX+1 isvaverage cummulative (total) effect
.         mat se_avg_eff_bs_XX=bs_out_XX[2,`j']
1327.         }
1328.         
.         // Reload results matrix 
.         matrix mat_res_XX=mat_res_bs_XX
1329.         
.         // Reload the "pre-bootstrap" data 
.         use "`data_pre_bootstrap_XX'.dta", clear
1330. }
1331. global bootstrap_on_XX "" // Modif Felix
1332. 
. /////  Computing the variance of DID_\ell
> 
. // Loop over the number of effects to be estimated
. 
. forvalue i=1/`=l_XX'{
1333. 
. // Check that the effect can be estimated       
. 
. if ("`switchers'"==""&(N1_`i'_XX_new!=0|N0_`i'_XX_new!=0))|("`switchers'"=="out"&N0_`i'_XX_new!=0)|("`sw
> itchers'"=="in"&N1_`i'_XX_new!=0){
1334. 
. // Aggregating the U_Gg_var_\ell for switchers in and out
. 
. gen U_Gg_var_glob_`i'_XX = U_Gg_var_`i'_in_XX * (scalar(N1_`i'_XX_new)/(scalar(N1_`i'_XX_new)+scalar(N0_
> `i'_XX_new))) + U_Gg_var_`i'_out_XX* (scalar(N0_`i'_XX_new)/(scalar(N1_`i'_XX_new)+scalar(N0_`i'_XX_new)
> ))
1335. 
. // Compute sigma_hat_2_l without clustering
. 
. if "`cluster'"==""{
1336.         gen U_Gg_var_glob_eff`i'_sqrd_XX = U_Gg_var_glob_`i'_XX^2*first_obs_by_gp_XX
1337. 
.         sum U_Gg_var_glob_eff`i'_sqrd_XX
1338.         scalar sum_for_var_`i'_XX=r(sum)/G_XX^2
1339. }
1340. 
. // Compute sigma_hat_2_l with clustering: sum U_Gg_var_l within a cluster, and then take average of squa
> re. 
. 
. if "`cluster'"!=""{
1341.         
.         capture drop clust_U_Gg_var_glob_`i'_XX
1342.         capture drop clust_U_Gg_var_glob_`i'_2_XX
1343.         
.         replace U_Gg_var_glob_`i'_XX = U_Gg_var_glob_`i'_XX*first_obs_by_gp_XX
1344.         
.         * Sum within cluster
.         bys `cluster' : gegen clust_U_Gg_var_glob_`i'_XX = total(U_Gg_var_glob_`i'_XX)
1345.         
.         * Compute average of square
.         gen clust_U_Gg_var_glob_`i'_2_XX=clust_U_Gg_var_glob_`i'_XX^2*first_obs_by_clust_XX
1346.         
.         sum clust_U_Gg_var_glob_`i'_2_XX
1347.         scalar sum_for_var_`i'_XX=r(sum)/G_XX^2
1348.         
.         replace U_Gg_var_glob_`i'_XX = clust_U_Gg_var_glob_`i'_XX
1349.         
. }
1350. 
. // Compute SE
. scalar se_`i'_XX = sqrt(sum_for_var_`i'_XX)
1351. 
. // Normalize SE if normalized option was specified
. if "`normalized'"!=""{
1352.         scalar se_`i'_XX = scalar(se_`i'_XX)/scalar(delta_D_`i'_global_XX)
1353. }
1354. 
. // Adapting the se scalars with the bootstrap
. if `bootstrap_XX'!=0{
1355.         scalar se_`i'_XX=se_eff_bs_XX[`i',1]
1356. }
1357. 
. // Storing the results
. 
. * SE
. matrix mat_res_XX[`i',2]=scalar(se_`i'_XX)
1358. ereturn scalar se_effect_`i'=scalar(se_`i'_XX)
1359. 
. * ci_level
. scalar ci_level = `ci_level'/100
1360. scalar z_level = invnormal(scalar(ci_level) + (1-scalar(ci_level))/2)
1361.         
. * Lower bound of the confidence interval
. scalar LB_CI_`i'_XX = scalar(DID_`i'_XX) - scalar(z_level)*scalar(se_`i'_XX)
1362. matrix mat_res_XX[`i',3]= scalar(LB_CI_`i'_XX)
1363. 
. * Upper bound of the confidence interval
. scalar UB_CI_`i'_XX = scalar(DID_`i'_XX) + scalar(z_level)*scalar(se_`i'_XX)
1364. matrix mat_res_XX[`i',4]=scalar(UB_CI_`i'_XX)
1365. 
. }
1366. }
1367. 
. 
. /////  Computing the variances of the placebo estimators (same steps as for the DID_\ell, not commented)
> 
. if l_placebo_XX!=0{
1368. 
. forvalue i=1/`=l_placebo_XX'{
1369. if ("`switchers'"==""&(N1_placebo_`i'_XX_new!=0|N0_placebo_`i'_XX_new!=0))|("`switchers'"=="out"&N0_
> placebo_`i'_XX_new!=0)|("`switchers'"=="in"&N1_placebo_`i'_XX_new!=0){ 
1370. 
. gen U_Gg_var_glob_pl_`i'_XX = U_Gg_var_pl_`i'_in_XX * (N1_placebo_`i'_XX_new/(N1_placebo_`i'_XX_new+N0_p
> lacebo_`i'_XX_new)) + U_Gg_var_pl_`i'_out_XX* (N0_placebo_`i'_XX_new/(N1_placebo_`i'_XX_new+N0_placebo_`
> i'_XX_new))
1371. 
. if "`cluster'"==""{
1372. 
. gen U_Gg_var_glob_pl_`i'_2_XX = U_Gg_var_glob_pl_`i'_XX^2*first_obs_by_gp_XX
1373. 
. sum U_Gg_var_glob_pl_`i'_2_XX
1374. scalar sum_for_var_placebo_`i'_XX=r(sum)/G_XX^2
1375. }
1376. 
. if "`cluster'"!=""{
1377.         capture drop clust_U_Gg_var_glob_pl_`i'_XX
1378.         capture drop clust_U_Gg_var_glob_pl_`i'_2_XX
1379.         
.         replace U_Gg_var_glob_pl_`i'_XX = U_Gg_var_glob_pl_`i'_XX*first_obs_by_gp_XX
1380. 
.         bys `cluster' : gegen clust_U_Gg_var_glob_pl_`i'_XX= total(U_Gg_var_glob_pl_`i'_XX)
1381. 
.         gen clust_U_Gg_var_glob_pl_`i'_2_XX=clust_U_Gg_var_glob_pl_`i'_XX^2*first_obs_by_clust_XX
1382.         
.         sum clust_U_Gg_var_glob_pl_`i'_2_XX
1383.         scalar sum_for_var_placebo_`i'_XX=r(sum)/G_XX^2
1384.         
.         replace U_Gg_var_glob_pl_`i'_XX = clust_U_Gg_var_glob_pl_`i'_XX  
1385. }
1386. 
. scalar se_placebo_`i'_XX = sqrt(sum_for_var_placebo_`i'_XX)
1387. 
. if "`normalized'"!=""{
1388.         scalar se_placebo_`i'_XX = scalar(se_placebo_`i'_XX)/scalar(delta_D_pl_`i'_global_XX)
1389. }
1390. 
. // Adapting the se scalars with the bootstrap
. if `bootstrap_XX'!=0{
1391.         scalar se_placebo_`i'_XX=se_pl_bs_XX[`i',1]
1392. }
1393. 
. matrix mat_res_XX[`=l_XX' + 1 + `i',2]=scalar(se_placebo_`i'_XX)
1394. ereturn scalar se_placebo_`i'=scalar(se_placebo_`i'_XX)
1395.         
. scalar LB_CI_placebo_`i'_XX = scalar(DID_placebo_`i'_XX) - scalar(z_level)*scalar(se_placebo_`i'_XX)
1396. matrix mat_res_XX[`=l_XX'+ 1 + `i', 3]= scalar(LB_CI_placebo_`i'_XX)
1397. 
. scalar UB_CI_placebo_`i'_XX = scalar(DID_placebo_`i'_XX) + scalar(z_level)*scalar(se_placebo_`i'_XX)
1398. matrix mat_res_XX[`=l_XX'+ 1 + `i',4]=scalar(UB_CI_placebo_`i'_XX)
1399. 
. }
1400. }
1401. }
1402. 
. /////  Computing the variance of the average total effect (same steps as for the DID_\ell, not commented
> )
> 
. if "`trends_lin'"==""{
1403. 
. if ("`switchers'"==""&(sum_N1_l_XX!=0|sum_N0_l_XX!=0))|("`switchers'"=="out"&sum_N0_l_XX!=0)|("`switcher
> s'"=="in"&sum_N1_l_XX!=0){
1404. 
. gen U_Gg_var_global_XX = w_plus_XX * U_Gg_var_plus_XX + (1 - w_plus_XX) * U_Gg_var_minus_XX
1405. 
. if "`cluster'"==""{
1406. capture drop U_Gg_var_global_2_XX
1407. gen U_Gg_var_global_2_XX = U_Gg_var_global_XX^2*first_obs_by_gp_XX
1408. 
. sum U_Gg_var_global_2_XX
1409. scalar sum_for_var_XX=r(sum)/G_XX^2
1410. }
1411. 
. if "`cluster'"!=""{
1412.         capture drop clust_U_Gg_var_global_XX
1413.         
.         replace U_Gg_var_global_XX=U_Gg_var_global_XX*first_obs_by_gp_XX
1414.         
.         bys `cluster' : gegen clust_U_Gg_var_global_XX= total(U_Gg_var_global_XX)
1415.         
.         replace clust_U_Gg_var_global_XX=clust_U_Gg_var_global_XX^2*first_obs_by_clust_XX
1416.         
.         sum clust_U_Gg_var_global_XX
1417.         scalar sum_for_var_XX=r(sum)/G_XX^2
1418. }
1419. 
. scalar se_XX = sqrt(sum_for_var_XX)
1420. 
. // Adapting the se scalars with the bootstrap
. if `bootstrap_XX'!=0{
1421.         scalar se_XX=se_avg_eff_bs_XX[1,1]
1422. }
1423. 
. matrix mat_res_XX[l_XX+1,2]=se_XX
1424. ereturn scalar se_avg_total_effect = se_XX
1425. 
. scalar LB_CI_XX = delta_XX - scalar(z_level)*se_XX
1426. matrix mat_res_XX[l_XX+1,3]= LB_CI_XX
1427. 
. scalar UB_CI_XX = delta_XX + scalar(z_level)*se_XX
1428. matrix mat_res_XX[l_XX+1,4]= UB_CI_XX
1429. 
. }
1430. }
1431. 
. ///// Storing results in a way ensuring that command compatible with "event_plot" command 
