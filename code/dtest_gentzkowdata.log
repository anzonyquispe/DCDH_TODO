. if N_switchers_effect_`i'_XX==0|N_effect_`i'_XX==0{
1088.         di as error ""
1089.         di as error "Effect_"`i' " cannot be estimated."
1090.         di as error "There is no switcher or no control"
1091.         di as error "for this effect."
1092.         di as input _continue ""
1093.         
.         local missing_eff_XX `missing_eff_XX' `i'
1094. }
1095. 
. // Averaging the U_Gg\ell to compute DID_\ell
.  
. gegen DID_`i'_XX = total(U_Gg`i'_global_XX) 
1096. replace  DID_`i'_XX = DID_`i'_XX/G_XX
1097. scalar DID_`i'_XX = DID_`i'_XX
1098. 
