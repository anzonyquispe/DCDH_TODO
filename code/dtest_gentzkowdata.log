. ///// save_sample option that allows to see which groups were included in the estimation and if they wer
> e switcher in/out ot control
> 
. if "`save_sample'" != "" {
2309.         qui {
2310.                 // keeping only group, time and switcher status (if not missing)
.                 keep if !missing(`2') & !missing(`3') 
2311.                 keep `2' `3' S_g_XX switcher_tag_XX
2312.                 
.                 if "`by'"==""{
2313.                         
.                 // redefine S_g_XX to show if group is switcher in/out or control       
.                 rename S_g_XX _did_sample
2314.                 rename switcher_tag_XX _effect
2315.                 replace _did_sample = -1 if _did_sample == 0
2316.                 replace _did_sample = 0 if _did_sample == .
2317.                 cap label drop switch_lab_XX 
2318.                 label define switch_lab_XX 0 "Never-switcher" 1 "Switcher-in" -1 "Switcher-out"
2319.                 label values _did_sample switch_lab_XX
2320.                 
.                 // Save dataset to be in the memory at the end
.                 tempfile did_sample
2321.                 save `did_sample', replace
2322.                 }
2323.                 
.                 // Same procedure, but with by we get multiple samples
.                 else if "`by'"!=""{
2324.                         
.                 // redefine S_g_XX to show if group is switcher in/out or control       
.                 rename S_g_XX _did_sample_`l_by'
2325.                 rename switcher_tag_XX _effect_`l_by'
2326.                 replace _did_sample_`l_by' = -1 if _did_sample_`l_by' == 0
2327.                 replace _did_sample_`l_by' = 0 if _did_sample_`l_by' == .
2328.                 cap label drop switch_lab_XX 
2329.                 label define switch_lab_XX 0 "Never-switcher" 1 "Switcher-in" -1 "Switcher-out"
2330.                 label values _did_sample_`l_by' switch_lab_XX
2331.                 
.                 // Save dataset to be in the memory at the end
.                 tempfile did_sample_`l_by'
2332.                 save `did_sample_`l_by'', replace
2333.                 }
2334.         }
2335. }
2336. 
. ///// design option which shows the different treatment paths that switcher groups follow
> 
. if "`design'" != "" {   
2337.         qui {
2338.         
.         // Releaod the data before it was changed in save_sample
.         use `data_predesign', clear
2339.         
.         // Error message if the arguments in the option were specified wrong
.         if strpos("`design'", ",") == 0 {
2340.                 di as error ""
2341.                 di as error "Syntax error in design option"
2342.                 di as error "Comma required"
2343.                 di as input _continue ""
2344.                 
.                 exit
2345.         }
2346.         
.         // Fetch the arguments 
.         local des_p = strtrim(substr("`design'", 1, strpos("`design'", ",") - 1))
2347.         local des_path = strtrim(substr("`design'", strpos("`design'", ",") + 1, .))
2348.         local des_n = l_XX 
2349.         
.         // When no percentage value is specified (for how many paths should be shown) it is set to a def
> ault of 100%
.         if missing("`des_p'") {
2350.                 local des_p = 1
2351.         }
2352.         local des_per = `des_p' * 100
2353.         local des_per : di %9.2fc `des_per'
2354.         
.         // keep periods up to ℓ periods after the first switch
.         gen F_g_plus_n_XX = F_g_XX + `des_n' - 1
2355.         keep if time_XX >= F_g_XX - 1 & time_XX <= F_g_plus_n_XX
2356.         sort group_XX time_XX
2357.         bys group_XX : gen time_l_XX = _n
2358. 
.         // Aggregate weights by group 
.         keep group_XX time_l_XX weight_XX treatment_XX F_g_XX
2359.         {
2360.                 if "`weight'" != "" {
2361.                         gegen g_weight_XX = sum(weight_XX), by(group_XX)
2362.                 }
2363.                 else {
2364.                         gen g_weight_XX = 1
2365.                 }
2366.         }
2367.         drop weight_XX
2368.         // Reshape wide to represent the treatment path by time
.         greshape wide treatment_XX, i(group_XX g_weight_XX F_g_XX) j(time_l_XX)
2369.         
.         // Drop missing treatments 
.         foreach v of varlist treatment_XX* {
2370.                 drop if `v' == .
2371.         }
2372.         
.         // Remove non switchers 
.         count if F_g_XX > T_max_XX
2373.         local non_switchers = r(N)
2374.         drop if F_g_XX > T_max_XX
2375.         
.         // Creating varibale to store number of groups per treatment path and collapsing
.         gen N_XX = 1
2376.         sum g_weight_XX
2377.         gen N_w_XX =  (g_weight_XX * N_XX) / r(sum)
2378.         drop group_XX g_weight_XX
2379.         gcollapse (sum) N_XX N_w_XX, by(treatment_XX*)
2380.         order N* treat* 
2381.         sum N_XX
2382.         local tot_switch = r(sum)
2383.         
.         // Keep the observations amounting to p% of the detected treatment paths 
.         gen neg_N_XX = -N_XX
2384.         sort neg_N_XX treatment_XX*
2385.         gen cum_sum_XX = sum(N_w_XX)
2386.         gen in_table_XX = (cum_sum_XX <= `des_p')
2387.         sort in_table_XX cum_sum_XX
2388.         bys in_table_XX: gen id_XX = _n
2389.         
.         // Keep all observations up to the first exceeding the p%       
.         keep if (in_table_XX == 1) | (in_table_XX == 0 & id_XX == 1)    
2390.         // Store the final % of groups included by the design option
.         {
2391.                 if `des_p' < 1 {
2392.                         sum cum_sum_XX if in_table == 0
2393.                         local last_p : di %9.2fc 100 * r(min)
2394.                 }
2395.                 else {
2396.                         local last_p : di %9.2fc 100
2397.                 }
2398.         }
2399.         
.         sort neg_N_XX treatment_XX*
2400.         drop neg_N_XX in_table_XX id_XX cum_sum_XX
2401.         
.         // Prepare matrix for the output table
.         mat define desmat = J(`=_N', `= 2 + 1 + `des_n'', .)
2402.         local colnames
2403.         label var N_XX "#Groups"
2404.         label var N_w_XX "%Groups"
2405.         replace N_w_XX=100*N_w_XX
2406.         * display in % terms
.         
.         // Generate the column/row names and fill treatment path
.         local j = 1
2407.         foreach v of varlist _all {
2408.                 local m : var label `v'
2409.                 if strpos("`v'", "treatment_XX") > 0 {
2410.                         local k = substr("`v'", length("treatment_XX") + 1, .)
2411.                         local m = "ℓ=`=`k'-1'"
2412.                 }
2413.                 local colnames `colnames' `m'   
2414.                 
.                 // Fill treatement path
.                 forv i = 1/`=_N' {
2415.                         matrix desmat[`i', `j'] = `v'[`i']
2416.                 }
2417.                 local j = `j' + 1
2418.                 
.         }
2419.         local rownames
2420.         forv i = 1/`=_N' {
2421.                 local rownames `rownames' "TreatPath`i'"
2422.         }
2423.         foreach v in col row {
2424.                 mat `v'n desmat = ``v'names'
2425.         }
2426.         }
2427. 
.         // output in console
.         if "`des_path'" == "console" {          
2428.                 display _newline
2429.                 di "{hline 80}"
2430.                 di _skip(10) "{bf:Detection of treatment paths - `des_n' periods after first switch}
> "
2431.                 if "`by'" !=""{ 
2432.                         * Add description with the by variable level if by is specified 
.                         di _skip(35) "{bf:By: `by' = `val_lab_int_XX'}"
2433.                 }       
2434.                 di "{hline 80}"
2435.                 matlist desmat, format(%9.4gc)
2436.                 di "{hline 80}"
2437.                 di "{it: Treatment paths detected in at least `=strtrim("`des_per'")'% of the switch
> ing groups `tot_switch' for which `effects' effects could be estimated.}"
2438.                 di "{it: Total % = `=strtrim("`last_p'")' %}"
2439.                 
.                 // Get values for the reference line that explains how to read the table 
.                 qui {
2440.                         local n_groups = N_XX[1]
2441.                         local d_start = treatment_XX1[1]
2442.                         if `des_n' == 1 {
2443.                                 local d_vec : di %9.2gc treatment_XX2[1]
2444.                                 local d_vec = strtrim("`d_vec'")
2445.                         }
2446.                         else {
2447.                                 local d_vec = "vector ("
2448.                                 forv j = 1/`des_n' {
2449.                                         local k : di %9.2gc treatment_XX`=`j' + 1'[1]
2450.                                         local k = strtrim("`k'")
2451.                                         local d_vec = "`d_vec'`k', "
2452.                                 }
2453.                                 local d_vec = substr("`d_vec'", 1, length("`d_vec'")-2) + ")"
2454.                         }
2455.                 }
2456.                 di as text "{it: Design interpretation (first row):}"
2457.                 di as text "{it: `n_groups' groups started with treatment `d_start' and then experie
> nced treatment `d_vec'.}"           
2458.         }
2459.         
.         // output as excel
.         else if "`des_path'" != "console" & "`des_path'" !=  "" {
2460.                 if "`by'"==""{
2461.                 qui {
2462.                         putexcel set "`des_path'", replace sheet("Design", replace)
2463.                         putexcel A1 = matrix(desmat, names)
2464.                 }
2465.                  di "{bf:Design exported to `des_path'}"
2466.                 }
2467.                 else if "`by'"!=""{
2468.                         qui {
2469.                         * Create new sheet for each by level when by is specified       
.                         putexcel set "`des_path'", modify sheet("Design `by' = `val_lab_int_XX'", replac
> e)
2470.                         putexcel A1 = matrix(desmat, names)
2471.                         }
2472.                  di "{bf:Design exported to `des_path'}"
2473.         }  
2474.         }
2475. }
2476. 
. 
. ///// Date first switch option: produces a table showing the number of groups switching for the first ti
> me by period
> 
. if "`date_first_switch'" != "" {
2477.         qui {
2478. 
.         // Reload the data before it was changed in save_sample
.         use `data_predesign', clear
2479.         
.         // Fetch the arguments 
.         local dfs_opt = strtrim(substr("`date_first_switch'", 1, strpos("`date_first_switch'", ",") - 1)
> )
2480.         local dfs_path = strtrim(substr("`date_first_switch'", strpos("`date_first_switch'", ",") + 
> 1, .))
2481.         
.         // Error message if the arguments in the option were specified wrong
.         if "`dfs_opt'" != "" & "`dfs_opt'" != "by_baseline_treat" {
2482.                 di as error ""
2483.                 di as error "Only option {bf:by_baseline_treat} allowed"
2484.                 di as input _continue ""
2485.                 exit
2486.         }
2487.         
.         // Drop non switchers
.         drop if F_g_XX == T_max_XX+1 | F_g_XX == .
2488.         keep if time_XX == F_g_XX 
2489.         *Keep just 1 observation per group
.         keep `2' `3' F_g_XX d_sq_XX
2490.         }
2491.         
.         // When by_baseline_treat is not specified
.         if missing("`dfs_opt'") {
2492.                 qui {
2493.                 // collapse the number of groups by time
.                 gcollapse (count) `2', by(`3')
2494.                 tostring `3', replace
2495.                 // generate the share of each group
.                 sum `2'
2496.                 local tot_s = r(sum)
2497.                 gen share_XX = `2'/`tot_s' * 100
2498.                 
.                 // make matrix with the number and share of groups by time
.                 mkmat `2' share_XX, matrix(dfs) rownames(`3')
2499.                 mat colnames dfs = #Groups %Groups
2500.                 }
2501. 
.                 // output in console
.                 if "`dfs_path'" == "console" {          
2502.                         display _newline
2503.                         di "{hline 48}"
2504.                         di  _skip(10) "{bf:Switching dates}"
2505.                         if "`by'" !=""{ 
2506.                                 * Add description with the by variable level if by is specified
.                                 di _skip(10) "{bf:By: `by' = `val_lab_int_XX'}"
2507.                         }       
2508.                         di "{hline 48}"
2509.                         matlist dfs, format(%9.4gc) rowtitle("Any status quo treat.") twidth(25) // 
> New text
2510.                         di "{hline 48}"         
2511. 
.                         ereturn scalar switch_dates = `=_N'
2512.                 }
2513.                 // output as excel
.                 else if "`dfs_path'" != "console" & "`dfs_path'" !=  "" {
2514.                         if "`by'"==""{
2515.                                 qui putexcel set "`dfs_path'", replace sheet("Switching dates", repl
> ace)
2516.                                 qui putexcel A1 = matrix(dfs, names)
2517.                                 di "{bf:Switching dates exported to `dfs_path'}"
2518.                         }
2519.                         else if "`by'"!=""{
2520.                                 * Create new sheet for each by level when by is specified       
.                                 qui putexcel set "`dfs_path'", modify sheet("Switching dates `by' = `val
> _lab_int_XX'", replace)
2521.                                 qui putexcel A1 = matrix(dfs, names)
2522.                                 di "{bf:Switching dates exported to `dfs_path'}"
2523.                         }
2524.                 }               
2525.         }
2526.         
.         // When by_baseline_treat is specified
.         else {
2527.                 // collapse, but this time by time and status quo treatment
.                 qui {
2528.                 gcollapse (count) `2', by(`3' d_sq_XX)
2529.                 tostring `3', replace
2530.                 gegen tot_share_XX = sum(`2'), by(d_sq_XX)
2531.                 gen share_XX = `2'/tot_share_XX * 100
2532.                 sort d_sq_XX `3'
2533.                 }
2534.                 
.                 display _newline
2535.                 if "`dfs_path'" == "console" {
2536.                         di "{hline 48}"
2537.                         di _skip(10) "{bf:Switching dates}"
2538.                         di "{hline 48}"
2539.                 }
2540.                 
.                 // make matrix with the number and share of groups by time, one for each level of status
>  quo treatment
.                 qui {
2541.                         tostring d_sq_XX, replace
2542.                         levelsof d_sq_XX, local(levels_d_sq_XX)
2543.                         local i = 1
2544.                 }
2545.                 foreach m of local levels_d_sq_XX {
2546.                         qui {
2547.                                 mkmat `2' share_XX if d_sq_XX == "`m'", matrix(dfs`i') rownames(`3')
2548.                                 mat colnames dfs`i' = #Groups %Groups
2549.                                 sum `2'
2550.                                 local tot_s = r(sum)
2551.                         }                       
2552.                         // output in console
.                         if "`dfs_path'" == "console" {          
2553.                                 matlist dfs`i', format(%9.4gc) rowtitle("Status quo treat. = `m'") t
> width(25) // New
2554.                                 di "{hline 48}"
2555.                                 qui {
2556.                                         sum `2' if d_sq_XX == "`m'"
2557.                                         local tot_s = r(sum)
2558.                                         count if d_sq_XX == "`m'"
2559.                                         ereturn scalar switch_dates_Dsq_`l_by' = `r(N)' // New
2560.                                 }
2561.                         }
2562.                         // output as excel
.                         else if "`dfs_path'" != "console" & "`dfs_path'" !=  "" {
2563.                                 qui {
2564.                                 if `i' == 1 {
2565.                                         local rep_opt "replace"
2566.                                 }
2567.                                 else {
2568.                                         local rep_opt "modify"
2569.                                 }
2570.                                 
.                                 if "`by'"==""{
2571.                                         putexcel set "`dfs_path'", `rep_opt' sheet("Switch. Dates Ba
> se treat `m'", replace)
2572.                                         putexcel A1 = matrix(dfs`i', names)
2573.                                         noi di _newline
2574.                                 }
2575.                                 else if "`by'"!=""{
2576.                                         * Create new sheet for each by level when by is specified
.                                         putexcel set "`dfs_path'", modify sheet("Dates Base treat=`m' & 
> `by' = `val_lab_int_XX'", replace) //`by' = `val_lab_int_XX'
2577.                                         putexcel A1 = matrix(dfs`i', names)
2578.                                         noi di _newline
2579.                                 }       
2580.                         }
2581.                 }
2582.                 local i = `i' + 1                       
2583.                 }
2584.                 // consol message if output is written to excel
.                 if "`dfs_path'" != "console" & "`dfs_path'" != "" {
2585.                         di "Switching dates exported to `dfs_path'"
2586.                 }
2587.         }
2588. }
