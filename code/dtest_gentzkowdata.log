1068. 
. // Counting number of switchers DID_\ell applies to
. 
. scalar N_switchers_effect_`i'_XX=N1_`i'_XX_new+N0_`i'_XX_new
1069. matrix mat_res_XX[`i',6]=N_switchers_effect_`i'_XX
1070. matrix mat_res_XX[`i',7]=`i'
1071. ereturn scalar N_switchers_effect_`i' = N_switchers_effect_`i'_XX
1072. 
. // Counting number of observations used in the computation of DID_\ell
. 
. gegen N_effect_`i'_XX = total(count`i'_global_XX) 
1073. scalar N_effect_`i'_XX = N_effect_`i'_XX
1074. ereturn scalar N_effect_`i' = N_effect_`i'_XX
1075. matrix mat_res_XX[`i',5]=N_effect_`i'_XX
1076. 
. // Modif Felix weight -> Display correct N with weights
. if "`weight'"!=""{
1077.         matrix mat_res_XX[`i',6]=N1_`i'_XX_weight+N0_`i'_XX_weight
1078.         ereturn scalar N_switchers_effect_`i'_w= N1_`i'_XX_weight+N0_`i'_XX_weight
1079. 
.         capture drop count`i'_global_XX_w
1080.         capture drop N_effect_`i'_XX_w
1081.         
.         gen count`i'_global_XX_w=count`i'_global_XX/weight_XX
1082.         gegen N_effect_`i'_XX_w = total(count`i'_global_XX_w) 
1083.         scalar N_effect_`i'_XX_w = N_effect_`i'_XX_w
1084.         ereturn scalar N_effect_`i'_w = N_effect_`i'_XX_w
1085.         matrix mat_res_XX[`i',5]=N_effect_`i'_XX_w
1086. }
1087. 
