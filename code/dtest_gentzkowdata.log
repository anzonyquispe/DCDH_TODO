>  N°101043899)."
2724. 
. // Restoring data
. restore
2725. 
. ///// When both save_sample and by were specified merge the different datasets for each level of the by 
> variable into one dataset that will be in memory after the command ran
> if "`save_sample'" != "" { 
2726.         if "`by'"==""{
2727.         qui merge m:1 `2' `3' using `did_sample', gen(_merge_XX)
2728.         qui drop if _merge_XX == 2
2729.         qui drop _merge_XX
2730.         }
2731.         else if "`by'"!=""{
