1519.                 if ("`switchers'"==""&(N1_placebo_`i'_XX_new!=0|N0_placebo_`i'_XX_new!=0))|("`switch
> ers'"=="out"&N0_placebo_`i'_XX_new!=0)|("`switchers'"=="in"&N1_placebo_`i'_XX_new!=0){
1520.                         scalar all_Ns_pl_not_zero=all_Ns_pl_not_zero+1
1521.                         
.                 }
