325. 
.         capture drop count_d_non_miss_XX
326.         capture drop count_d_non_miss_temp_XX
327.         capture drop changed_XX 
328.         capture drop spell_XX 
329.         capture drop periods_since_change_XX 
330.         capture drop reset_dummy_XX 
331.         capture drop reset_count_XX 
332.         capture drop new_group_XX
333. 
.         //// Balancing panel to all complete treatment paths
> 
.         gen count_d_non_miss_temp_XX=(treatment_XX!=.)
334.         bys group_XX: gegen count_d_non_miss_XX=sum(count_d_non_miss_temp_XX)
335.         sum count_d_non_miss_XX
336.         drop if count_d_non_miss_XX<r(max)
337. 
.         //// Time since last treatment change
> 
.         xtset group_XX time_XX
338. 
.         bysort group_XX (time_XX): gen changed_XX = treatment_XX != treatment_XX[_n-1] if _n > 1
339.         bysort group_XX (time_XX): replace changed_XX = 0 if _n == 1
340. 
.         bysort group_XX (time_XX): gen spell_XX = sum(changed_XX)
341. 
.         bysort group_XX spell_XX (time_XX): gen periods_since_change_XX = _n - 1
342.         replace periods_since_change_XX=0 if spell_XX==0
343. 
.         //// Treatment paths with one treatment change and then no change for `reset' periods
>         gen reset_dummy_XX=(periods_since_change_XX==`reset')
344. 
.         bysort group_XX (time_XX): gen reset_count_XX=sum(reset_dummy_XX)
345. 
.         //// New group variable
> 
.         gegen new_group_XX=group(group_XX reset_count_XX)
346. 
.         //// Clustering at the level of the old group variable if no clustering variable was specified
> 
.         * If a clustering variable was specified, it should in principle be coarser than the old group v
> ariable (that's what is requested in the help file).
.         * However, the check for that takes place below (around line 900), and will now be made with the
>  new group variable, so a user could for instance voluntarily specify the new group variable as their cl
> ustering
.         * variable to have a more granular clustering level than old group. Given that this type of beha
> vior would need to be deliberate (not an unvoluntary mistake), I think it is fine to leave the code as i
> s rather than
.         * moving the check that the clustering variable is coarser than the group variable up. 
. 
.         if "`cluster'"==""{
347.                 capture drop old_group_XX
348.                 gen old_group_XX=group_XX
349.                 local cluster = "old_group_XX"
350.         }
351. 
.         //// Replacing the group variable by the new group variable
> 
.         replace group_XX= new_group_XX  
352. 
.         //// Dropping all variables that were created and are now unnecessary
>         drop count_d_non_miss_temp_XX count_d_non_miss_XX changed_XX spell_XX periods_since_change_XX re
> set_dummy_XX reset_count_XX new_group_XX
353.         
. }
