1496.                         
.                         
.                         sum U_Gg_var_comb_`i'_`j'_2_XX
1497.                         scalar var_sum_comb_`i'_`j'_XX=r(sum)/G_XX^2
1498.                         
.                         scalar cov_comb_`i'_`j'_XX = (scalar(var_sum_comb_`i'_`j'_XX) - scalar(se_all_`i
> '_XX)^2 - scalar(se_all_`j'_XX)^2)/2
1499.         
.                         * Store the results
.                         matrix didmgt_Var_all_XX[`i',`j']= scalar(cov_comb_`i'_`j'_XX)
1500.                         matrix didmgt_Var_all_XX[`j',`i']= scalar(cov_comb_`i'_`j'_XX)
1501. 
.                 }
1502.         }
1503.         
. }
1504. 
. *** Modif Felix: replace by bootstrap var/cov matrix
. if `bootstrap_XX'!=0{
1505.         matrix didmgt_Var_all_XX=bs_var_cov_XX
1506. }
1507. 
. }
1508.         // Error message if not all of the specified effects/placebos could be estimated 
.         else{
