. 
. if ("`switchers'"==""&N1_`i'_XX_new==0&N0_`i'_XX_new==0)|("`switchers'"=="out"&N0_`i'_XX_new==0)|("`swit
> chers'"=="in"&N1_`i'_XX_new==0){
