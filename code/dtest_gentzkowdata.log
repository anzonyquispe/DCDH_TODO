. if "`cluster'"!=""{
1481. replace first_obs_by_gp_XX=first_obs_by_clust_XX
1482. }
1483. 
. forvalue i=1/`total_num_estimates_XX'{
1484.                 
.                 // Fill the diagonal with the Variances
