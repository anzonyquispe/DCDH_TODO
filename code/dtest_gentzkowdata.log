1537.                         capture drop U_Gg_var_pl_`i'_`j'_2_XX
1538.                                         
.                         if ("`normalized'"==""){
1539.                         gen U_Gg_var_pl_`i'_`j'_XX = U_Gg_var_glob_pl_`i'_XX + U_Gg_var_glob_pl_`j'_
> XX
1540.                 }
1541.                         
.                         if "`normalized'"!=""{
