2166.                 mat V = (V, J(`nv',`nc', 0)\J(`nc', `nv', 0), V`i')
2167.                 local rnames ""
2168.                 foreach rn in `effect_het_rownames_`i'_XX' {
2169.                         local rnames "`rnames' Effect_`i':`rn'"
2170.                 }
2171.                 local het_rown "`het_rown' `rnames'"
2172.         }       
2173.         
.         // split this to add both effects and placebos to the ereturn
.         foreach i in `all_effects_XX_pl'{ // Modif Felix (delta_XX error)
2174.                 local nc = rowsof(effect_het_pl_`i'_XX)
2175.                 local nv = rowsof(V)
2176.                 mat V`i' = J(`nc', `nc', 0)
2177.                 forv j = 1/`nc' {
2178.                         mat b = (b, scalar(effect_het_pl_`i'_XX[`j', 1]))
2179.                         mat V`i'[`j', `j'] = scalar(effect_het_pl_`i'_XX[`j', 2])^2
2180.                 }
2181.                 mat V = (V, J(`nv',`nc', 0)\J(`nc', `nv', 0), V`i')
2182.                 local rnames ""
2183.                 foreach rn in `pl_het_rownames_`i'_XX' {
2184.                         local rnames "`rnames' Placebo_`i':`rn'"
2185.                 }
2186.                 local het_rown "`het_rown' `rnames'"
2187.         }
2188.         
.         mat coln b = `het_rown'
2189.         mat rown V = `het_rown'
2190.         mat coln V = `het_rown'
2191. }
2192. 
. // Felix -> Lets add cap and print error message when we are in the case with some missings in the matri
> ces (cases where we have missings in the output table)
. cap ereturn post b V 
2193. if _rc!=0{
2194.         di ""
2195.         di as error "Warning: some of the effects/placebos could not be computed so e(b)/e(V) will n
> ot be defined!"
2196. }
2197. 
. // Felix: Continue by adding Av_tot_eff to the Var/Cov matrix
. 
. forvalue i=1/`=l_XX'{
2198. capture ereturn scalar Effect_`i' = scalar(DID_`i'_XX)
2199. capture ereturn scalar N_effect_`i' = N_effect_`i'_XX
2200. capture ereturn scalar N_switchers_effect_`i' = N_switchers_effect_`i'_XX
2201. capture ereturn scalar se_effect_`i'=scalar(se_`i'_XX)
2202. }
2203. ereturn local effects `"`str_effects'"'
