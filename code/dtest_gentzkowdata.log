1465. forvalue i=1/`=l_XX'{
1466.         gen U_Gg_var_comb_`i'_XX=U_Gg_var_glob_`i'_XX
1467.         scalar se_all_`i'_XX=se_`i'_XX
1468.         if "`normalized'"!=""{
1469.                 scalar delta_D_all_`i'_XX=delta_D_`i'_global_XX
1470.         }
1471. }
1472. forvalue i=`=l_XX+1'/`total_num_estimates_XX'{
1473.         local j=`i'-`=l_XX'
1474.         gen U_Gg_var_comb_`i'_XX=U_Gg_var_glob_pl_`j'_XX
1475.         scalar se_all_`i'_XX=se_placebo_`j'_XX
1476.         if "`normalized'"!=""{
1477.                 scalar delta_D_all_`i'_XX=delta_D_pl_`j'_global_XX
1478.         }
1479. }
1480. 
. 
. // If the option cluster is specified, we have previously replaced U_Gg_var_glob_pl_`i'_XX by clust_U_Gg
> _var_glob_pl_`i'_XX, and U_Gg_var_glob_`i'_XX by clust_U_Gg_var_glob_`i'_XX. 
