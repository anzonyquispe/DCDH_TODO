1318.                 local for_count_2_XX=`=l_XX'+`=l_placebo_XX' // Felix: obsolete
1319.                 local for_count_3_XX=`=l_XX'+1 // Felix: obsolete
1320.                 foreach k of numlist `num_pl_XX'{
1321.                         mat se_pl_bs_XX[`k',1]=bs_out_XX[2,`j']
1322.                         local j=`j'+1
1323.                 }
1324.         }
1325.         
.         if "`trends_lin'"==""{
1326.         // row l_XX+l_placebo_XX+1 isvaverage cummulative (total) effect
.         mat se_avg_eff_bs_XX=bs_out_XX[2,`j']
