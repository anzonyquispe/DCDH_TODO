1253.         
.         // gen numlists
.         numlist "1/`=l_XX'"
1254.         local num_eff_XX "`r(numlist)'"
1255.         // Adjust for missings
.         local num_eff_XX: list num_eff_XX- missing_eff_XX
1256.         
.         if `=l_placebo_XX'>0{
1257.         numlist "1/`=l_placebo_XX'"
