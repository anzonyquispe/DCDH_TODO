> 1_`i'_XX_new+N0_`i'_XX_new))*U_Gg`i'_minus_XX
1062. replace U_Gg`i'_global_XX=. if first_obs_by_gp_XX==0
1063. 
. gen count`i'_global_XX = max(count`i'_plus_XX, count`i'_minus_XX)
1064. 
. // Computing aggregated delta_D (difference between treatments received wrt status quo, from F_g-1 to F_
> g-1+\ell), only needed for the normalized estimator 
.         if "`normalized'"!=""{
1065.         scalar delta_D_`i'_global_XX = (N1_`i'_XX_new/(N1_`i'_XX_new+N0_`i'_XX_new))*delta_D_`i'_in_
> XX+(N0_`i'_XX_new/(N1_`i'_XX_new+N0_`i'_XX_new))*delta_D_`i'_out_XX
1066.         }
1067. 
. // Storing the results and the number of switchers into the matrix mat_res_XX
