1446.                 if ("`switchers'"==""&(N1_placebo_`i'_XX_new!=0|N0_placebo_`i'_XX_new!=0))|("`switch
> ers'"=="out"&N0_placebo_`i'_XX_new!=0)|("`switchers'"=="in"&N1_placebo_`i'_XX_new!=0){
1447.                         scalar all_Ns_pl_not_zero=all_Ns_pl_not_zero+1
1448.                         
.                 }
1449.                 // Count the number of normalized placebos that can be estimated
