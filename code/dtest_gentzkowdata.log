. if "`trends_lin'"==""{
2223. capture ereturn scalar Av_tot_effect = scalar(delta_XX)
2224. capture ereturn scalar N_avg_total_effect = scalar(N_effect_XX)
2225. capture ereturn scalar N_switchers_effect_average = N_switchers_effect_XX
2226. capture ereturn scalar se_avg_total_effect = se_XX
2227. }
