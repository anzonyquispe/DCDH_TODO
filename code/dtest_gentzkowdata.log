1133. capture drop N_effect_XX
1134. gen count_global_XX=0
1135. forvalue i=1/`=l_XX'{
1136.         replace count_global_XX= max(count_global_XX, count`i'_global_XX)
1137. }
1138. sum count_global_XX
1139. scalar N_effect_XX=r(sum)
1140. matrix mat_res_XX[l_XX+1,5]=scalar(N_effect_XX)
1141. ereturn scalar N_avg_total_effect = scalar(N_effect_XX)
1142. 
. }
1143. 
. // Modif Felix weight
. if "`weight'"!=""{
