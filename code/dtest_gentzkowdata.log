. if l_placebo_XX!=0{
1368. 
. forvalue i=1/`=l_placebo_XX'{
1369. if ("`switchers'"==""&(N1_placebo_`i'_XX_new!=0|N0_placebo_`i'_XX_new!=0))|("`switchers'"=="out"&N0_
> placebo_`i'_XX_new!=0)|("`switchers'"=="in"&N1_placebo_`i'_XX_new!=0){ 
1370. 
