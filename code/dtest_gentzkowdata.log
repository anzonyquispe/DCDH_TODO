. ///// Option that shows a table with weights attached to each normalized effect
> if "`normalized_weights'" != "" {
2247.         qui {
2248.                 // Error as normalized_weights only works in combination with normalized
.                 if "`normalized'" == "" {
2249.                         noi di as err "normalized option required to compute normalized_weights"
2250.                         di as input _continue ""
2251.                         exit
2252.                 }
2253. 
.         // Set up the matrix for the output table
.         mat define weight_mat = J(`=l_XX + 1', `=l_XX', .)
2254.         local cols ""
2255. 
.         forv i = 1/`=l_XX'{     
2256.                 local m = "ℓ=`i'"
2257.                 local cols `cols' `m'
2258.                 gen N_gt_`i'_temp_XX = N_gt_XX if time_XX == F_g_XX - 1 + `i' & `i' <= L_g_XX & N_gt
> _control_`i'_XX > 0 & N_gt_control_`i'_XX != . & diff_y_`i'_XX != .
2259.                 gegen N_gt_`i'_XX = mean(N_gt_`i'_temp_XX), by(group_XX)
2260.                 drop N_gt_`i'_temp_XX
2261.                 forv k = 0/`=`i' - 1' {
2262.                         // Visualization by k
.                         local row = `k' + 1
2263.                         
.                         // Compute the delta_ℓ_k, if the continuous option is specified the original tre
> atment values are used
.                         if `continuous'==0{
2264.                         gen delta_`i'_`k' = abs(treatment_XX - d_sq_XX) if time_XX == F_g_XX - 1 + `
> i' - `k' & F_g_XX - 1 + `i' <= T_g_XX
2265.                         }
2266.                         else if `continuous'>0{
2267.                         gen delta_`i'_`k' = abs(treatment_XX_orig - d_sq_XX_orig) if time_XX == F_g_
> XX - 1 + `i' - `k' & F_g_XX - 1 + `i' <= T_g_XX
2268.                         }
2269.                         replace delta_`i'_`k' = delta_`i'_`k' * N_gt_`i'_XX
2270.                         // Filling the weight matrix 
.                         sum delta_`i'_`k'
2271.                         mat weight_mat[`row', `i'] = (`r(sum)' / scalar(delta_D_`i'_global_XX)) / sc
> alar(N_switchers_effect_`i'_XX)
2272.                         //mat weight_mat[`row', `i'] = (`r(sum)' / `denom_`i'_norm_XX')
.                 }               
2273.                 drop N_gt_`i'_XX
2274.         }
2275.         
.         // Generating the row names 
.         // Visualization by k 
.         local rows ""
2276.         forv j = 1/`=l_XX' {
2277.                         local r = "k=`=`j'-1'"
2278.                         local rows `rows' `r'
2279.         }       
2280. 
.         local rows `rows' "Total"
2281.         
.         // Fill the values for the displayed table
.         matrix define mat_temp = J(`=l_XX', `=l_XX', 0) 
2282.         forv i = 1/`=l_XX' {
2283.                 forv j = 1/`=l_XX' {
2284.                         if weight_mat[`i', `j'] != . {
2285.                                 mat mat_temp[`i', `j'] = weight_mat[`i', `j']
2286.                         }
2287.                 }
2288.         }       
2289.         
.         // Getting the correct order
.         matrix define mat_total = mat_temp' * J(`=l_XX', 1, 1)
2290.         forv i = 1/`=l_XX' {
2291.                 mat weight_mat[`=l_XX+1', `i'] = mat_total[`i', 1]
2292.         }
2293.         
.         // Add row and column names
.         mat rown weight_mat = `rows'
2294.         mat coln weight_mat = `cols'    
2295.         }
2296. 
.         // Output the table
.         display _newline
2297.         di "{hline 70}"
2298.         di _skip(15) "{bf:Weights on treatment lags}"
2299.         if "`by'" !=""{ 
2300.         * Add description with the by variable level if by is specified 
.         di _skip(25) "{bf:By: `by' = `val_lab_int_XX'}"
2301.         }       
2302.         di "{hline 70}"
2303.         matlist weight_mat, format(%9.4fc) lines(rowtotal)
2304.         display _newline                
2305. }
