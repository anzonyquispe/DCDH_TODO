.         forvalue i=1/`=l_placebo_XX'{
1532.                 
.                 matrix didmgt_Placebo[`i',1]=scalar(DID_placebo_`i'_XX)
1533.                 matrix didmgt_Var_Placebo[`i',`i']= scalar(se_placebo_`i'_XX)^2
1534.         
.                 if `i'<`=l_placebo_XX'{
1535.                 forvalue j=`=`i'+1'/`=l_placebo_XX'{
1536.                         
