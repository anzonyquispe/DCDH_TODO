.         capture drop sum_treat_until_`i'_pl_XX
606.         capture drop delta_D_pl_`i'_cum_temp_XX
607. 
.         if `continuous'==0{
608.         bys group_XX : gegen sum_treat_until_`i'_pl_XX = total(treatment_XX - d_sq_XX) if time_XX>=F_
> g_XX&time_XX<=F_g_XX-1+`i'& S_g_XX==increase_XX
609.         } // FELIX 18.03.2025 (delete the diff_y_pl_`i'_XX!=. condition)
610. 
.         else if `continuous'>0{
611.                 bys group_XX : gegen sum_treat_until_`i'_pl_XX = total(treatment_XX_orig - d_sq_XX_or
> ig) if time_XX>=F_g_XX&time_XX<=F_g_XX-1+`i'&S_g_XX==increase_XX
612.         } // FELIX 18.03.2025 (delete the diff_y_pl_`i'_XX!=. condition)
613. 
. gen delta_D_pl_`i'_cum_temp_XX = N_gt_XX/N`=increase_XX'_placebo_`i'_XX*[sum_treat_until_`i'_pl_XX* S_g_
> XX + (1-S_g_XX)*(-sum_treat_until_`i'_pl_XX)] if dist_to_switch_pl_`i'_XX==1
614. 
.         sum  delta_D_pl_`i'_cum_temp_XX
615.         scalar delta_norm_pl_`i'_XX = r(sum)
616. }
617. 
. 
. 
. } // End of the loop over l_placebo_u_a_XX.
618. }
619. 
. scalar Ntrendslin_pl=1
620. forvalue i=1/`=l_placebo_u_a_XX' {
621. scalar Ntrendslin_pl=min(Ntrendslin_pl , N`=increase_XX'_placebo_`i'_XX )
622. }
623. 
. 
. if "`trends_lin'"!="" & Ntrendslin_pl != 0 {
