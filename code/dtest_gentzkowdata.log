. ********************************************************************************
. *                                 PROGRAM 2                                    *
. ********************************************************************************
. *Main goal: compute the variables U_Gg_plus_XX, U_Gg_minus_XX, U_Gg_var_plus_XX, and U_Gg_var_minus_XX,
. *which are necessary to compute the DID_\ell estimators and their variance.
. 
. capture program drop did_multiplegt_dyn_core_new

. 
. program did_multiplegt_dyn_core_new, eclass
  1.         version 12.0
  2.         syntax varlist(min=4 max=4 numeric) [, effects(integer 1) placebo(integer 0) switchers(string
> ) only_never_switchers controls(varlist numeric) trends_nonparam(varlist numeric) weight(varlist numeric
> ) dont_drop_larger_lower NORMALIZED cluster(varlist numeric) graphoptions(string) SAVe_results(string) g
> raph_off same_switchers same_switchers_pl drop_if_d_miss_before_first_switch trends_lin ci_level(integer
>  95) by(varlist numeric max=1) predict_het(string) design(string) date_first_switch(string) NORMALIZED_w
> eights CONTinuous(string) switchers_core(string) less_conservative_se]
  3.         qui{
  4.                 
. ////////// 1. Scalars initialization
> 
. ///// Initializing the number of effects and placebos to estimate, depending on whether we consider swit
> chers in or switchers out. 
> ///// Initializing also a scalar for whether the estimation is for switchers in or out.
>         
. if "`switchers_core'"=="in"{
  5. scalar l_u_a_XX=min(`effects', L_u_XX)
  6. 
. if `placebo'!=0{
  7.         scalar l_placebo_u_a_XX=min(`placebo', L_placebo_u_XX)
  8.         }
  9. 
.         scalar increase_XX=1
 10. }
 11. 
. if "`switchers_core'"=="out"{
 12. scalar l_u_a_XX=min(`effects', L_a_XX)
 13. 
. if `placebo'!=0{
 14.         scalar l_placebo_u_a_XX=min(`placebo', L_placebo_a_XX)
 15.         }
 16. 
. scalar increase_XX=0
 17. }
 18. 
. ///// Initializing values of baseline treatment
> levelsof d_sq_int_XX, local(levels_d_sq_XX)
 19. 
. ////////// 2. Data preparation steps to generate variables necessary for computation of event-study effe
> cts     
> 
. ///// Drop some variables we only create once
> capture drop num_g_paths_0_XX
 20. capture drop cohort_fullpath_0_XX
 21. capture drop path_0_XX
 22. capture drop d_fg0_XX 
 23. 
. ///// Loop over the number of dynamic effects_equal
> 
. forvalue i=1/`=l_u_a_XX'{
 24. 
. ///// Capture drop of variables created below
> 
. capture drop distance_to_switch_`i'_XX
 25. capture drop never_change_d_`i'_XX
 26. capture drop N`=increase_XX'_t_`i'_XX
 27. capture drop N`=increase_XX'_t_`i'_XX_w
 28. capture drop N`=increase_XX'_t_`i'_g_XX
 29. capture drop N_gt_control_`i'_XX
 30. capture drop diff_y_`i'_XX
 31. capture drop dummy_U_Gg`i'_XX
 32. capture drop U_Gg`i'_temp_XX
 33. capture drop U_Gg`i'_XX
 34. capture drop count`i'_core_XX
 35. capture drop U_Gg`i'_temp_var_XX
 36. capture drop U_Gg`i'_var_XX
 37. 
. capture drop never_change_d_`i'_wXX
 38. capture drop distance_to_switch_`i'_wXX
 39. 
. capture drop d_fg`i'_XX
 40. capture drop path_`i'_XX
 41. capture drop num_g_paths_`i'_XX
 42. capture drop cohort_fullpath_`i'_XX
 43. 
. capture drop dof_cohort_`i'_s_t_XX
 44. capture drop dof_cohort_`i'_ns_t_XX
 45. capture drop dof_cohort_`i'_s0_t_XX
 46. capture drop dof_cohort_`i'_s1_t_XX
 47. capture drop dof_cohort_`i'_s2_t_XX
 48. capture drop count_cohort_`i'_s_t_XX
 49. capture drop count_cohort_`i'_ns_t_XX
 50. capture drop count_cohort_`i'_s0_t_XX
 51. capture drop count_cohort_`i'_s1_t_XX
 52. capture drop count_cohort_`i'_s2_t_XX
 53. capture drop total_cohort_`i'_s_t_XX
 54. capture drop total_cohort_`i'_ns_t_XX
 55. capture drop total_cohort_`i'_s0_t_XX
 56. capture drop total_cohort_`i'_s1_t_XX
 57. capture drop total_cohort_`i'_s2_t_XX
 58. capture drop mean_cohort_`i'_s_t_XX
 59. capture drop mean_cohort_`i'_ns_t_XX
 60. capture drop mean_cohort_`i'_s0_t_XX
 61. capture drop mean_cohort_`i'_s1_t_XX
 62. capture drop mean_cohort_`i'_s2_t_XX
 63. 
. capture drop E_hat_gt_`i'_XX
 64. capture drop DOF_gt_`i'_XX
 65. 
. ///// Creating long difference of outcome
> 
. xtset group_XX time_XX
 66. bys group_XX : gen diff_y_`i'_XX = outcome_XX - L`i'.outcome_XX
 67. 
. ///// Creating treatment paths if less_conservative_se option specified
> 
. if "`less_conservative_se'" != ""{
 68. 
. // Creating a time-invariant, group-level variable, containing g's treatment at F_g-1+\ell
. gen d_fg_XX_temp=treatment_XX if time_XX==F_g_XX + `=-1+`i''
 69. bys group_XX: gegen d_fg`i'_XX=mean(d_fg_XX_temp)
 70. 
. // This variable might be missing, for groups whose treatment never changes, and
. // for groups not observed \ell periods after treatment change. Then, we impute
. // their treatment at F_g-1+\ell-1. Inconsequential, just to avoid missing values.
. // We also need to initialize a variable d_fg0_XX, when \ell=1.
. if `i'==1{
 71. gen d_fg0_XX=d_sq_XX
 72. gegen path_0_XX=group(d_fg0_XX F_g_XX)
 73. }
 74. replace d_fg`i'_XX=d_fg`=`i'-1'_XX if d_fg`i'_XX==.
 75. gegen path_`i'_XX = group(path_`=`i'-1'_XX d_fg`i'_XX)
 76. drop d_fg_XX_temp 
 77. 
. // For each group, define a variable counting how many groups belong to the same cohort,
. // with cohorts defined as d_fg0_XX F_g_XX, as well as the full path.
. if `i'==1{
 78.         bysort path_0_XX: gegen num_g_paths_0_XX=nunique(group_XX)
 79. }
 80. bysort path_`i'_XX: gegen num_g_paths_`i'_XX=nunique(group_XX)
 81. 
. // For each group, generate a dummy for whether at least two groups in their cohort.
. gen cohort_fullpath_`i'_XX=(num_g_paths_`i'_XX>1)
 82. if `i'==1{
 83. gen cohort_fullpath_0_XX=(num_g_paths_0_XX>1) 
 84. }
 85. }
 86. 
. ///// Identifying the control (g,t)s in the estimation of dynamic effect i 
> bys group_XX: gen never_change_d_`i'_XX=(F_g_XX>time_XX) if diff_y_`i'_XX!=.
 87. 
. if "`only_never_switchers'" != "" {
 88.         replace never_change_d_`i'_XX = 0 if F_g_XX > time_XX & F_g_XX < T_max_XX + 1 & diff_y_`i'_XX
>  != .
 89. }
 90. 
. ///// Creating N^g_t:
> ///// number of control groups for g at t
> gen never_change_d_`i'_wXX = never_change_d_`i'_XX*N_gt_XX
 91. bys time_XX d_sq_XX `trends_nonparam': gegen N_gt_control_`i'_XX=total(never_change_d_`i'_wXX)
 92. 
. ///// Creating binary variable indicating whether g is \ell periods away from switch
> 
. // If the same_switchers option is specified:
. 
. if ("`same_switchers'"!=""){
 93. 
. capture drop relevant_y_missing_XX
 94. capture drop cum_fillin_XX
 95. capture drop fillin_g_XX 
 96. capture drop fillin_g_pl_XX
 97. capture drop dum_fillin_temp_XX 
 98. capture drop still_switcher_`i'_XX  
 99. 
. sort group_XX time_XX
100. 
. // Modif. Diego 31-03-2025: long-difference and other variables to tailor distance_to_switch to the grou
> ps for which the all the effects can be computed
. cap drop N_g_control_check_XX
101. gen N_g_control_check_XX = 0
102. 
. forv j = 1/`=`effects'' {
103.         cap drop diff_y_last_XX
104.         cap drop never_change_d_last_XX
105.         cap drop never_change_d_last_wXX
106.         cap drop N_gt_control_last_XX
107.         cap drop N_g_control_last_temp_XX
108.         cap drop N_g_control_last_m_XX
109.         cap drop diff_y_relev_temp_XX
110.         cap drop diff_y_relev_XX
111. 
.         xtset group_XX time_XX
112.         bys group_XX : gen diff_y_last_XX = outcome_XX - L`j'.outcome_XX
113.         bys group_XX: gen never_change_d_last_XX=(F_g_XX>time_XX) if diff_y_last_XX!=.
114.         if "`only_never_switchers'" != "" {
115.                 replace never_change_d_last_XX = 0 if F_g_XX > time_XX & F_g_XX < T_max_XX + 1 & diff
> _y_last_XX != .
116.         }
117.         gen never_change_d_last_wXX = never_change_d_last_XX*N_gt_XX
118.         bys time_XX d_sq_XX `trends_nonparam': gegen N_gt_control_last_XX=total(never_change_d_last_w
> XX)
119. 
.         gen N_g_control_last_temp_XX = N_gt_control_last_XX if time_XX == F_g_XX - 1 + `j'
120.         bys group_XX: egen N_g_control_last_m_XX = mean(N_g_control_last_temp_XX)
121. 
.         gen diff_y_relev_temp_XX = diff_y_last_XX if time_XX == F_g_XX - 1 + `j'
122.         bys group_XX: egen diff_y_relev_XX = mean(diff_y_relev_temp_XX)
123. 
.         replace N_g_control_check_XX = N_g_control_check_XX + (N_g_control_last_m_XX > 0 & diff_y_relev_
> XX != .)
124. }
125. 
. * If the same_switchers_pl option is specified:
. 
. if ("`same_switchers_pl'"!=""){
126. cap drop N_g_control_check_pl_XX
127. gen N_g_control_check_pl_XX = 0
128. forv j = 1/`=`placebo'' {
129.         cap drop diff_y_last_XX
130.         cap drop never_change_d_last_XX
131.         cap drop never_change_d_last_wXX
132.         cap drop N_gt_control_last_XX
133.         cap drop N_g_control_last_temp_XX
134.         cap drop N_g_control_last_m_XX
135.         cap drop diff_y_relev_temp_XX
136.         cap drop diff_y_relev_XX
137. 
.         xtset group_XX time_XX
138.         bys group_XX : gen diff_y_last_XX = outcome_XX - F`j'.outcome_XX
139.         bys group_XX: gen never_change_d_last_XX=(F_g_XX>time_XX) if diff_y_last_XX!=.
140.         if "`only_never_switchers'" != "" {
141.                 replace never_change_d_last_XX = 0 if F_g_XX > time_XX & F_g_XX < T_max_XX + 1 & diff
> _y_last_XX != .
142.         }
143.         gen never_change_d_last_wXX = never_change_d_last_XX*N_gt_XX
144.         bys time_XX d_sq_XX `trends_nonparam': gegen N_gt_control_last_XX=total(never_change_d_last_w
> XX)
145. 
.         gen N_g_control_last_temp_XX = N_gt_control_last_XX if time_XX == F_g_XX - 1 - `j'
146.         bys group_XX: egen N_g_control_last_m_XX = mean(N_g_control_last_temp_XX)
147. 
.         gen diff_y_relev_temp_XX = diff_y_last_XX if time_XX == F_g_XX - 1 - `j'
148.         bys group_XX: egen diff_y_relev_XX = mean(diff_y_relev_temp_XX)
149. 
.         replace N_g_control_check_pl_XX = N_g_control_check_pl_XX + (N_g_control_last_m_XX > 0 & diff_y_
> relev_XX != .)
150. }
151. * Generate a variable tagging the switchers that should be dropped
. * Is the case if at least one of the placebos or effects we try to estimate is missing:
. gen relevant_y_missing_XX=(outcome_XX==.&time_XX>=F_g_XX-1-`=`placebo''&time_XX<=F_g_XX-1+`=`effects'') 
152. * Or if some of the controls are missing:
. if "`controls'" != ""{
153. replace relevant_y_missing_XX=1 if fd_X_all_non_missing_XX==0&time_XX>=F_g_XX-1-`=`placebo''&time_XX<
> =F_g_XX-1+`=`effects''
154. }
155. 
. // Modif. Diego 19-04-25: make the same adjustments as below in case same_switcher_pl is specified
. //bys group_XX: gen cum_fillin_XX = sum(relevant_y_missing_XX)
. //gen dum_fillin_temp_XX = (cum_fillin_XX==0&time_XX==F_g_XX-1+`=`effects'')
. //bys group_XX: gegen fillin_g_XX = total(dum_fillin_temp_XX)
. 
. //gen dum_fillin_temp_pl_XX = (cum_fillin_XX==0&time_XX==F_g_XX-1-`=`placebo'')
. //bys group_XX: gegen fillin_g_pl_XX = total(dum_fillin_temp_pl_XX)
. gen fillin_g_pl_XX = (N_g_control_check_pl_XX == `placebo')
156. 
. capture drop dum_fillin_temp_XX
157. capture drop dum_fillin_temp_pl_XX
158. 
. * tag switchers who have no missings from F_g_XX-1-`=`placebo'' to F_g_XX-1+`=`effects''
. gen still_switcher_`i'_XX = (F_g_XX-1+`=`effects''<=T_g_XX & N_g_control_check_XX == `effects')         
159. 
. gen distance_to_switch_`i'_XX=(still_switcher_`i'_XX&time_XX==F_g_XX-1+`i'&`i'<=L_g_XX&S_g_XX==increase_
> XX&N_gt_control_`i'_XX>0&N_gt_control_`i'_XX!=.) if diff_y_`i'_XX!=. 
160. }
161. 
. * If the same_switchers_pl option is not specified:
.         
. if ("`same_switchers_pl'"==""){
162. * Generate a variable tagging the switchers that should be dropped
. * Is the case if at least one of the effects we try to estimate is missing:
. gen relevant_y_missing_XX=(outcome_XX==.&time_XX>=F_g_XX-1&time_XX<=F_g_XX-1+`=`effects'') 
163. * Or if some of the controls are missing:
. if "`controls'" != ""{
164. replace relevant_y_missing_XX=1 if fd_X_all_non_missing_XX==0&time_XX>=F_g_XX&time_XX<=F_g_XX-1+`=`ef
> fects''
165. }
166. 
. // Modif. Diego 31-03-2025: we do not need this block if we use the changes above
. //bys group_XX: gen cum_fillin_XX = sum(relevant_y_missing_XX)
. //gen dum_fillin_temp_XX = (cum_fillin_XX==0&time_XX==F_g_XX-1+`=`effects'')
. //bys group_XX: gegen fillin_g_XX = total(dum_fillin_temp_XX)
. 
. * tag switchers who have no missings from F_g_XX-1 to F_g_XX-1+`=`effects''
. // Modif. Diego 31-03-2025: add check for control groups with the same baseline treat to still_switchers
>  for all estimated periods
. 
. gen still_switcher_`i'_XX = (F_g_XX-1+`=`effects''<=T_g_XX & N_g_control_check_XX == `effects')         
167. gen distance_to_switch_`i'_XX=(still_switcher_`i'_XX&time_XX==F_g_XX-1+`i'&`i'<=L_g_XX&S_g_XX==increa
> se_XX&N_gt_control_`i'_XX>0&N_gt_control_`i'_XX!=.) if diff_y_`i'_XX!=.  
168. 
. }
169. }
170. 
. // If the same_switchers option is not specified
. 
. else{
171. gen distance_to_switch_`i'_XX=(time_XX==F_g_XX-1+`i'&`i'<=L_g_XX&S_g_XX==increase_XX&N_gt_control_`i'
> _XX>0&N_gt_control_`i'_XX!=.) if diff_y_`i'_XX!=. 
172. }
173. 
. ///// Creating a variable counting the number of groups \ell periods away from switch at t
> 
. gen distance_to_switch_`i'_wXX = distance_to_switch_`i'_XX*N_gt_XX
174. bys time_XX: gegen N`=increase_XX'_t_`i'_XX=total(distance_to_switch_`i'_wXX)
175. 
. ///// Computing N1_l,N0_l.
> 
. // Initializing the N1_`i'_XX/N0_`i'_XX scalar at 0. 
. scalar N`=increase_XX'_`i'_XX =0
176. 
. // Loop over t incrementing the scalar
. forvalue t=`=t_min_XX'/`=T_max_XX'{
177.         sum N`=increase_XX'_t_`i'_XX if time_XX==`t'
178.         if !missing(r(mean)) scalar N`=increase_XX'_`i'_XX = N`=increase_XX'_`i'_XX + r(mean)
179. }
180. 
. // Modif Felix weight
. if "`weight'"!=""{
181. 
.         bys time_XX: gegen N`=increase_XX'_t_`i'_XX_w=total(distance_to_switch_`i'_XX)
182.         
.         scalar N`=increase_XX'_`i'_XX_weight =0
183. 
. // Loop over t incrementing the scalar
. forvalue t=`=t_min_XX'/`=T_max_XX'{
184.         sum N`=increase_XX'_t_`i'_XX_w if time_XX==`t'
185.         if !missing(r(mean)) scalar N`=increase_XX'_`i'_XX_weight = N`=increase_XX'_`i'_XX_weight + r
> (mean)
186. }
187. }
188. 
. ///// Creating N^1_{t,\ell,g}/N^0_{t,\ell,g}: 
> ///// Variable counting number of groups \ell periods away from switch at t, 
> ///// and with same D_{g,1} and trends_nonparam.
> 
. bys time_XX d_sq_XX `trends_nonparam': gegen N`=increase_XX'_t_`i'_g_XX=total(distance_to_switch_`i'_wXX
> )
189. 
. ///// Creating all the adjustment terms to compute estimators with controls, and their variances
>  
. if "`controls'" != ""{
190.         
. // Initialize intermediate Variable needed later        
. capture drop part2_switch`=increase_XX'_`i'_XX
191. gen part2_switch`=increase_XX'_`i'_XX=0
192. 
. // generation of the T_d variable = max_{g:D_g,1 = d} F_g - 1: 
. // last period when treatment effects can still be estimated for groups with baseline treatment equal to
>  d
. 
. capture drop T_d_XX
193. gegen T_d_XX = max(F_g_XX), by(d_sq_int_XX)
194. replace T_d_XX = T_d_XX - 1
195. 
. // Computing the long differences of the control variables (X_g_t - X_g_t-l)
. 
. local count_controls=0
196. 
. foreach var of varlist `controls'{
197.                 
. local count_controls=`count_controls'+1
198. 
. capture drop diff_X`count_controls'_`i'_XX
199. 
. xtset group_XX time_XX
200. gen diff_X`count_controls'_`i'_XX=`var' - L`i'.`var'
201. 
. // Computing N_g_t * (X_g_t - X_g_t-l)
. 
. capture drop diff_X`count_controls'_`i'_N_XX
202. gen diff_X`count_controls'_`i'_N_XX = N_gt_XX * diff_X`count_controls'_`i'_XX 
203. 
. foreach l of local levels_d_sq_XX { // index l corresponds to d in the paper 
204. 
. // intermediate variable to count the number of groups within each not yet switched cohort
. 
. // Changes Diego 27-03-25
. //capture drop dummy_XX
. //gen dummy_XX=(F_g_XX>time_XX & d_sq_int_XX == `l')
. 
. // Computing coordinates of vectors m_+_(g,d,l) and m_-_(g,d,l)
. 
. *Creating variable inside the summation across t in m^+_{g,d,\ell}/m^-_{g,d,\ell}
. capture drop m`=increase_XX'_g_`count_controls'_`l'_`i'_XX 
205. gen m`=increase_XX'_g_`count_controls'_`l'_`i'_XX = (`i' <= T_g_XX-2 & d_sq_int_XX == `l')* (G_XX / N
> `=increase_XX'_`i'_XX) * ([distance_to_switch_`i'_XX - (N`=increase_XX'_t_`i'_g_XX/N_gt_control_`i'_XX) 
> * never_change_d_`i'_XX] * (time_XX>=`=`i'+1'&time_XX<=T_g_XX) * diff_X`count_controls'_`i'_N_XX)
206. *Summing that variable across t, and leaving one non missing observation per g  
. capture drop m`=increase_XX'_`l'_`count_controls'_`i'_XX
207. bys group_XX: gegen m`=increase_XX'_`l'_`count_controls'_`i'_XX=total(m`=increase_XX'_g_`count_contro
> ls'_`l'_`i'_XX)
208. bys group_XX: replace m`=increase_XX'_`l'_`count_controls'_`i'_XX = . if _n != 1
209. 
. // Computing coordinates of vectors M^+_{d,\ell} and M^-_{d,\ell}
. 
. capture drop M`=increase_XX'_`l'_`count_controls'_`i'_XX
210. egen M`=increase_XX'_`l'_`count_controls'_`i'_XX = total(m`=increase_XX'_`l'_`count_controls'_`i'_XX)
211. replace M`=increase_XX'_`l'_`count_controls'_`i'_XX = (1/G_XX)*M`=increase_XX'_`l'_`count_controls'_`
> i'_XX
212. 
. // number of groups within each not yet switched cohort
. capture drop E_hat_denom_`count_controls'_`l'_XX
213. //// CHANGE BELOW - tks + Changes Diego 27-03-25: replace dummy_XX_2 with dummy_XX
> 
. // Modif Clément 20/6/2025:
. * Counting number of groups for DOF adjustment
. {
214. cap drop dummy_XX
215. gen dummy_XX = 0
216. replace dummy_XX = (F_g_XX>time_XX & d_sq_int_XX == `l') if diff_y_XX < .
217.         if "`cluster'" == "" {
218.                 bys time_XX : egen E_hat_denom_`count_controls'_`l'_XX = total(dummy_XX) if d_sq_int_
> XX == `l'
219.         }
220.         else {
221.                 cap drop cluster_temp_XX
222.                 gen cluster_temp_XX= `cluster' if dummy_XX == 1
223.                 bys time_XX : gegen E_hat_denom_`count_controls'_`l'_XX = nunique(cluster_temp_XX) if
>  !missing(cluster_temp_XX)
224.         }
225. }
226. // End Modif Clément 20/6/2025
. 
. // Add the indicator for at least two groups in the cohort to E_y_hat_gt_`l'_XX (demeaning is possible)
. capture drop E_y_hat_gt_`l'_XX
227. gen E_y_hat_gt_`l'_XX=E_y_hat_gt_int_`l'_XX*(E_hat_denom_`count_controls'_`l'_XX>=2)
228. 
. 
. // Computing the summation from t=2 to F_g-1 that appears in the last term 
. // of U^{+,var,X}_{g,\ell} and U^{-,var,X}_{g,\ell}, defined in the companion paper.
.  
. capture drop in_sum_temp_`count_controls'_`l'_XX
229. capture drop N_c_`l'_temp_XX
230. capture drop N_c_`l'_XX
231. //// CHANGE BELOW - tks, Changes Diego 27-03-25: Multiply by N_gt_XX
> gen N_c_`l'_temp_XX = N_gt_XX * (d_sq_int_XX == `l' & time_XX >= 2 & time_XX <= T_d_XX & time_XX < F_g_X
> X & diff_y_XX < .)
232. ////
> egen N_c_`l'_XX = total(N_c_`l'_temp_XX)
233. /// Changes Diego 16-06-25: Adjust demeaning when E_hat_denom == 1
> cap drop in_sum_temp_adj_`count_controls'_`l'_XX
234. gen in_sum_temp_adj_`count_controls'_`l'_XX = 0 if E_y_hat_gt_`l'_XX != .
235. replace in_sum_temp_adj_`count_controls'_`l'_XX = (sqrt((E_hat_denom_`count_controls'_`l'_XX)/(E_hat_
> denom_`count_controls'_`l'_XX - 1))-1) if E_y_hat_gt_`l'_XX != . & E_hat_denom_`count_controls'_`l'_XX >
>  1
236. gen in_sum_temp_`count_controls'_`l'_XX = (prod_X`count_controls'_Ngt_XX*(1+(E_hat_denom_`count_contr
> ols'_`l'_XX>=2)*in_sum_temp_adj_`count_controls'_`l'_XX)*(diff_y_XX-E_y_hat_gt_`l'_XX)*(time_XX>=2 & tim
> e_XX<=F_g_XX-1)) / N_c_`l'_XX
237. 
. 
. capture drop in_sum_`count_controls'_`l'_XX
238. capture drop in_sum_temp_adj_`count_controls'_`l'_XX
239. bys group_XX: gegen in_sum_`count_controls'_`l'_XX = total(in_sum_temp_`count_controls'_`l'_XX) 
240. 
. }
241. 
. 
. // Residualize the outcome difference wrt control differences:
. // Yg,t − Yg,t−ℓ − (Xg,t − Xg,t−ℓ)*θ_{Dg,1}
. 
. foreach l of local levels_d_sq_XX { 
242.         if (scalar(useful_res_`l'_XX)>1){
243. replace diff_y_`i'_XX = diff_y_`i'_XX - coefs_sq_`l'_XX[`=`count_controls'',1]*diff_X`count_controls'
> _`i'_XX if d_sq_int_XX==`l' 
244. * N.B. : in the above line, we do not add "&diff_X`count_controls'_`i'_XX!=." because we want to excl
> ude from the estimation any first/long-difference for which the covariates are missing.
. 
. // Initialize intermediate Variable needed later
. capture drop in_brackets_`l'_`count_controls'_XX        
245. gen in_brackets_`l'_`count_controls'_XX=0
246. 
. }
247. }
248. }
249. }
250. 
. ///// Computing the variables used for the demeaning of outcome's long difference diff_y_`i',
> ///// which we will use to create the U_g^{var} variables, which are used to compute 
> ///// the estimators' variances. 
> 
. // Generate long-differences of outcomes time N_{g,t}, and dummy for (g,t) such that
. // diff_y_`i' non missing and N_gt non missing.
. 
. capture drop diff_y_`i'_N_gt_XX
251. gen diff_y_`i'_N_gt_XX=N_gt_XX*diff_y_`i'_XX
252. 
. capture drop dof_ns_`i'_XX
253. gen dof_ns_`i'_XX = (N_gt_XX != 0&diff_y_`i'_XX!=.&never_change_d_`i'_XX==1&N`=increase_XX'_t_`i'_XX>
> 0&N`=increase_XX'_t_`i'_XX!=.)
254. capture drop dof_s_`i'_XX
255. gen dof_s_`i'_XX = (N_gt_XX != 0&distance_to_switch_`i'_XX==1)
256. 
. // For never switchers, demeaning wrt to cohorts defined by D_{g,1}, `trends_nonparam' 
. //(\mathcal{D}_k in companion paper)
. 
. // Modif Clément: we need to add by time
. * Mean's denominator
. bys d_sq_XX `trends_nonparam' time_XX : gegen count_cohort_`i'_ns_t_XX=total(N_gt_XX) if dof_ns_`i'_XX =
> = 1
257. 
. * Mean's numerator
. bys d_sq_XX `trends_nonparam' time_XX: gegen total_cohort_`i'_ns_t_XX=total(diff_y_`i'_N_gt_XX) if dof_n
> s_`i'_XX == 1
258. 
. * Mean 
. gen mean_cohort_`i'_ns_t_XX=total_cohort_`i'_ns_t_XX/count_cohort_`i'_ns_t_XX
259. 
. * Counting number of groups for DOF adjustment
. {
260.         if "`cluster'" == "" {
261.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_`i'_ns_t_XX=total(dof_ns_`i'_
> XX) if dof_ns_`i'_XX == 1
262.         }
263.         else {
264.                 cap drop cluster_dof_`i'_ns_XX
265.                 gen cluster_dof_`i'_ns_XX = `cluster' if dof_ns_`i'_XX == 1
266.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_`i'_ns_t_XX = nunique(cluster
> _dof_`i'_ns_XX) if !missing(cluster_dof_`i'_ns_XX)
267.         }
268. }
269. // End modif Clément
. 
. // For switchers, if option less_conservative_se not specified, demeaning wrt to 
. // cohorts defined by D_{g,1}, F_g, D_{g,F_g}, `trends_nonparam' (\mathcal{C}_k in companion paper).
. 
. if "`less_conservative_se'" == ""{
270.         
. * Mean's denominator
. bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam' : gegen count_cohort_`i'_s_t_XX=total(N_gt_XX) if dof_s_`i'
> _XX==1
271. 
. * Mean's numerator
. bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam' : gegen total_cohort_`i'_s_t_XX=total(diff_y_`i'_N_gt_XX) i
> f dof_s_`i'_XX==1 
272. 
. * Mean 
. gen mean_cohort_`i'_s_t_XX=total_cohort_`i'_s_t_XX/count_cohort_`i'_s_t_XX      
273.                 
. * Counting number of groups for DOF adjustment
. // Changes Diego 16-06-25: adjust DoF with clusters
. {
274.         if "`cluster'" == "" {
275.                 bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam' : gegen dof_cohort_`i'_s_t_XX=total(dof_
> s_`i'_XX) if dof_s_`i'_XX==1
276.         }
277.         else {
278.                 cap drop cluster_dof_`i'_s_XX
279.                 gen cluster_dof_`i'_s_XX = `cluster' if dof_s_`i'_XX == 1
280.                 bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam': gegen dof_cohort_`i'_s_t_XX = nunique(c
> luster_dof_`i'_s_XX) if !missing(cluster_dof_`i'_s_XX)
281.         }
282. }
283. }
284. //save test_data, replace
. 
. 
. // For switchers, if option less_conservative_se specified, demeaning wrt to cohorts 
. // defined by D_{g,1} F_g, D_{g,F_g},..., D_{g,F_g+\ell}, if that cohort has at least two groups,
. // if not: demeaning wrt to cohorts 
. // defined by D_{g,1} F_g, D_{g,F_g}, if that cohort has at least two groups,
. // if not: demeaning wrt D_{g,1} F_g.
. 
. if "`less_conservative_se'" != ""{
285.                 
. * Mean's denominator    
. * by D_{g,1}, F_g, `trends_nonparam':
. bys path_0_XX `trends_nonparam' : gegen count_cohort_`i'_s0_t_XX=total(N_gt_XX) if dof_s_`i'_XX==1
286. * by D_{g,1}, F_g, D_{g,F_g}, `trends_nonparam':
. bys path_1_XX `trends_nonparam' : gegen count_cohort_`i'_s1_t_XX=total(N_gt_XX) if dof_s_`i'_XX==1
287. * by D_{g,1}, F_g, D_{g,F_g},..., D_{g,F_g+\ell}, `trends_nonparam':
. bys path_`i'_XX `trends_nonparam' : gegen count_cohort_`i'_s2_t_XX=total(N_gt_XX) if dof_s_`i'_XX==1
288.         
. * Mean's numerator
. * by D_{g,1}, F_g, `trends_nonparam':
. bys path_0_XX `trends_nonparam' : gegen total_cohort_`i'_s0_t_XX=total(diff_y_`i'_N_gt_XX) if dof_s_`i'_
> XX==1
289. * by D_{g,1}, F_g, D_{g,F_g}, `trends_nonparam':
. bys path_1_XX `trends_nonparam' : gegen total_cohort_`i'_s1_t_XX=total(diff_y_`i'_N_gt_XX) if dof_s_`i'_
> XX==1   
290. * by D_{g,1}, F_g, D_{g,F_g},..., D_{g,F_g+\ell}, `trends_nonparam':
. bys path_`i'_XX `trends_nonparam' : gegen total_cohort_`i'_s2_t_XX=total(diff_y_`i'_N_gt_XX) if dof_s_`i
> '_XX==1
291. 
. * Counting number of groups for DOF adjustment
. // Changes Diego 16-06-25: adjust DoF with clusters
. {
292.         if "`cluster'" == "" {
293.                 * by D_{g,1}, F_g, `trends_nonparam':
.                 bys path_0_XX `trends_nonparam' : gegen dof_cohort_`i'_s0_t_XX=total(dof_s_`i'_XX) if do
> f_s_`i'_XX==1
294.                 * by D_{g,1}, F_g, D_{g,F_g}, `trends_nonparam':
.                 bys path_1_XX `trends_nonparam' : gegen dof_cohort_`i'_s1_t_XX=total(dof_s_`i'_XX) if do
> f_s_`i'_XX==1
295.                 * by D_{g,1}, F_g, D_{g,F_g},..., D_{g,F_g+\ell}, `trends_nonparam':
.                 bys path_`i'_XX `trends_nonparam' : gegen dof_cohort_`i'_s2_t_XX=total(dof_s_`i'_XX) if 
> dof_s_`i'_XX==1
296.         }
297.         else {
298.                 cap drop cluster_dof_`i'_s_XX
299.                 gen cluster_dof_`i'_s_XX = `cluster' if dof_s_`i'_XX == 1
300.                 * by D_{g,1}, F_g, `trends_nonparam':
.                 bys path_0_XX `trends_nonparam' : gegen dof_cohort_`i'_s0_t_XX = nunique(cluster_dof_`i'
> _s_XX) if !missing(cluster_dof_`i'_s_XX)
301.                 * by D_{g,1}, F_g, D_{g,F_g}, `trends_nonparam':
.                 bys path_1_XX `trends_nonparam' : gegen dof_cohort_`i'_s1_t_XX = nunique(cluster_dof_`i'
> _s_XX) if !missing(cluster_dof_`i'_s_XX)
302.                 * by D_{g,1}, F_g, D_{g,F_g},..., D_{g,F_g+\ell}, `trends_nonparam':
.                 bys path_`i'_XX `trends_nonparam' : gegen dof_cohort_`i'_s2_t_XX = nunique(cluster_dof_`
> i'_s_XX) if !missing(cluster_dof_`i'_s_XX)
303. 
.         }
304. }
305. 
. *Attributing the right number of groups depending on which cohort will be used in demeaning:
. gen dof_cohort_`i'_s_t_XX=dof_cohort_`i'_s2_t_XX if dof_cohort_`i'_s2_t_XX>=2
306. replace dof_cohort_`i'_s_t_XX=dof_cohort_`i'_s1_t_XX if dof_cohort_`i'_s2_t_XX<2&dof_cohort_`i'_s1_t_
> XX>=2 
307. replace dof_cohort_`i'_s_t_XX=dof_cohort_`i'_s0_t_XX if dof_cohort_`i'_s2_t_XX<2&dof_cohort_`i'_s1_t_
> XX<2 
308. 
. * Mean
. gen mean_cohort_`i'_s_t_XX=total_cohort_`i'_s2_t_XX/count_cohort_`i'_s2_t_XX if dof_cohort_`i'_s2_t_XX>=
> 2
309. replace mean_cohort_`i'_s_t_XX=total_cohort_`i'_s1_t_XX/count_cohort_`i'_s1_t_XX if dof_cohort_`i'_s2
> _t_XX<2&dof_cohort_`i'_s1_t_XX>=2 
310. replace mean_cohort_`i'_s_t_XX=total_cohort_`i'_s0_t_XX/count_cohort_`i'_s0_t_XX if dof_cohort_`i'_s2
> _t_XX<2&dof_cohort_`i'_s1_t_XX<2
311. 
. }
312. 
. // Modif Clément 30/6/2025:
. // If a switcher is the only one in their cohort or if a not-yet-switcher is the only one in their cohor
> t, we demean wrt union of switchers and not-yet switchers, provided switchers and not-yet-switchers do n
> ot all come from the same cluster.
. 
. cap drop dof_ns_s_`i'_XX
313. cap drop count_cohort_`i'_ns_s_t_XX
314. cap drop total_cohort_`i'_ns_s_t_XX
315. cap drop mean_cohort_`i'_ns_s_t_XX
316. cap drop dof_cohort_`i'_ns_s_t_XX
317. 
. gen dof_ns_s_`i'_XX=(dof_s_`i'_XX==1|dof_ns_`i'_XX ==1)
318. 
. * Mean's denominator
. bys d_sq_XX `trends_nonparam' time_XX : gegen count_cohort_`i'_ns_s_t_XX=total(N_gt_XX) if dof_ns_s_`i'_
> XX==1
319. 
. * Mean's numerator
. bys d_sq_XX `trends_nonparam' time_XX: gegen total_cohort_`i'_ns_s_t_XX=total(diff_y_`i'_N_gt_XX) if dof
> _ns_s_`i'_XX==1
320. 
. * Mean 
. gen mean_cohort_`i'_ns_s_t_XX=total_cohort_`i'_ns_s_t_XX/count_cohort_`i'_ns_s_t_XX
321. 
. * Counting number of groups for DOF adjustment
. {
322.         if "`cluster'" == "" {
323.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_`i'_ns_s_t_XX=total(dof_ns_s_
> `i'_XX) if dof_ns_s_`i'_XX==1
324.         }
325.         else {
326.                 cap drop cluster_dof_`i'_ns_s_XX
327.                 gen cluster_dof_`i'_ns_s_XX = `cluster' if dof_ns_s_`i'_XX==1
328.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_`i'_ns_s_t_XX = nunique(clust
> er_dof_`i'_ns_s_XX) if !missing(cluster_dof_`i'_ns_s_XX)
329.         }
330. }       
331. 
. ///// From those parts, generate variables for the demeaning and the DOF adjustment 
> // E_hat_(g,t), defined from parts depending on the cohort definition
. gen E_hat_gt_`i'_XX=0 if (time_XX<F_g_XX|F_g_XX-1+`i'==time_XX) 
332. replace E_hat_gt_`i'_XX=mean_cohort_`i'_ns_t_XX if (time_XX<F_g_XX&dof_cohort_`i'_ns_t_XX>=2)
333. replace E_hat_gt_`i'_XX=mean_cohort_`i'_s_t_XX if (F_g_XX-1+`i'==time_XX&dof_cohort_`i'_s_t_XX>=2)
334. replace E_hat_gt_`i'_XX=mean_cohort_`i'_ns_s_t_XX if dof_cohort_`i'_ns_s_t_XX>=2&((F_g_XX-1+`i'==time
> _XX&dof_cohort_`i'_s_t_XX==1)|(time_XX<F_g_XX&dof_cohort_`i'_ns_t_XX==1))
335. 
. // DOF_(g,t) for DOF adjustement, defined from parts depending on the cohort definition 
. // Diego - 02-03-25: when there is only 1 switcher, dof_cohort_`i'_s_t_XX = 1, hence the denominator in 
> the expression below is 0
. // The fraction is undefined and Stata puts it to missing
. gen DOF_gt_`i'_XX=1 if (time_XX<F_g_XX|F_g_XX-1+`i'==time_XX)
336. replace DOF_gt_`i'_XX= sqrt(dof_cohort_`i'_s_t_XX/(dof_cohort_`i'_s_t_XX-1)) if (F_g_XX-1+`i'==time_X
> X & dof_cohort_`i'_s_t_XX > 1)
337. replace DOF_gt_`i'_XX=  sqrt(dof_cohort_`i'_ns_t_XX/(dof_cohort_`i'_ns_t_XX-1)) if (time_XX<F_g_XX & 
> dof_cohort_`i'_ns_t_XX > 1)
338. replace DOF_gt_`i'_XX=  sqrt(dof_cohort_`i'_ns_s_t_XX/(dof_cohort_`i'_ns_s_t_XX-1)) if dof_cohort_`i'
> _ns_s_t_XX>=2&((F_g_XX-1+`i'==time_XX&dof_cohort_`i'_s_t_XX==1)|(time_XX<F_g_XX&dof_cohort_`i'_ns_t_XX==
> 1))
339. 
. // End modif Clément 30/6/2025.
. 
. ////////// 3. Computing U_Gg_\ell variables
> 
. ///// If the dynamic effect can be estimated (as there are switchers), we compute the U_Gg_\ell variable
> s etc.
> 
. if (N`=increase_XX'_`i'_XX!=0){
340. 
. // Creating a dummy variable indicating whether l<=T_g_XX-1
. 
. gen dummy_U_Gg`i'_XX = (`i'<=T_g_XX-1) 
341. 
. // Computing U_+_(G,g,l)
. 
. gen U_Gg`i'_temp_XX = dummy_U_Gg`i'_XX*(G_XX / N`=increase_XX'_`i'_XX) * (time_XX>=`=`i'+1'&time_XX<=T_g
> _XX) * N_gt_XX* [distance_to_switch_`i'_XX - (N`=increase_XX'_t_`i'_g_XX/N_gt_control_`i'_XX) * never_ch
> ange_d_`i'_XX] 
342. 
. replace U_Gg`i'_temp_XX = U_Gg`i'_temp_XX* diff_y_`i'_XX 
343. 
. bysort group_XX : gegen U_Gg`i'_XX=total(U_Gg`i'_temp_XX)
344. 
. replace U_Gg`i'_XX = U_Gg`i'_XX*first_obs_by_gp_XX
345. 
. // Counting the number of cells for which we can estimate U_Gg`i'_temp_XX, 
. // to compute the "N" displayed by command
. 
. gen count`i'_core_XX=0
346. replace count`i'_core_XX=N_gt_XX if (U_Gg`i'_temp_XX!=.&U_Gg`i'_temp_XX!=0|(U_Gg`i'_temp_XX==0&diff_y
> _`i'_XX==0&(distance_to_switch_`i'_XX!=0|(N`=increase_XX'_t_`i'_g_XX!=0&never_change_d_`i'_XX!=0))))
347.  
. // Computing U_(+,var)_(G,g,l)
. 
. gen U_Gg`i'_temp_var_XX = 0
348. 
. // Final computation 
. 
. replace U_Gg`i'_temp_var_XX= dummy_U_Gg`i'_XX*(G_XX / N`=increase_XX'_`i'_XX) * [distance_to_switch_`i'_
> XX - (N`=increase_XX'_t_`i'_g_XX/N_gt_control_`i'_XX) * never_change_d_`i'_XX] * (time_XX>=`=`i'+1'&time
> _XX<=T_g_XX) * N_gt_XX * DOF_gt_`i'_XX *(diff_y_`i'_XX-E_hat_gt_`i'_XX)
349. 
. ///// Adding the additional part of U^(+,var,X)_{G,g,l}/U^(-,var,X)_{G,g,l} when controls are included:
> ///// sum across values of baseline treatment d of M^+_(d,l)* a term in brackets in companion paper. 
> 
. if "`controls'"!=""{
350. 
. // Loop over values of d_sq_int_XX:sum across values of baseline treatment  
. levelsof d_sq_int_XX, local(levels_d_sq_XX)
351. 
. foreach l of local levels_d_sq_XX {     
352.         // FELIX: Add this condition here, same for the placebo case!   
.         if (scalar(useful_res_`l'_XX)>1){
353.         
. capture drop combined`=increase_XX'_temp_`l'_`i'_XX     
354. gen combined`=increase_XX'_temp_`l'_`i'_XX=0
355.                 
. // Loop over controls: inner product of M^+_(d,l)* term in brackets in companion paper.
. forvalues j=1/`count_controls'{
356. 
. // Loop over k: computation of term in brackets in companion paper.
. forvalues k=1/`count_controls'{         
357.         
. // Computation of all cross products between elements of jth line of Den^{-1}_d and term multiplying it
. capture drop in_brackets_`l'_`j'_`k'_temp_XX
358. //// CHANGE BELOW - tks + Changes Diego 27-03-25: remove N_c_`l'_XX from formula below, since we have
>  adjusted inv_Denom above
> gen in_brackets_`l'_`j'_`k'_temp_XX = inv_Denom_`l'_XX[`j',`k'] * in_sum_`k'_`l'_XX * (d_sq_int_XX == `l
> ' & F_g_XX>=3) 
359. ////
> 
. // Summing over k, to have jth coordinate of vector Den^{-1}_d*...
. 
. replace in_brackets_`l'_`j'_XX=in_brackets_`l'_`j'_XX+in_brackets_`l'_`j'_`k'_temp_XX
360. } // end loop over k
361. 
. // Withdrawing theta_d
. replace in_brackets_`l'_`j'_XX=in_brackets_`l'_`j'_XX - coefs_sq_`l'_XX[`j',1]
362. 
. // Computation of all cross products between coordinates of M^+_(d,l) and those of term in brackets
. capture drop combined`=increase_XX'_temp_`l'_`j'_`i'_XX
363. gen combined`=increase_XX'_temp_`l'_`j'_`i'_XX=M`=increase_XX'_`l'_`j'_`i'_XX*in_brackets_`l'_`j'_XX
364. 
. // Summing over j
. replace combined`=increase_XX'_temp_`l'_`i'_XX=combined`=increase_XX'_temp_`l'_`i'_XX+combined`=increase
> _XX'_temp_`l'_`j'_`i'_XX
365. } // end loop over j
366. 
. // Final sum over the status quo treatment (outer sum over d in the formula)
. // Modif. Diego: dropped  if d_sq_int_XX==`l'
. replace part2_switch`=increase_XX'_`i'_XX=part2_switch`=increase_XX'_`i'_XX+combined`=increase_XX'_temp_
> `l'_`i'_XX
367. } // Modif FELIX: condition "useful residual" 
368. } // end loop over l
369. 
. }       
370. 
. // Summing the U^(var)_{G,g,l}s over time periods for each group
. bys group_XX: gegen U_Gg`i'_var_XX=total(U_Gg`i'_temp_var_XX)
371. 
. // Modeif Felix 21.03.2025 (adjust order of adding additional term and summing across t)
. if "`controls'" != "" {
372.         // Making the adjustement to U^(+,var)_{G,g,l} when controls are included
.         if `=increase_XX'==1{
373.         replace U_Gg`i'_var_XX=U_Gg`i'_var_XX - part2_switch1_`i'_XX 
374.         }
375. 
.         if `=increase_XX'==0{
376.         //// CHANGE BELOW - tks (switching plus to minus in the sum since the final sign flip won't b
> e until later)
>         replace U_Gg`i'_var_XX=U_Gg`i'_var_XX - part2_switch0_`i'_XX 
377.         }
378. }
379. 
. }
380. 
. ////////// 4. Computing adjustements for the normalized and trends_lin options 
> 
. ///// Compute \delta^D for normalized option
> 
. if "`normalized'"!=""{
381.         
.         capture drop sum_treat_until_`i'_XX
382.         capture drop delta_D_`i'_cum_temp_XX
383.         
.         if `continuous'==0{
384.                 bys group_XX : gegen sum_treat_until_`i'_XX = total(treatment_XX - d_sq_XX) if time_X
> X>=F_g_XX&time_XX<=F_g_XX-1+`i'&S_g_XX==increase_XX
385.         }
386.         // Redefine this with original treatment if continuous is defined (treatment was binarized an
> d staggerized)
.         else if `continuous'>0{
387.                 bys group_XX : gegen sum_treat_until_`i'_XX = total(treatment_XX_orig - d_sq_XX_orig)
>  if time_XX>=F_g_XX&time_XX<=F_g_XX-1+`i'&S_g_XX==increase_XX
388.         }
389. gen delta_D_`i'_cum_temp_XX = N_gt_XX/N`=increase_XX'_`i'_XX*[sum_treat_until_`i'_XX* S_g_XX + (1-S_g
> _XX)*(-sum_treat_until_`i'_XX)] if distance_to_switch_`i'_XX==1 
390. 
.         sum  delta_D_`i'_cum_temp_XX
391.         scalar delta_norm_`i'_XX = r(sum) 
392. 
. }
393. 
. } // End of the loop over l_u_a_XX.
394. // At this point we have all the U_Gg_`i'_XX we need. Thus, we can sum them now for the trends_lin op
> tion.
. 
. ///// trends_lin option
> 
. // As trends_lin relies on summing up the l effects we can only estimate effect l when we can estimate a
> ll prior l-1 effects, we verify if this condition is met.
. 
. scalar Ntrendslin=1
395. forvalue i=1/`=l_u_a_XX' {
396. scalar Ntrendslin=min(Ntrendslin , N`=increase_XX'_`i'_XX )
397. }
398. 
. // Compute the U_Gg_\ell for trends_lin
. 
. if "`trends_lin'"!="" & Ntrendslin != 0  {
399.         
.         capture drop U_Gg`=l_u_a_XX'_TL
400.         capture drop U_Gg`=l_u_a_XX'_var_TL
401.         
.         // Initializing at 0
.         gen U_Gg`=l_u_a_XX'_TL = 0
402.         gen U_Gg`=l_u_a_XX'_var_TL = 0
403. 
.         // summing up the U_Gg's up to the l-th (current) effect
.         forvalue i=1/`=l_u_a_XX'{
404.                 replace U_Gg`=l_u_a_XX'_TL = U_Gg`=l_u_a_XX'_TL + U_Gg`i'_XX            
405.                 replace U_Gg`=l_u_a_XX'_var_TL =  U_Gg`=l_u_a_XX'_var_TL + U_Gg`i'_var_XX 
406.         }
407.         
.         // replacing the U_Gg's with the one adjusted for group specific linear trends
.         replace U_Gg`=l_u_a_XX'_XX = U_Gg`=l_u_a_XX'_TL
408.         replace U_Gg`=l_u_a_XX'_var_XX = U_Gg`=l_u_a_XX'_var_TL
409.                 
. }
410. 
. ////////// 5. Data preparation steps to generate variables necessary for computation of placebo effects 
> 
. if `placebo'!=0{
411.         if `=l_placebo_u_a_XX'>=1{
412.         
. forvalue i=1/`=l_placebo_u_a_XX'{
413. 
. ///// Capture drop of variables created below
> capture drop diff_y_pl_`i'_XX
414. capture drop U_Gg_pl_`i'_temp_XX
415. capture drop U_Gg_placebo_`i'_XX
416. capture drop U_Gg_pl_`i'_temp_var_XX
417. capture drop U_Gg_pl_`i'_var_XX
418. capture drop dist_to_switch_pl_`i'_XX
419. capture drop never_change_d_pl_`i'_XX
420. capture drop N`=increase_XX'_t_placebo_`i'_XX
421. capture drop N`=increase_XX'_t_pl_`i'_XX_w
422. capture drop N`=increase_XX'_t_placebo_`i'_g_XX
423. capture drop N_gt_control_placebo_`i'_XX
424. capture drop dummy_U_Gg_pl_`i'_XX 
425. capture drop never_change_d_pl_`i'_wXX
426. capture drop dist_to_switch_pl_`i'_wXX
427. 
. capture drop dof_cohort_pl_`i'_s_t_XX
428. capture drop dof_cohort_pl_`i'_ns_t_XX
429. capture drop dof_cohort_pl_`i'_s0_t_XX
430. capture drop dof_cohort_pl_`i'_s1_t_XX
431. capture drop dof_cohort_pl_`i'_s2_t_XX
432. capture drop count_cohort_pl_`i'_s_t_XX
433. capture drop count_cohort_pl_`i'_ns_t_XX
434. capture drop count_cohort_pl_`i'_s0_t_XX
435. capture drop count_cohort_pl_`i'_s1_t_XX
436. capture drop count_cohort_pl_`i'_s2_t_XX
437. capture drop total_cohort_pl_`i'_s_t_XX
438. capture drop total_cohort_pl_`i'_ns_t_XX
439. capture drop total_cohort_pl_`i'_s0_t_XX
440. capture drop total_cohort_pl_`i'_s1_t_XX
441. capture drop total_cohort_pl_`i'_s2_t_XX
442. capture drop mean_cohort_pl_`i'_s_t_XX
443. capture drop mean_cohort_pl_`i'_ns_t_XX
444. capture drop mean_cohort_pl_`i'_s0_t_XX
445. capture drop mean_cohort_pl_`i'_s1_t_XX
446. capture drop mean_cohort_pl_`i'_s2_t_XX
447. 
. capture drop E_hat_gt_pl_`i'_XX
448. capture drop DOF_gt_pl_`i'_XX
449. 
. //The steps to compute the placebos are:
. // 1. to place the corresponding outcome (y_{F_g-1} - y_{F_g - l - 1})) values in the same row of that (
> y_{F_g + l -1} - y_{F_g - 1}) of the symmetric DID_l. 
. // 2. The other variables, such as N_gt, N0_l or N1_l, remain unchanged, except that we have to check if
>  diff_y_placebo ( = y_{F_g - 2l -2}- y_{F_g - l -1}) exists. 
. 
. ///// Computing the long differences for the placebos
> xtset group_XX time_XX
450. bys group_XX : gen diff_y_pl_`i'_XX = L`=2*`i''.outcome_XX - L`i'.outcome_XX
451. 
. ///// Identifying the control (g,t)s in the estimation of placebo i 
> bys group_XX: gen never_change_d_pl_`i'_XX=never_change_d_`i'_XX*(diff_y_pl_`i'_XX!=.) 
452. gen never_change_d_pl_`i'_wXX=never_change_d_pl_`i'_XX*N_gt_XX
453. 
. ///// number of control groups for g at t
> bys time_XX d_sq_XX `trends_nonparam': gegen N_gt_control_placebo_`i'_XX=total(never_change_d_pl_`i'_wXX
> ) 
454. 
. ///// Creating binary variable indicating whether g is \ell periods away from switch & (diff_y_pl_`i'_XX
> !=.) is well defined -> based on the already defined distance_to_switch_`i'_XX variable 
> *Modif Clément 26/09/2025:
. *gen dist_to_switch_pl_`i'_XX=distance_to_switch_`i'_XX*(diff_y_pl_`i'_XX!=.)
. gen dist_to_switch_pl_`i'_XX=distance_to_switch_`i'_XX*(diff_y_pl_`i'_XX!=.)*(N_gt_control_placebo_`i'_X
> X>0&N_gt_control_placebo_`i'_XX!=.)
455.  
. if "`same_switchers_pl'"!=""{
456.         replace dist_to_switch_pl_`i'_XX=dist_to_switch_pl_`i'_XX*fillin_g_pl_XX
457. }
458. 
. ///// Creating a variable counting the number of groups \ell periods away from switch at t
> gen dist_to_switch_pl_`i'_wXX= dist_to_switch_pl_`i'_XX*N_gt_XX
459. bys time_XX: gegen N`=increase_XX'_t_placebo_`i'_XX=total(dist_to_switch_pl_`i'_wXX)
460. 
. ///// Computing N^1_\ell/N^0_\ell. for the placebos
> 
. // Initializing the N1_`i'_XX/N0_`i'_XX scalar at 0. 
. scalar N`=increase_XX'_placebo_`i'_XX=0
461. 
. // Loop over t incrementing the scalar
. forvalue t=`=t_min_XX'/`=T_max_XX'{
462.         sum N`=increase_XX'_t_placebo_`i'_XX if time_XX==`t'
463.         if !missing(r(mean)) scalar N`=increase_XX'_placebo_`i'_XX = N`=increase_XX'_placebo_`i'_XX +
>  r(mean) // Modif Diego
464. }
465. 
. // Modif Felix weight
. if "`weight'"!=""{
466. 
.         bys time_XX: gegen N`=increase_XX'_t_pl_`i'_XX_w=total(dist_to_switch_pl_`i'_XX)
467.         
.         scalar N`=increase_XX'_`i'_pl_XX_weight=0
468. 
. // Loop over t incrementing the scalar
. forvalue t=`=t_min_XX'/`=T_max_XX'{
469.         sum N`=increase_XX'_t_pl_`i'_XX_w if time_XX==`t'
470.         if !missing(r(mean)) scalar N`=increase_XX'_`i'_pl_XX_weight = N`=increase_XX'_`i'_pl_XX_weig
> ht + r(mean) // Modif Diego
471. }
472. }
473. 
. ///// Creating N^1_{t,\ell,g}/N^0_{t,\ell,g} for the placebos: 
> ///// Variable counting number of groups \ell periods away from switch at t, 
> ///// and with same D_{g,1} and trends_nonparam.
> 
. bys time_XX d_sq_XX `trends_nonparam': gegen N`=increase_XX'_t_placebo_`i'_g_XX=total(dist_to_switch_pl_
> `i'_wXX)
474. 
. ///// Creating all the adjustment terms to compute estimators with controls, and their variances 
> if "`controls'" != ""{
475. 
. // Initialize intermediate Variable needed later
. capture drop part2_pl_switch`=increase_XX'_`i'_XX
476. gen part2_pl_switch`=increase_XX'_`i'_XX=0
477. 
. local count_controls=0
478. 
. // Computing the long differences of the control variables (X_g_t - X_g_t-l)
. 
. foreach var of varlist `controls'{
479. 
. local count_controls=`count_controls'+1
480. 
. capture drop diff_X_`count_controls'_placebo_`i'_XX
481. 
. xtset group_XX time_XX
482. gen diff_X_`count_controls'_placebo_`i'_XX = L`=2*`i''.`var' - L`i'.`var'
483. 
. // Computing N_g_t * (X_g_t - X_g_t-l)
. 
. capture drop diff_X`count_controls'_pl_`i'_N_XX
484. gen diff_X`count_controls'_pl_`i'_N_XX = N_gt_XX * diff_X_`count_controls'_placebo_`i'_XX 
485. 
. foreach l of local levels_d_sq_XX { // index l corresponds to d in the paper 
486. 
. capture drop m`=increase_XX'_pl_g_`count_controls'_`l'_`i'_XX 
487. gen m`=increase_XX'_pl_g_`count_controls'_`l'_`i'_XX = (`i' <= T_g_XX-2 & d_sq_int_XX == `l')* (G_XX 
> / N`=increase_XX'_placebo_`i'_XX) * ([dist_to_switch_pl_`i'_XX - (N`=increase_XX'_t_placebo_`i'_g_XX/N_g
> t_control_placebo_`i'_XX) * never_change_d_pl_`i'_XX] * (time_XX>=`=`i'+1'&time_XX<=T_g_XX) * diff_X`cou
> nt_controls'_pl_`i'_N_XX)
488. capture drop m_pl`=increase_XX'_`l'_`count_controls'_`i'_XX
489. bys group_XX: gegen m_pl`=increase_XX'_`l'_`count_controls'_`i'_XX=total(m`=increase_XX'_pl_g_`count_
> controls'_`l'_`i'_XX)
490. bys group_XX: replace m_pl`=increase_XX'_`l'_`count_controls'_`i'_XX = . if _n != 1
491. capture drop M_pl`=increase_XX'_`l'_`count_controls'_`i'_XX 
492. egen M_pl`=increase_XX'_`l'_`count_controls'_`i'_XX = total(m_pl`=increase_XX'_`l'_`count_controls'_`
> i'_XX)
493. replace M_pl`=increase_XX'_`l'_`count_controls'_`i'_XX = (1/G_XX)*M_pl`=increase_XX'_`l'_`count_contr
> ols'_`i'_XX
494. }
495. 
. foreach l of local levels_d_sq_XX {
496.         if (scalar(useful_res_`l'_XX)>1){ 
497. replace diff_y_pl_`i'_XX = diff_y_pl_`i'_XX - coefs_sq_`l'_XX[`=`count_controls'',1]*diff_X_`count_co
> ntrols'_placebo_`i'_XX if d_sq_int_XX==`l' 
498. 
. capture drop in_brackets_pl_`l'_`count_controls'_XX     
499. gen in_brackets_pl_`l'_`count_controls'_XX=0
500.                                 
. }               
501. }
502. }
503. }
504. 
. 
. ///// Computing the variables used for the demeaning of outcome's placebo long difference diff_y_`i',
> ///// which we will use to create the U_g^{var} variables, which are used to compute 
> ///// the placebos' variances. 
> 
. // Generate placebo long-differences of outcomes time N_{g,t}, and dummy for (g,t) such that
. // diff_y_`i' non missing and N_gt non missing.
. 
. capture drop diff_y_pl_`i'_N_gt_XX
505. gen diff_y_pl_`i'_N_gt_XX=N_gt_XX*diff_y_pl_`i'_XX
506. capture drop dof_ns_pl_`i'_XX
507. gen dof_ns_pl_`i'_XX = N_gt_XX!=0&diff_y_pl_`i'_XX!=.&never_change_d_pl_`i'_XX==1&N`=increase_XX'_t_p
> lacebo_`i'_XX>0&N`=increase_XX'_t_placebo_`i'_XX!=.
508. capture drop dof_s_pl_`i'_XX
509. gen dof_s_pl_`i'_XX = N_gt_XX!=0&dist_to_switch_pl_`i'_XX==1
510. 
. // For never switchers, demeaning wrt to cohorts defined by D_{g,1}, `trends_nonparam' 
. //(\mathcal{D}_k in companion paper)
. 
. // Modif Clément: we need to add by time
. * Mean's denominator
. bys d_sq_XX `trends_nonparam' time_XX : gegen count_cohort_pl_`i'_ns_t_XX=total(N_gt_XX) if dof_ns_pl_`i
> '_XX == 1
511. 
. * Mean's numerator
. bys d_sq_XX `trends_nonparam' time_XX : gegen total_cohort_pl_`i'_ns_t_XX=total(diff_y_pl_`i'_N_gt_XX) i
> f dof_ns_pl_`i'_XX == 1
512. 
. * Mean 
. gen mean_cohort_pl_`i'_ns_t_XX=total_cohort_pl_`i'_ns_t_XX/count_cohort_pl_`i'_ns_t_XX
513. 
. * Counting number of groups for DOF adjustment
. {
514.         if "`cluster'" == "" {
515.                 bys d_sq_XX `trends_nonparam' time_XX : gegen dof_cohort_pl_`i'_ns_t_XX=total(dof_ns_
> pl_`i'_XX) if dof_ns_pl_`i'_XX == 1
516.         }
517.         else {
518.                 cap drop cluster_dof_pl_`i'_ns_XX
519.                 gen cluster_dof_pl_`i'_ns_XX = `cluster' if dof_ns_pl_`i'_XX == 1
520.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_pl_`i'_ns_t_XX = nunique(clus
> ter_dof_pl_`i'_ns_XX) if !missing(cluster_dof_pl_`i'_ns_XX)
521.         }
522. }
523. // End modif Clément
. 
. // For switchers, for placebos we no longer need to distinguish depending on whether the option
. // less_conservative_se specified or not, we always demean wrt to 
. // cohorts defined by D_{g,1}, F_g, D_{g,F_g}, `trends_nonparam' (\mathcal{C}_k in companion paper).
. 
. * Mean's denominator
. bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam' : gegen count_cohort_pl_`i'_s_t_XX=total(N_gt_XX) if dof_s_
> pl_`i'_XX==1
524. 
. * Mean's numerator
. bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam' : gegen total_cohort_pl_`i'_s_t_XX=total(diff_y_pl_`i'_N_gt
> _XX) if dof_s_pl_`i'_XX==1 
525. 
. * Mean 
. gen mean_cohort_pl_`i'_s_t_XX=total_cohort_pl_`i'_s_t_XX/count_cohort_pl_`i'_s_t_XX     
526.                 
. * Counting number of groups for DOF adjustment
. {
527.         if "`cluster'" == "" {
528.                 bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam' : gegen dof_cohort_pl_`i'_s_t_XX=total(d
> of_s_pl_`i'_XX) if dof_s_pl_`i'_XX==1
529.         }
530.         else {
531.                 cap drop cluster_dof_pl_`i'_s_XX
532.                 gen cluster_dof_pl_`i'_s_XX = `cluster' if dof_s_pl_`i'_XX == 1
533.                 bys d_sq_XX F_g_XX d_fg_XX `trends_nonparam': gegen dof_cohort_pl_`i'_s_t_XX = nuniqu
> e(cluster_dof_pl_`i'_s_XX) if !missing(cluster_dof_pl_`i'_s_XX)
534.         }
535. }
536. 
. // Modif Clément 19/6/2025:
. // If a switcher is the only one in their cohort or if a not-yet-switcher is the only one in their cohor
> t, we demean wrt union of switchers and not-yet switchers.
. 
. cap drop dof_ns_s_pl_`i'_XX
537. cap drop count_cohort_pl_`i'_ns_s_t_XX
538. cap drop total_cohort_pl_`i'_ns_s_t_XX
539. cap drop mean_cohort_pl_`i'_ns_s_t_XX
540. cap drop dof_cohort_pl_`i'_ns_s_t_XX
541. 
. gen dof_ns_s_pl_`i'_XX=(dof_s_pl_`i'_XX==1|dof_ns_pl_`i'_XX ==1)
542. 
. * Mean's denominator
. bys d_sq_XX `trends_nonparam' time_XX : gegen count_cohort_pl_`i'_ns_s_t_XX=total(N_gt_XX) if dof_ns_s_p
> l_`i'_XX==1
