. ********************************************************************************
. *               HELPER PROGRAMS (defined once, used many times)                *
. ********************************************************************************
. 
. * ---------------------------------------------------------------
. * capture_dyn_results
. *   Reads e() from the last did_multiplegt_dyn call and appends a
. *   labelled block of rows (estimates, variances, sample sizes,
. *   joint-test p-values, optional equality test) to `store'.
. *
. * Options:
. *   name(string)        label for this specification (row header)
. *   store(string)       matrix to append to (must already exist)
. *   n_eff(integer 0)    number of effects requested
. *   n_pl(integer 0)     number of placebos requested
. *   equality            also capture e(p_equality_effects)
. * ---------------------------------------------------------------
. capture program drop capture_dyn_results

. program capture_dyn_results
  1.         syntax, NAme(string) STore(string) [n_eff(integer 0) n_pl(integer 0) EQuality]
  2. 
.         tempname lbl xx
  3. 
.         * Label row (single missing value carrying the row name)
.         matrix `lbl' = .
  4.         matrix rownames `lbl' = "`name'"
  5.         matrix `store' = `store' \ `lbl'
  6. 
.         * Point estimates and variances for effects + ATE + placebos
.         local total = `n_eff' + `n_pl' + 1
  7.         matrix `store' = `store' \ e(estimates)[1..`total', 1]
  8.         matrix `store' = `store' \ e(variances)[1..`total', 1]
  9. 
.         * Per-effect sample sizes
.         forvalues j = 1/`n_eff' {
 10.                 matrix `xx' = e(N_effect_`j')
 11.                 matrix rownames `xx' = "N_effect_`j'"
 12.                 matrix `store' = `store' \ `xx'
 13. 
.                 matrix `xx' = e(N_switchers_effect_`j')
 14.                 matrix rownames `xx' = "N_switchers_effect_`j'"
 15.                 matrix `store' = `store' \ `xx'
 16.         }
 17. 
.         * Average total effect sample sizes
.         matrix `xx' = e(N_avg_total_effect)
 18.         matrix rownames `xx' = "N_avg_total_effect"
 19.         matrix `store' = `store' \ `xx'
 20. 
.         matrix `xx' = e(N_switchers_effect_average)
 21.         matrix rownames `xx' = "N_switchers_effect_average"
 22.         matrix `store' = `store' \ `xx'
 23. 
.         * Per-placebo sample sizes (only when placebos were requested)
.         if `n_pl' > 0 {
 24.                 forvalues j = 1/`n_pl' {
 25.                         matrix `xx' = e(N_placebo_`j')
 26.                         matrix rownames `xx' = "N_placebo_`j'"
 27.                         matrix `store' = `store' \ `xx'
 28. 
.                         matrix `xx' = e(N_switchers_placebo_`j')
 29.                         matrix rownames `xx' = "N_switchers_placebo_`j'"
 30.                         matrix `store' = `store' \ `xx'
 31.                 }
 32.         }
 33. 
.         * Joint-test p-values
.         matrix `xx' = e(p_jointeffects)
 34.         matrix rownames `xx' = "p_jointeffects"
 35.         matrix `store' = `store' \ `xx'
 36. 
.         if `n_pl' > 0 {
 37.                 matrix `xx' = e(p_jointplacebo)
 38.                 matrix rownames `xx' = "p_jointplacebo"
 39.                 matrix `store' = `store' \ `xx'
 40.         }
 41. 
.         * Optional: effects-equal test
.         if "`equality'" != "" {
 42.                 matrix `xx' = e(p_equality_effects)
 43.                 matrix rownames `xx' = "p_equality_effects"
 44.                 matrix `store' = `store' \ `xx'
 45.         }
 46. end

. 
