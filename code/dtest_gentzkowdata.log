1243. matrix didmgt_results_no_avg2_XX=mat_res_XX[`=l_XX'+2 .. `=l_XX'+`=l_placebo_XX'+1,1]
1244. matrix didmgt_results_no_avg_XX = didmgt_results_no_avg1_XX \ didmgt_results_no_avg2_XX
1245. }
1246. 
. matrix didmgt_results_no_avg_XX=didmgt_results_no_avg_XX'
1247. 
