1451.                         scalar all_delta_pl_not_zero=all_delta_pl_not_zero+1
1452.                 }
1453.                 }
1454.                 }
1455.                 
.                 scalar all_Ns_not_zero=0
1456.         
.                 forvalue i=1/`=l_XX'{
1457.                 if ("`switchers'"==""&(N1_`i'_XX_new!=0|N0_`i'_XX_new!=0))|("`switchers'"=="out"&N0_
> `i'_XX_new!=0)|("`switchers'"=="in"&N1_`i'_XX_new!=0){
1458.                         scalar all_Ns_not_zero=all_Ns_not_zero+1
1459.                         }
1460.         }
1461.                 
. if ((all_Ns_pl_not_zero==l_placebo_XX & "`normalized'"=="")|(all_Ns_pl_not_zero==l_placebo_XX & "`normal
> ized'"!="" & all_delta_pl_not_zero==l_placebo_XX))&all_Ns_not_zero==l_XX{               
1462. 
. // Creating a matrix where the variances and the covariances will be stored.
. matrix didmgt_Var_all_XX=J(`=l_XX'+`=l_placebo_XX',`=l_XX'+`=l_placebo_XX',0)
1463. 
. local total_num_estimates_XX=`=l_XX'+`=l_placebo_XX'
