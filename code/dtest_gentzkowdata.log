1549.                         matrix didmgt_Var_Placebo[`j',`i']= scalar(cov_pl_`i'_`j'_XX)
1550. 
.                 }
1551.         }
1552.         
.         }
1553.         
.         *** Modif Felix: replace matrix with bootstrap
.         if `bootstrap_XX'!=0{
1554.                 matrix didmgt_Var_Placebo=bs_var_cov_XX["_bs_`=l_XX+1'".."_bs_`=l_XX+l_placebo_XX'",
> "_bs_`=l_XX+1'".."_bs_`=l_XX+l_placebo_XX'"]
1555.         }       
1556.         
.         // Compute P-value for the F-test on joint nullity of all placebos
.         matrix didmgt_Var_Placebo_inv=invsym(didmgt_Var_Placebo)
1557.         matrix didmgt_Placebo_t=didmgt_Placebo'
1558.         matrix didmgt_chi2placebo=didmgt_Placebo_t*didmgt_Var_Placebo_inv*didmgt_Placebo
