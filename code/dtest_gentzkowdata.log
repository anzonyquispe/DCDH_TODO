2642. use "`before_graph_XX'.dta", clear              
2643.         
. capture drop mat_res_XX_by_`l'1 mat_res_XX_by_`l'2 mat_res_XX_by_`l'3 mat_res_XX_by_`l'4 mat_res_XX_by_`
> l'5 mat_res_XX_by_`l'6 mat_res_XX_by_`l'7
2644. svmat mat_res_XX_by_`l'
2645. 
. // artificially replacing the result of average effect by 0
. forvalue index=1/6{
2646. replace mat_res_XX_by_`l'`index'=0 if mat_res_XX_by_`l'7==0
2647. }
2648. 
. capture drop point_estimate_`l'
2649. capture drop se_point_estimate_`l'
2650. capture drop lb_CI_95_`l'
2651. capture drop up_CI_95_`l'
2652. capture drop N_`l'
2653. capture drop N_switchers_`l'
2654. capture drop time_to_treat
2655. 
. rename mat_res_XX_by_`l'1 point_estimate_`l'
2656. rename mat_res_XX_by_`l'2 se_point_estimate_`l'
2657. rename mat_res_XX_by_`l'3 lb_CI_95_`l'
2658. rename mat_res_XX_by_`l'4 up_CI_95_`l'
2659. rename mat_res_XX_by_`l'5 N_`l'
2660. rename mat_res_XX_by_`l'6 N_switchers_`l'
2661. rename mat_res_XX_by_`l'7 time_to_treat
2662. 
. 
. // pick CI color matching the line color
. local col_CI=`cnt_XX'+1
2663. 
. // Create a local that adjusts the graph automatically for ll the by levels
. local graph_input "`graph_input' (connected point_estimate_`l' time_to_treat, lpattern(solid) lcolor(`co
> l`cnt_XX'') mcolor(`col`cnt_XX'')) (rcap up_CI_95_`l' lb_CI_95_`l' time_to_treat, lcolor(`col`col_CI''))
> " 
2664. 
. // Store value labels for the legend if they exist, show the level otherwise
. ds `by', has(vallabel)
2665. local `by'_has_vallabel_XX=r(varlist)
2666. if "``by'_has_vallabel_XX'"!="."{
2667.         local val_lab_int_XX "`: label ``by'_lab_XX' `l''"
2668. } 
2669. if "``by'_has_vallabel_XX'"=="."{
2670.         local val_lab_int_XX "`l'"
2671. }
2672. 
. // Automatcially adjust the legend for each additional graph from the by option
. local graph_options_int "`graph_options_int' `cnt_XX' "`by' = `val_lab_int_XX'""
2673. 
. // +2 to skip the CI's to get the correct color for the next event study graph
. local cnt_XX=`cnt_XX'+2
2674. 
. // Save the specific dataset needed for the graphs
. keep point_estimate_`l' se_point_estimate_`l' lb_CI_95_`l' up_CI_95_`l' N_`l' N_switchers_`l' time_to_tr
> eat
2675. tempfile graph_`l'_XX
2676. keep if time_to_treat!=. 
2677. *to allow time_to_treat as id of the dataset and use merge 1:1
. save "`graph_`l'_XX'.dta", replace      
2678. 
. // Merge the different datasts if there is more then one event study graph to be shown
. if `merge_count'==1{
2679.         use "`graph_`l'_XX'.dta", clear
