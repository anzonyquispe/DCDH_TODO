2214. capture ereturn scalar N_placebo_`i' = N_placebo_`i'_XX
2215. capture ereturn scalar N_switchers_placebo_`i' = N_switchers_placebo_`i'_XX
2216. capture ereturn scalar se_placebo_`i'=scalar(se_placebo_`i'_XX)
