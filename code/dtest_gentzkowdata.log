1177. 
. if "`normalized'"!=""{
1178.         scalar delta_D_pl_`i'_global_XX = (N1_placebo_`i'_XX_new/(N1_placebo_`i'_XX_new+N0_placebo_`
> i'_XX_new))*delta_D_pl_`i'_in_XX+(N0_placebo_`i'_XX_new/(N1_placebo_`i'_XX_new+N0_placebo_`i'_XX_new))*d
> elta_D_pl_`i'_out_XX
1179. }
1180. 
. gegen DID_placebo_`i'_XX = total(U_Gg_pl_`i'_global_XX) 
