2686.         merge 1:1 time_to_treat using "`graph_`l'_XX'.dta"
2687.         capture drop _merge
2688.         tempfile graph_merge_XX
2689.         save "`graph_merge_XX'.dta", replace
2690. }       
2691. local merge_count=`merge_count'+1
2692. } // end of the differentlevels_byvar_XX loop
2693. 
. // Add universal graph options
. local graph_options "legend(pos(6) order(`graph_options_int') rows(1))"
2694. }       
2695. 
. }
2696. 
. // Event Study graph without any additional graph options
. if ("`graph_off'"==""){
2697. if "`graphoptions'"==""{
2698. twoway `graph_input', xlabel(`=-l_placebo_XX'[1]`=l_XX') xtitle("Relative time to last period before
>  treatment changes (t=0)", size(large)) title("DID, from last period before treatment changes (t=0) to t
> ", size(large)) graphregion(color(white)) plotregion(color(white)) `graph_options'
2699. }
2700. // Event Study graph with additional graph options
. else{
2701. global options="`graphoptions'"
2702. twoway `graph_input', $options
2703. }
2704. } // end graph_off
2705. 
. 
. ///// Saving the results if requested
> if "`save_results'"!=""{
2706. quietly{
2707. keep if time_to_treat!=.
2708. }
2709. 
. // keep main results
. if "`by'"==""{
2710. keep time_to_treat point_estimate se_point_estimate lb_CI_95 up_CI_95 N N_switchers
2711. }
2712. else if "`by'"!=""{
2713. keep time_to_treat point_estimate* se_point_estimate* lb_CI_95* up_CI_95* N* N_switchers*
2714. }
2715. 
. // Store information about the dataset
. label data "Stores did_multiplegt_dyn estimates' information: Type 'notes' for details." 
2716. local command_options_XX effects(`effects') placebo(`placebo') switchers(`switchers') `only_never_sw
> itchers' controls(`controls') trends_nonparam(`trends_nonparam') weight(`weight') `dont_drop_larger_lowe
> r' `normalized' cluster(`cluster') `same_switchers' `trends_lin' by(`by') predict_het(`predict_het') ci_
> level(`ci_level') design(`design') date_first_switch(`date_first_switch') continuous(`continuous') `less
> _conservative_se' `normalized_weights'
2717. notes : "{bf:{ul:Date of Run:}} `c(current_date)' at `c(current_time)'"
2718. notes : "{bf:{ul:Command Syntax:}} did_multiplegt `1' `2' `3' `4' `if' `in', `command_options_XX' "
2719. notes : "{bf:{ul:Path of the Used Dataset:}} `dataset_name_XX' "
2720. save "`save_results'", replace
2721. 
. }
2722. 
. display _newline
