1029.                 }
1030.         }
1031.         
. }
1032. 
. 
. if l_placebo_XX!=0{
1033. 
.         forvalue i=1/`=l_placebo_XX'{
1034.                 
. if "`trends_lin'"!=""{  
1035.         did_multiplegt_dyn_core_new outcome_XX group_XX time_XX treatment_XX, effects(`i') placebo(`
> i') switchers_core(out) `only_never_switchers' controls(`controls') trends_nonparam(`trends_nonparam') `
> normalized' same_switchers same_switchers_pl trends_lin continuous(`continuous') `less_conservative_se' 
> weight(weight_XX) cluster(`cluster')
1036. }
1037.                 
.         if N0_placebo_`i'_XX!=0{
1038.                         replace U_Gg_pl_`i'_minus_XX  = -U_Gg_placebo_`i'_XX
1039.                         replace count`i'_pl_minus_XX= count`i'_pl_core_XX
1040.                         //// CHANGE BELOW - tks (add minus sign)
>                         replace U_Gg_var_pl_`i'_out_XX= - U_Gg_pl_`i'_var_XX 
1041.                         scalar N0_placebo_`i'_XX_new=N0_placebo_`i'_XX
1042.                         
.                         if "`normalized'"!=""{
1043.                                         scalar delta_D_pl_`i'_out_XX = delta_norm_pl_`i'_XX
1044.         }
1045. 
.         }
1046.         }               
1047. }
1048. 
.         if "`trends_lin'"==""{
1049.         if sum_N0_l_XX!=0{
1050.         replace U_Gg_minus_XX = - U_Gg_XX
1051.         scalar U_Gg_den_minus_XX=U_Gg_den_XX
1052.         replace U_Gg_var_minus_XX = - U_Gg_var_XX
1053.         }
1054.         }
1055. 
. }
1056.         
. } // end of the loop for switchers out 
1057. 
. scalar drop L_u_XX_tag L_a_XX_tag
1058. 
. ////////// 5. Computing the estimators and their variances
> 
. /////  Computing DID_\ell
> 
. // Creation of the matrix which stores all the estimators (DID_l, DID_pl, delta, etc.), their sd and the
>  CIs
