. * ---------------------------------------------------------------
. * run_dyn_test_battery
. *   Runs the standardized battery of did_multiplegt_dyn calls and
. *   pipes each call's results through capture_dyn_results into
. *   the matrix passed via store(). Same battery is used for the
. *   new version and the SSC version so the two are comparable.
. * ---------------------------------------------------------------
. capture program drop run_dyn_test_battery

. program run_dyn_test_battery
  1.         syntax varlist(min=4 max=4 numeric), STore(string) ///
>                 N_eff(integer) N_pl(integer) ///
>                 Cont(string) Nonparam(string) Wght(string) Clust(string) ///
>                 B_reps(integer) B_seed(integer) Eff_eq(string)
  2. 
.         tokenize `varlist'
  3.         local y `1'
  4.         local g `2'
  5.         local t `3'
  6.         local d `4'
  7. 
.         * Initialize storage matrix
.         cap matrix drop `store'
  8.         matrix `store' = J(1, 1, .)
  9.         matrix rownames `store' = "INIT"
 10. 
.         di as result _newline "--- Spec: Baseline ---"
 11.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff')
 12.         capture_dyn_results, name("Baseline") n_eff(`n_eff') store(`store')
 13. 
.         di as result _newline "--- Spec: Placebos ---"
 14.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl')
 15.         capture_dyn_results, name("Placebos") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 16. 
.         di as result _newline "--- Spec: Normalized ---"
 17.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') normalized
 18.         capture_dyn_results, name("Normalized") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 19. 
.         di as result _newline "--- Spec: Controls ---"
 20.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') controls(`cont
> ')
 21.         capture_dyn_results, name("Controls") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 22. 
.         di as result _newline "--- Spec: Trends_Nonparam ---"
 23.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') trends_nonpara
> m(`nonparam')
 24.         capture_dyn_results, name("Trends_Nonparam") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 25. 
.         di as result _newline "--- Spec: Trends_Lin ---"
 26.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') trends_lin
 27.         capture_dyn_results, name("Trends_Lin") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 28. 
.         di as result _newline "--- Spec: Continuous ---"
 29.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') continuous(1)
 30.         capture_dyn_results, name("Continuous") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 31. 
.         di as result _newline "--- Spec: Weight ---"
 32.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') weight(`wght')
 33.         capture_dyn_results, name("Weight") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 34. 
.         di as result _newline "--- Spec: Cluster ---"
 35.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') cluster(`clust
> ')
 36.         capture_dyn_results, name("Cluster") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 37. 
.         di as result _newline "--- Spec: Same_Switchers ---"
 38.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') same_switchers
 39.         capture_dyn_results, name("Same_Switchers") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 40. 
.         di as result _newline "--- Spec: Same_Switchers_Placebo ---"
 41.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') same_switchers
>  same_switchers_pl
 42.         capture_dyn_results, name("Same_Switchers_Placebo") n_eff(`n_eff') n_pl(`n_pl') store(`store'
> )
 43. 
.         di as result _newline "--- Spec: Switchers_In ---"
 44.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') switchers(in)
 45.         capture_dyn_results, name("Switchers_In") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 46. 
.         di as result _newline "--- Spec: Switchers_Out ---"
 47.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') switchers(out)
 48.         capture_dyn_results, name("Switchers_Out") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 49. 
.         di as result _newline "--- Spec: Only_Never_Switchers ---"
 50.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') only_never_swi
> tchers
 51.         capture_dyn_results, name("Only_Never_Switchers") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 52. 
.         di as result _newline "--- Spec: CI_Level_90 ---"
 53.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') ci_level(90)
 54.         capture_dyn_results, name("CI_Level_90") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 55. 
.         di as result _newline "--- Spec: CI_Level_99 ---"
 56.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') ci_level(99)
 57.         capture_dyn_results, name("CI_Level_99") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 58. 
.         di as result _newline "--- Spec: Less_Conservative_SE ---"
 59.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') less_conservat
> ive_se
 60.         capture_dyn_results, name("Less_Conservative_SE") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 61. 
.         di as result _newline "--- Spec: Bootstrap ---"
 62.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') bootstrap(`b_r
> eps',`b_seed')
 63.         capture_dyn_results, name("Bootstrap") n_eff(`n_eff') n_pl(`n_pl') store(`store')
 64. 
.         di as result _newline "--- Spec: Dont_Drop_Larger_Lower ---"
 65.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') dont_drop_larg
> er_lower
 66.         capture_dyn_results, name("Dont_Drop_Larger_Lower") n_eff(`n_eff') n_pl(`n_pl') store(`store'
> )
 67. 
.         di as result _newline "--- Spec: Effects_Equal ---"
 68.         did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') effects_equal(
> `eff_eq')
 69.         capture_dyn_results, name("Effects_Equal") n_eff(`n_eff') n_pl(`n_pl') store(`store') equalit
> y
 70.         
.         if "`newver'" == "Yes"{
 71.                 di as result _newline "--- Spec: Reset ---"
 72.                 did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') reset(
> `reset')
 73.                 capture_dyn_results, name("reset") n_eff(`n_eff') n_pl(`n_pl') store(`store') equalit
> y
 74.         }
 75.         
. end

