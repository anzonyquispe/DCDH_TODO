. ////////// 9. Event study graph
> 
. ///// Producing a graph
> qui {
2597. 
. // Initialize color pattern for multiple graphs wihen by is specified 
. local col1 "midblue"
2598. local col2 "midblue" 
2599. local col3 "red"  
2600. local col4 "red" 
2601. local col5 "green" 
2602. local col6 "green"    
2603. local col7 "magenta" 
2604. local col8 "magenta"   
2605. local col9 "gold"   
2606. local col10 "gold"    
2607. local col11 "lime" 
2608. local col12 "lime"      
2609. 
. local graph_input ""
2610. local graph_options ""
2611. local graph_options_int ""
