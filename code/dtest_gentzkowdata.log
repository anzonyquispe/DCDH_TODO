2213. capture ereturn scalar Placebo_`i' = scalar(DID_placebo_`i'_XX)
2214. capture ereturn scalar N_placebo_`i' = N_placebo_`i'_XX
2215. capture ereturn scalar N_switchers_placebo_`i' = N_switchers_placebo_`i'_XX
2216. capture ereturn scalar se_placebo_`i'=scalar(se_placebo_`i'_XX)
2217. }
2218. if (l_placebo_XX>1&all_Ns_pl_not_zero==l_placebo_XX&all_delta_pl_not_zero==l_placebo_XX&"`normalized
> '"!="")|(l_placebo_XX>1&all_Ns_pl_not_zero==l_placebo_XX&"`normalized'"==""){
2219. capture ereturn scalar p_jointplacebo=scalar(p_jointplacebo)
2220. }
2221. }
