545. 
. * Counting number of groups for DOF adjustment
. {
546.         if "`cluster'" == "" {
547.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_pl_`i'_ns_s_t_XX=total(dof_ns
> _s_pl_`i'_XX) if dof_ns_s_pl_`i'_XX==1
548.         }
549.         else {
550.                 cap drop cluster_dof_pl_`i'_ns_s_XX
551.                 gen cluster_dof_pl_`i'_ns_s_XX = `cluster' if dof_ns_s_pl_`i'_XX==1
552.                 bys d_sq_XX `trends_nonparam' time_XX: gegen dof_cohort_pl_`i'_ns_s_t_XX = nunique(cl
> uster_dof_pl_`i'_ns_s_XX) if !missing(cluster_dof_pl_`i'_ns_s_XX)
553.         }
554. }       
555. 
. ///// From those parts, generate variables for the demeaning and the DOF adjustment 
> // E_hat_(g,t), defined from parts depending on the cohort definition 
. gen E_hat_gt_pl_`i'_XX=0 if (time_XX<F_g_XX|F_g_XX-1+`i'==time_XX)
556. replace E_hat_gt_pl_`i'_XX=mean_cohort_pl_`i'_ns_t_XX if (dof_cohort_pl_`i'_ns_t_XX>=2&time_XX<F_g_XX
> )
557. replace E_hat_gt_pl_`i'_XX=mean_cohort_pl_`i'_s_t_XX if (dof_cohort_pl_`i'_s_t_XX>=2&F_g_XX-1+`i'==ti
> me_XX)
558. replace E_hat_gt_pl_`i'_XX=mean_cohort_pl_`i'_ns_s_t_XX if dof_cohort_pl_`i'_ns_s_t_XX>=2&(F_g_XX-1+`
> i'==time_XX&dof_cohort_pl_`i'_s_t_XX==1)|(time_XX<F_g_XX&dof_cohort_pl_`i'_ns_t_XX==1)
559. 
. // DOF_(g,t) for DOF adjustement, defined from parts depending on the cohort definition 
. // Diego - 02-03-25: when there is only 1 switcher, dof_cohort_`i'_s_t_XX = 1, hence the denominator in 
> the expression below is 0
. // The fraction is undefined and Stata puts it to missing
. gen DOF_gt_pl_`i'_XX=1 if (time_XX<F_g_XX|F_g_XX-1+`i'==time_XX)
560. replace DOF_gt_pl_`i'_XX=  sqrt(dof_cohort_pl_`i'_s_t_XX/(dof_cohort_pl_`i'_s_t_XX-1)) if (F_g_XX-1+`
> i'==time_XX & dof_cohort_pl_`i'_s_t_XX > 1)
561. replace DOF_gt_pl_`i'_XX=  sqrt(dof_cohort_pl_`i'_ns_t_XX/(dof_cohort_pl_`i'_ns_t_XX-1)) if (time_XX<
> F_g_XX & dof_cohort_pl_`i'_ns_t_XX > 1)
562. replace DOF_gt_pl_`i'_XX=  sqrt(dof_cohort_pl_`i'_ns_s_t_XX/(dof_cohort_pl_`i'_ns_s_t_XX-1)) if dof_c
> ohort_pl_`i'_ns_s_t_XX>=2&(F_g_XX-1+`i'==time_XX&dof_cohort_pl_`i'_s_t_XX==1)|(time_XX<F_g_XX&dof_cohort
> _pl_`i'_ns_t_XX==1)
563. 
. // End modif Clément 19/6/2025.
. 
. ////////// 6. Computing U_Gg_\ell variables for the placebos (similar to part 4, less commented)
> 
. gen dummy_U_Gg_pl_`i'_XX = (`i'<=T_g_XX-1)
564. 
. if (N`=increase_XX'_placebo_`i'_XX!=0){
565. 
. gen U_Gg_pl_`i'_temp_XX = dummy_U_Gg_pl_`i'_XX*(G_XX / N`=increase_XX'_placebo_`i'_XX) * (time_XX>=`=`i'
> +1'&time_XX<=T_g_XX)* N_gt_XX * [dist_to_switch_pl_`i'_XX - (N`=increase_XX'_t_placebo_`i'_g_XX/N_gt_con
> trol_placebo_`i'_XX) * never_change_d_pl_`i'_XX] *diff_y_pl_`i'_XX 
566. 
. bysort group_XX : gegen U_Gg_placebo_`i'_XX=total(U_Gg_pl_`i'_temp_XX)
567. 
. replace U_Gg_placebo_`i'_XX= U_Gg_placebo_`i'_XX*first_obs_by_gp_XX
568. 
. capture drop count`i'_pl_core_XX
569. gen count`i'_pl_core_XX=0
570. replace count`i'_pl_core_XX= N_gt_XX if (U_Gg_pl_`i'_temp_XX!=.&U_Gg_pl_`i'_temp_XX!=0|(U_Gg_pl_`i'_t
> emp_XX==0&diff_y_pl_`i'_XX==0&(dist_to_switch_pl_`i'_XX!=0|(N`=increase_XX'_t_placebo_`i'_g_XX!=0&never_
> change_d_pl_`i'_XX!=0))))
571. 
. gen U_Gg_pl_`i'_temp_var_XX =0
572. 
. replace U_Gg_pl_`i'_temp_var_XX= dummy_U_Gg_pl_`i'_XX*(G_XX / N`=increase_XX'_placebo_`i'_XX) * [dist_to
> _switch_pl_`i'_XX - (N`=increase_XX'_t_placebo_`i'_g_XX/N_gt_control_placebo_`i'_XX) * never_change_d_pl
> _`i'_XX] * (time_XX>=`=`i'+1'&time_XX<=T_g_XX) * N_gt_XX * DOF_gt_pl_`i'_XX *(diff_y_pl_`i'_XX-E_hat_gt_
> pl_`i'_XX)
573. 
. if "`controls'"!=""{
574. 
. levelsof d_sq_int_XX, local(levels_d_sq_XX)
575. foreach l of local levels_d_sq_XX {     
576. if (scalar(useful_res_`l'_XX)>1){ // MODIF FELIX
577.         
. capture drop combined_pl`=increase_XX'_temp_`l'_`i'_XX  
578. gen combined_pl`=increase_XX'_temp_`l'_`i'_XX=0
579.                 
. forvalues j=1/`count_controls'{
580. forvalues k=1/`count_controls'{         
581.         
. capture drop in_brackets_pl_`l'_`j'_`k'_temp_XX
582. //// CHANGE BELOW - tks + Changes Diego 27-03-25: remove N_c_`l'_XX from formula below, since we have
>  adjusted inv_Denom above
> gen in_brackets_pl_`l'_`j'_`k'_temp_XX = inv_Denom_`l'_XX[`j',`k'] * in_sum_`k'_`l'_XX * (d_sq_int_XX ==
>  `l' & F_g_XX>=3)
583. ////
> replace in_brackets_pl_`l'_`j'_XX=in_brackets_pl_`l'_`j'_XX+in_brackets_pl_`l'_`j'_`k'_temp_XX
584. }
585. 
. replace in_brackets_pl_`l'_`j'_XX=in_brackets_pl_`l'_`j'_XX - coefs_sq_`l'_XX[`j',1]
586. 
. capture drop combined_pl`=increase_XX'_temp_`l'_`j'_`i'_XX 
587. gen combined_pl`=increase_XX'_temp_`l'_`j'_`i'_XX=M_pl`=increase_XX'_`l'_`j'_`i'_XX*in_brackets_pl_`l
> '_`j'_XX
588. 
. replace combined_pl`=increase_XX'_temp_`l'_`i'_XX=combined_pl`=increase_XX'_temp_`l'_`i'_XX+combined_pl`
> =increase_XX'_temp_`l'_`j'_`i'_XX
589. } 
590. 
. replace part2_pl_switch`=increase_XX'_`i'_XX=part2_pl_switch`=increase_XX'_`i'_XX+combined_pl`=increase_
> XX'_temp_`l'_`i'_XX
591. } // MODIF FELIX
592. } // end loop oveer l
593. 
. }       
594. 
. bys group_XX: gegen U_Gg_pl_`i'_var_XX=total(U_Gg_pl_`i'_temp_var_XX)
595. 
. // Modeif Felix 21.03.2025 (adjust order of adding additional term and summing across t)
. if "`controls'"!=""{
596.         if `=increase_XX'==1{
597.         replace U_Gg_pl_`i'_var_XX=U_Gg_pl_`i'_var_XX - part2_pl_switch1_`i'_XX 
598.         }
599. 
.         if `=increase_XX'==0{
600.         //// CHANGE BELOW - tks (change plus to minus since final sign flip won't be until later)
>         replace U_Gg_pl_`i'_var_XX=U_Gg_pl_`i'_var_XX - part2_pl_switch0_`i'_XX         
601.         }
602. }
603. 
. }
604. 
. ////////// 7. Computing adjustements for the normalized and trends_lin options for placebos
> ////////// (similar to part 4, not commented) 
