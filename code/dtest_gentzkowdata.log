1560.         scalar warning_pl= abs(v_pl[1,1]/v_pl[rowsof(v_pl), colsof(v_pl)])
1561.         if (warning_pl != .) {
1562.                 scalar p_jointplacebo=1-chi2(l_placebo_XX,didmgt_chi2placebo[1,1])
1563.                 ereturn scalar p_jointplacebo=1-chi2(l_placebo_XX,didmgt_chi2placebo[1,1])
