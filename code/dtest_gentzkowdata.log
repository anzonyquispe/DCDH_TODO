1485.         
.                 // Fill off diagonal with covariances
.                 if `i'<`total_num_estimates_XX'{
1486.                 forvalue j=`=`i'+1'/`total_num_estimates_XX'{
1487.                         
.                         * Create variables necessary to compute the covariances
.                         capture drop U_Gg_var_comb_`i'_`j'_XX
1488.                         capture drop U_Gg_var_comb_`i'_`j'_2_XX
1489.                                         
.                         if ("`normalized'"==""){
1490.                         gen U_Gg_var_comb_`i'_`j'_XX = U_Gg_var_comb_`i'_XX + U_Gg_var_comb_`j'_XX
1491.                 }
1492.                         
.                         // Also need adjusted delta_D for all effects!!!
.                         if "`normalized'"!=""{
1493.                         gen U_Gg_var_comb_`i'_`j'_XX = U_Gg_var_comb_`i'_XX/scalar(delta_D_all_`i'_X
> X) + U_Gg_var_comb_`j'_XX/scalar(delta_D_all_`j'_XX)
1494.                 }
1495. 
.                         * Estimate the covariances
