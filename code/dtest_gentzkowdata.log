> st numeric max=1) dont_drop_larger_lower NORMALIZED cluster(varlist numeric max=1) graphoptions(string) 
> save_results(string) graph_off same_switchers same_switchers_pl effects_equal(string)  drop_if_d_miss_be
> fore_first_switch trends_lin ci_level(integer 95) by(varlist numeric max=1) predict_het(string) predict_
> het_hc2bm design(string) date_first_switch(string)  NORMALIZED_weights CONTinuous(integer 0) reset(integ
> er 0) save_sample less_conservative_se more_granular_demeaning by_path(string) bootstrap(string) _no_upd
> ates]
  3.         
. ////////// 0. Auto-updates
> if "`_no_updates'" == "" {
  4.         if uniform() < 0.01 {
  5.                 noi ssc install did_multiplegt_dyn, replace
  6.         }
  7. }       
  8. 
. ////////// 1. Checking that necessary tools to run command installed, and that syntax correctly specifie
> d.      
>                 
. ///// Check if gtools is installed, if not present link to install
> qui cap which gtools
  9. if _rc{
 10.         di ""
 11.         di as error "You have not installed the gtools package which is used within the did_multipleg
> t_dyn command."
 12.         di `"{stata "ssc install gtools": Click here to install gtools}"'
