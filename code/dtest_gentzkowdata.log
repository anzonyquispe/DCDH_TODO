. * ---------------------------------------------------------------
. * compare_dyn_matrices
. *   Element-wise comparison of two stored result matrices.
. *   Lists every row whose absolute difference exceeds tol().
. * ---------------------------------------------------------------
. capture program drop compare_dyn_matrices

. program compare_dyn_matrices
  1.         syntax, NEW(string) SSC(string) [TOL(real 1e-8)]
  2. 
.         local nr_new = rowsof(`new')
  3.         local nr_ssc = rowsof(`ssc')
  4.         di as result _newline "=== Comparison: NEW vs SSC ==="
  5.         di as text "Rows in NEW matrix: `nr_new'"
  6.         di as text "Rows in SSC matrix: `nr_ssc'"
  7. 
.         if `nr_new' != `nr_ssc' {
  8.                 di as error "Dimension mismatch -- cannot do element-wise comparison."
  9.                 exit 198
 10.         }
 11. 
.         matrix diff_results = `new' - `ssc'
 12. 
.         scalar n_diff = 0
 13.         scalar max_abs_diff = 0
 14.         local rownames : rowfullnames diff_results
 15. 
.         forvalues i = 1/`nr_new' {
 16.                 local v = diff_results[`i', 1]
 17.                 if !missing(`v') {
 18.                         if abs(`v') > `tol' {
 19.                                 scalar n_diff = n_diff + 1
 20.                                 if abs(`v') > max_abs_diff scalar max_abs_diff = abs(`v')
 21.                         }
 22.                 }
 23.         }
 24. 
.         di as result "Rows with |diff| > `tol': " n_diff
 25.         di as result "Maximum absolute difference: " max_abs_diff
 26. 
.         di as text _newline "Differing rows:"
 27.         forvalues i = 1/`nr_new' {
 28.                 local v = diff_results[`i', 1]
 29.                 if !missing(`v') & abs(`v') > `tol' {
 30.                         local rname : word `i' of `rownames'
 31.                         di as text "  Row " %4.0f `i' "  `rname'" _col(45) ///
>                                 "NEW=" %14.7g `new'[`i',1] "  SSC=" %14.7g `ssc'[`i',1] "  diff=" %14.7g
>  `v'
 32.                 }
 33.         }
 34. end

