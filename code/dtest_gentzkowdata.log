1078.         ereturn scalar N_switchers_effect_`i'_w= N1_`i'_XX_weight+N0_`i'_XX_weight
1079. 
.         capture drop count`i'_global_XX_w
1080.         capture drop N_effect_`i'_XX_w
1081.         
.         gen count`i'_global_XX_w=count`i'_global_XX/weight_XX
1082.         gegen N_effect_`i'_XX_w = total(count`i'_global_XX_w) 
1083.         scalar N_effect_`i'_XX_w = N_effect_`i'_XX_w
