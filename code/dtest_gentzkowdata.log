. if ("`switchers'"==""&N1_placebo_`i'_XX_new==0&N0_placebo_`i'_XX_new==0)|("`switchers'"=="out"&N0_placeb
> o_`i'_XX_new==0)|("`switchers'"=="in"&N1_placebo_`i'_XX_new==0){
1187.         scalar DID_placebo_`i'_XX=.
1188. }
1189. 
. ereturn scalar Placebo_`i' = scalar(DID_placebo_`i'_XX)
1190. 
