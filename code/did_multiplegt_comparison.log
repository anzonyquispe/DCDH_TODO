. /*******************************************************************************
> SUBPROGRAMS FOR CROSS-VALIDATION
> *******************************************************************************/
. //1.
. cap program drop parse_select_cv_suboptions

. program parse_select_cv_suboptions , sclass
  1.     syntax [, ALGOrithm(string) TOLErance(real 0.01) max_k(integer 5) seed(integer 0) kfolds(integer 5
> ) same_order_all_logits] // Felix: should it be max_k(integer 1) or actually max_k(integer 5) here? -> Mo
> dif: using default 5 makes it run and is consistent with what we say in the help file!
  2.     
.         // Felix: In the help file now we say that algorithm has to be specified!       
.         
.     sreturn local algorithm `algorithm'
  3.     sreturn local tolerance `tolerance'
  4.     sreturn local max_k     `max_k'
  5.     sreturn local seed      `seed'
  6.         sreturn local kfolds    `kfolds'
  7.         sreturn local same_order_all_logits  `same_order_all_logits'
  8. end

. 
. 
. capture program drop cross_validation

. program define cross_validation, sclass
  1.         version 12.0
  2.         syntax  anything [if] [in] [, ALGOrithm(string) TOLErance(real 0) max_k(integer 5) seed(intege
> r 0) kfolds(integer 5) model(string) cv_covariates(varlist) FIRST_stage reduced_form same_order_all_logit
> s] 
  3.         
.         scalar set_chosen_order_linear = 0
  4.         tokenize `anything'
  5.         //di as error "outcome = `1'"
. di _newline
  6. 
. 
. if ("`algorithm'"=="kfolds") _dots 0, title(`algorithm'(`kfolds'): Cross validation running) reps(`max_k'
> )
  7. 
. if ("`algorithm'"=="loocv") {
  8.         _dots 0, title(`algorithm': Cross validation running) reps(`max_k')
  9. }
 10. 
.                         if ("`model'" == "logit"&"`algorithm'"=="loocv") {
 11.                                 di as error "logit regression not allowed with loocv."
 12.                                 exit
 13.                         }
 14.                         
. //Display 
. if ("`first_stage'"=="") {
 15.         local outcomeYorD = "Y"
 16.         local treatmentDorZ = "D"
 17. }
 18. else{
 19.         local outcomeYorD = "D"
 20.         local treatmentDorZ = "Z"
 21. }
 22. if ("`reduced_form'"!=""){
 23.         local outcomeYorD = "Y"
 24.         local treatmentDorZ = "Z"
 25.         local IV "I"
 26. }
 27. //di as red "`outcomeYorD' = outcome"
.                         if ("`1'" == "deltaYt_XX") local name = "E(`outcomeYorD'_t - `outcomeYorD'_{t-1}|
> `treatmentDorZ'_{t-1})"
 28.                         if ("`1'" == "S`IV'0bist_XX")  local name = "P(S_t = 0|`treatmentDorZ'_{t-1})"
 29.                         if ("`1'" == "S`IV'tPlus_XX")  local name = "P(S+_t = 0|`treatmentDorZ'_{t-1})
> "
 30.                         if ("`1'" == "S`IV'tMinus_XX") local name = "P(S-_t = 0|`treatmentDorZ'_{t-1})
> "
 31.         
. di as input " "
 32. di as input "{hline 80}"
 33. di as input "Cross-validation on `name': "
 34. di as input "{hline 80}"        
 35. di as input "Models" _skip(18) "CV's Scores"
 36. quietly{
 37.         //>MAIN: Preserve the inputted dataset
.         preserve
 38.         
.         //dropping observations not included in the if condition
.         if "`if'" !=""{
 39.         //keep `if'
.         }
 40. //mata: mata clear
. //Test
. cap drop CVs
 41. cap drop Order
 42. 
. gen CVs = .
 43. gen Order = .
 44. 
. }
 45. quietly{
 46.                         if ("`algorithm'"=="kfolds"){
 47.                                                                 //Shuffle the whole dataset 
.                                 cap drop random_shufller_XX
 48.                                 set seed `seed'
 49.                                 gen random_shufller_XX = rnormal()
 50.                                 sort random_shufller_XX
 51.                                 
.                                 //Generate the test samples identifier
.                                 cap drop fold_identifier_XX 
 52.                                 set seed `seed'
 53.                                 gen fold_identifier_XX = runiformint(1, `kfolds')
 54.                                 tab fold_identifier_XX
 55.                         }
 56. }       
 57.                                         local counter2 = 0
 58.                                         
. local cv_covariates0
 59. local PolK0 
 60. forvalues k=1/`max_k'{
 61.         if ("`reduced_form'"!="") local VAR = "Z"
 62.         else local VAR = "D"
 63.         xtset ID_XX T_XX
 64.         cap drop LD_XX 
 65.         gen LD_XX = L.`VAR'_XX
 66.         
. cap drop Lag1Dt_`k'XX
 67. gen Lag1Dt_`k'XX = LD_XX^`k'
 68. local PolK`k' "`PolK`=`k'-1'' c.Lag1Dt_`k'XX"
 69. foreach var of varlist T_XX_FE_1-T_XX_FE_`=max_T'{
 70.         cap drop bis`var'_Lag1Dt_`k'XX
 71.         gen  bis`var'_Lag1Dt_`k'XX = `var'*Lag1Dt_`k'XX
 72. }
 73. }
 74. 
. forvalues k=1/`max_k'{
 75.         //Progress Bar
.         sleep 1
 76.     _dots `k' 0 
