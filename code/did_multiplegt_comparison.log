. /******************************************************************************
> TESTING THE DIFFERENCE BETWEEN AS AND WAS IF REQUESTED
> 
> Note: Let UPhi1 and UPhi2 be the non-demeaned versions of Phi1 and Phi2
> Testing H_0: as = was is equivalent to testing H0: meanUPhi1 = meanUPhi2
> H0: meanUPhi1 = meanUPhi2 <=> H0: mean(UPhi1 - UPhi2) = 0.
> Under H_0, mean(UPhi1 - UPhi2) = 0 <=> mean(Phi1 - Phi2) = 0.
> Then we can just test whether the variable  diff_Phi1_2_XX = Phi1_XX - Phi2_XX
> is mean-zero or not. This is also equivalent to run reg diff_Phi1_2_XX.
> *******************************************************************************/
. if ("`as_vs_was'"!=""&`a_vs_w'==2){
721.         
.         scalar diff_delta1_2_XX = scalar(delta1_1XX) - scalar(delta2_1XX)
722.         cap drop diff_Phi1_2_XX 
723.         gen  diff_Phi1_2_XX = Phi1_XX - Phi2_XX
724.         sum diff_Phi1_2_XX
725.     scalar sd_diff_Phi1_2_XX = r(sd)
726.         scalar tstat_XX = scalar(diff_delta1_2_XX)*sqrt(r(N))/sd_diff_Phi1_2_XX
727.         scalar pval_as_vs_was = 2*(1-normal(abs(tstat_XX)))
728.         
.         matrix as_vs_was_mat = J(1,6,.)
729.         matrix as_vs_was_mat[1,1] = scalar(diff_delta1_2_XX)
730.         matrix as_vs_was_mat[1,2] = scalar(sd_diff_Phi1_2_XX)
731.         matrix as_vs_was_mat[1,3] = scalar(diff_delta1_2_XX) - 1.96*scalar(sd_diff_Phi1_2_XX)/sqrt(r(N
> ))
732.         matrix as_vs_was_mat[1,4] = scalar(diff_delta1_2_XX) + 1.96*scalar(sd_diff_Phi1_2_XX)/sqrt(r(N
> ))
733.         matrix as_vs_was_mat[1,5] = scalar(pval_as_vs_was)
734.         matrix as_vs_was_mat[1,6] = scalar(tstat_XX)
735.         
.         matrix colnames as_vs_was_mat = "Diff." "SE" "LB CI" "UB CI" "pval." "t"
736.     matrix rownames as_vs_was_mat = "AS-WAS"
737.         
.         // matrix as_vs_was_mat`q' = as_vs_was_mat // Modif Felix: store as_vs_was matrix in ereturns, ho
> wever still need to adapt for by etc.
.         //local myN = r(N)
. }
738. 
