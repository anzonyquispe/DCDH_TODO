. /*******************************************************************************
> SUBPROGRAM POLYNOMIALS GENERATOR
> *******************************************************************************/
. cap program drop polynomials_generator

. program define polynomials_generator, sclass
  1.     syntax [, order(integer 1) pla prefix(string) controls(varlist numeric) other_treatments(varlist n
> umeric) FIRST_stage reduced_form exact_match]
  2.     
.         if ("`first_stage'"!=""|"`reduced_form'"!="") local VAR = "Z"
  3.         else local VAR = "D"
  4.         // Generating polynomials of the baseline treatement/instrument 
.                 //i for D
.                         local vars_pol_XX =""  //"`other_treatments'" 
  5.                         local vars_pol_controlsXX ="" 
  6.                         forvalues pol_level = 1/`order'{
  7.                         scalar pol_level_`pla'XX = `pol_level'
  8.                         capture drop D1_XX_`pol_level'_XX 
  9.                         gen D1_XX_`pol_level'_XX = `VAR'1_XX^scalar(pol_level_`pla'XX)
 10.                         local vars_pol_XX = "`vars_pol_XX' D1_XX_`pol_level'_XX"
 11.                         
.                         //Controls: Generate the polynomial order of each control
.                         if ("`controls'"!=""){
 12.                                 foreach control in `controls'{
 13.                                         cap drop `control'_`pol_level'_XX
 14.                                         gen `control'_`pol_level'_XX = `control'^scalar(pol_level_`pla
> 'XX)
 15.                                         local vars_pol_controlsXX = "`vars_pol_controlsXX' `control'_`
> pol_level'_XX"
 16.                                 }
 17.                         }
 18.                         }
 19.                 if (`order'>1){ //we only do the interaction when order>2 & exact_match is not specifi
> ed. 
 20.                         //Add the interaction control#D1
.                         if ("`controls'"!=""&`order'>1){
 21.                                 foreach control in `controls'{
 22.                                         local vars_pol_controlsXX = "`vars_pol_controlsXX' c.`control'
> #c.`VAR'1_XX"
 23.                                 }
 24.                         }
 25.                         //Add the interaction control#control if order>=2
. 
.                         if ("`controls'"!=""&`order'>1){
 26.                                 local i = 0
 27.                                 foreach control1 in `controls'{
 28.                                         local i = `i'+1
 29.                                         local j = 0
 30.                                         foreach control2 in `controls'{
 31.                                                 local j = `j'+1
 32.                                                 if (`j'>`i') {
 33.                                                         local vars_pol_controlsXX = "`vars_pol_control
> sXX' c.`control1'#c.`control2'"
 34.                                                 }
 35.                                         }
 36.                                 }
 37.                         }       
 38.                         }
 39. 
.                                 //di as error "`vars_pol_controlsXX'"
.                 //// Other treatments option: More general and inclusive way of doing the interaction.
>                         if ("`other_treatments'"!=""){
 40.                                 foreach var in `other_treatments'{
 41.                                         if ("`interact'"==""){
 42.                                                 local interact  = "c.`var'##c.`VAR'1_XX"
 43.                                         }
 44.                                         else{
 45.                                                 local interact  = "c.`interact'##c.`var'"
 46.                                         }
 47.                         local vars_pol_XX = "`vars_pol_XX' `interact'"
 48.                                 }
 49. 
.                         }
 50.         
.                                 //All controls
.                         local vars_pol_XX = "`vars_pol_XX' `vars_pol_controlsXX'"
 51.                         
. //prefix in {logit_Plus, logit_Minus, logit_bis, reg}
.         
.     sreturn local `prefix'_pol_XX `vars_pol_XX'
 52.         //di as error "`s(`prefix'_pol_XX)'"
. 
. end

