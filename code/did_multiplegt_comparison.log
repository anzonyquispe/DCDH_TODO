.                         mata    A  = st_data(., "`cv_covariates`k''"):!= .
143.                         mata    id = st_data(., "id") :!= .
144.                         mata    A  = select(A, id)
145.                         mata    H  = (J(rows(A), 1,1) - diagonal(A * invsym(A' * A) * A')):^2
146.                         mata      st_matrix("H", H)
147.                         
