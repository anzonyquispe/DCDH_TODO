.         //2. Estimate P(S=0)
.         sum S0_XX 
489.         scalar PS0_`pla'XX = r(mean) //scalar(Nstayers2_`pairwise'XX )/(scalar(N_Switchers2_`pairwise'
> XX)+ scalar(Nstayers2_`pairwise'XX))
490.         
.         //3. P(S+=1|D_1), P(S-=1|D_1), P(S+=1) and P(S-=1) are generated after.
. 
.         //*********************for iWAS: It is done in Bookmark #3
.         
. 
. ********************************************************************************
. **# Bookmark #1 AS
. ********************************************************************************
. 
. if (`as' == 1){
491.         
. ************************************************        
.         cap drop S_over_deltaD_XX
492.         cap drop meanS_over_deltaD_XX
493.         
.         cap drop Phi1_`pairwise'`pla'XX //This influence function Phi1_{1,t}
494. ************************************************        
. 
.         // 0) Compute P_t = P(S_t = 1) = E(S_t) for the aggregation afterward
.         
.         // + Imbalanced panel adjustment
.         sum SbisV_XX //sum Sbis_XX changed because of weightss 
495.         //For aggregation
.         scalar P_`pairwise'`pla'XX = r(mean) // This is actually P(S_t = 1|H_t=1) (resp. E(SV|H_t=1)), we
>  need to adjust with PHt`pairwise'`pla'XX to have  P(S_t = 1, H_t=1) (resp. E(SVH_t))
496.         scalar P_`pairwise'`pla'XX = scalar(P_`pairwise'`pla'XX)*scalar(PHt`pairwise'`pla'XX)
497.         
.         scalar PS_sum_`pla'XX = scalar(PS_sum_`pla'XX) + scalar(P_`pairwise'`pla'XX) //PS_sum is initiali
> zed outside of this program
498.         scalar ES_`pairwise'`pla'XX = r(mean)  // We do not do the adjustment here, but will do it dir
> ectly in the expression of the IF.
499.         
.         gen S_over_deltaD_XX = Sbis_XX/deltaD_XX // = V/\DeltaD
500.         //The convention 0/0 = 0
.         replace S_over_deltaD_XX = 0 if Sbis_XX==0
501.         
.                 
.         //i. estimation of  \hat{E}(S/deltaD|D1)
.         reg S_over_deltaD_XX `reg_vars_pol_XX'   
502.         predict meanS_over_deltaD_XX , xb  
503.         
.         
.         //Adding cross-fitting & if exact_match
.         if ("`exact_match'"!=""){
504.                 
.                 // 1) Compute \hat{delta}_1
.                 gen inner_sumdelta1_XX  = inner_sumdelta12_XX/deltaD_XX // =SV*(\DeltaY - E(\DeltaY|S=0, 
> D1, V))/\DeltaD
505.                 replace inner_sumdelta1_XX = 0 if deltaD_XX==0 //The convention 0*missing = 0.
506.                 gen inner_sumdelta1_VXX = inner_sumdelta1_XX*weights_XX
507.                 sum inner_sumdelta1_VXX //inner_sumdelta1_XX 
508.                 scalar delta1_`pairwise'`pla'XX = r(mean)/scalar(ES_`pairwise'`pla'XX) // = E[SV*(\Del
> taY - E(\DeltaY|S=0, D1, V))/\DeltaD]/E[SV]
509.         }
510.         else{
511. 
.                 if ("`cross_fitting'"!="0"){
512.                 //Compute g^{(k)}(D_1) = E(S/\deltaD | D_1) for k=1, 2 : For now I use order of the re
> gression estimating E(\deltaY|D_1)
.                 reg S_over_deltaD_XX `reg_vars_pol_XX'  if cf_sample_id != 1 
513.                 //di as red "reg S_over_deltaD_XX `reg_vars_pol_XX'   if S_XX==0 & cf_sample_id != 1 "
.                 predict cf_meanS_over_deltaD_XX if cf_sample_id == 1 , xb               
514.                 
.                 forvalues cf_id = 2/`cross_fitting'{
515.                         reg S_over_deltaD_XX `reg_vars_pol_XX'   if  cf_sample_id != `cf_id' 
516.                         tempvar cf_meanS_over_deltaD_`cf_id'XX
517.                         predict `cf_meanS_over_deltaD_`cf_id'XX' if cf_sample_id == `cf_id' , xb
518.                         replace cf_meanS_over_deltaD_XX = `cf_meanS_over_deltaD_`cf_id'XX' if cf_sampl
> e_id == `cf_id'   
519.                 }
520.                 sum cf_inner_sumdelta12_XX
521.                 //di as red "cf_inner_sumdelta12_XX = `r(mean)'"
.                 
.                 //gen cf_delta1_DR_XX = weights_XX*[S_over_deltaD_XX - (cf_meanS_over_deltaD_XX/cf_PS0D1_
> XX)*(1-Sbis_XX)]*cf_inner_sumdelta12_XX
.                 gen      cf_delta1_DR_XX = [0 - (cf_meanS_over_deltaD_XX/cf_PS0D1_XX)]*cf_inner_sumdelta1
> 2_XX if Sbis_XX==0
522.                 replace  cf_delta1_DR_XX = [S_over_deltaD_XX]*cf_inner_sumdelta12_XX if Sbis_XX==1    
>           
523.                 
.                 //Initialize the point estimate's components
.                 scalar cf_sum_w_delta1_`pairwise'`pla'XX = 0
524.                 scalar delta1_num_`pairwise'`pla'XX     = 0
525.                 forvalues cf_id = 1/`cross_fitting'{
526.                 sum SbisV_XX if cf_sample_id == `cf_id'&cf_delta1_DR_XX!=.
527.                 scalar  cf_ES_`pairwise'`pla'`cf_id'XX = r(mean) 
528.                 scalar cf_N_`pairwise'`pla'`cf_id'XX = r(sum)
529.                 
.                 if (scalar(cf_ES_`pairwise'`pla'`cf_id'XX)==0){
530.                         scalar cf_delta1_`pairwise'`pla'`cf_id'_XX = 0 //convention in the paper.
531.                 }
532.                 else{
533.                 sum cf_delta1_DR_XX [iw = weights_XX] if cf_sample_id == `cf_id' //&  Sbis_XX==1      
>           
534.                 scalar cf_delta1_`pairwise'`pla'`cf_id'_XX = r(sum)/scalar(cf_N_`pairwise'`pla'`cf_id'
> XX)
535.                 }
536.                 scalar cf_sum_w_delta1_`pairwise'`pla'XX = scalar(cf_sum_w_delta1_`pairwise'`pla'XX) +
>  scalar(cf_N_`pairwise'`pla'`cf_id'XX)
537.                 scalar delta1_num_`pairwise'`pla'XX    = scalar(delta1_num_`pairwise'`pla'XX) + scalar
> (cf_N_`pairwise'`pla'`cf_id'XX)*scalar(cf_delta1_`pairwise'`pla'`cf_id'_XX)
538.                 }
539.                                 
.                 scalar delta1_`pairwise'`pla'XX = scalar(delta1_num_`pairwise'`pla'XX)/scalar(cf_sum_w_de
> lta1_`pairwise'`pla'XX) 
540.         }
541.         else{
542. 
.                 reg S_over_deltaD_XX `reg_vars_pol_XX'   //No! if S_XX==0 
543.                 predict dr_meanS_over_deltaD_XX , xb
544.                 
.                 //gen dr_delta1_DR_XX = weights_XX*[S_over_deltaD_XX - (meanS_over_deltaD_XX/PS0D1_XX)*(1
> -Sbis_XX)]*inner_sumdelta12_XX
.                 gen dr_delta1_DR_XX = [0 - (meanS_over_deltaD_XX/PS0D1_XX)]*inner_sumdelta12_XX if Sbis_X
> X==0
545.                 replace dr_delta1_DR_XX = [S_over_deltaD_XX]*inner_sumdelta12_XX if Sbis_XX==1
546.                 sum dr_delta1_DR_XX [iw = weights_XX] //if Sbis_XX==1   
547.                 scalar delta1_`pairwise'`pla'XX = r(mean) //scalar(ES_`pairwise'`pla'XX)
548.         }
549.         }
550. 
. 
. /**************************************************************************
>           2. COMPUTING THE VARIANCE  of \hat{delta}_1
> **************************************************************************/
.         
.         //Doulo: The Influence function is indexed by t to ease the aggregation after the loop is over by
>  using successive merging of datasets
.         
.         if ("`exact_match'"==""){
551.         gen Phi1_`pairwise'`pla'XX  = weights_XX*(S_over_deltaD_XX - meanS_over_deltaD_XX*(1-Sbis_XX)/
> (PS0D1_XX))*inner_sumdelta12_XX //Here we use the prediction from a logit, if not exact_match
552.         }
553.         else{
554.         gen Phi1_`pairwise'`pla'XX  = weights_XX*(S_over_deltaD_XX - meanS_over_deltaD_XX*(1-Sbis_XX)/
> (1-ESbis_XX_D1))*inner_sumdelta12_XX //Here we use the prediction from a linear regression, if exact_matc
> h
555.         }
556.         // + Imbalanced panel adjustment:
.                 //a.  Deviding by scalar(PHt`pairwise'`pla'XX)
.         replace Phi1_`pairwise'`pla'XX  = [Phi1_`pairwise'`pla'XX - scalar(delta1_`pairwise'`pla'XX)*Sbis
> V_XX]/[scalar(ES_`pairwise'`pla'XX)*scalar(PHt`pairwise'`pla'XX)]
557.                 //b. Replace the IF by 0 if Ht_XX==0
.         replace Phi1_`pairwise'`pla'XX = 0 if Ht_XX==0
558.         replace Phi1_`pairwise'`pla'XX = . if S_XX==.
559.         
.         sum Phi1_`pairwise'`pla'XX 
560.         if ("`cluster'"!=""){ // Clustering the variance //CLUSTER OPTION //weights OPTION
561. 
.                 cap drop Phi1_`pairwise'`pla'_cXX //I create a new variable, because I need the one witho
> ut clustering in the aggregation
562.                 bysort `cluster': egen Phi1_`pairwise'`pla'_cXX = total(Phi1_`pairwise'`pla'XX)
563.                 bysort `cluster': replace Phi1_`pairwise'`pla'_cXX=. if _n!=1|S_XX==.
564.                 replace Phi1_`pairwise'`pla'_cXX = Phi1_`pairwise'`pla'_cXX/scalar(N_bar_c_`pairwise'`
> pla'XX)
565.                 sum Phi1_`pairwise'`pla'_cXX [iw = weights_cXX]         
566.         }
567. 
.         scalar sd_delta1_`pairwise'`pla'XX = r(sd)/sqrt(r(N)) 
568.         
.         scalar LB1_`pairwise'`pla'XX = scalar(delta1_`pairwise'`pla'XX) - 1.96*scalar(sd_delta1_`pairwise
> '`pla'XX)
569.         scalar UB1_`pairwise'`pla'XX = scalar(delta1_`pairwise'`pla'XX) + 1.96*scalar(sd_delta1_`pairw
> ise'`pla'XX)
570.         
.         //Now Let's store S_t*V_t for the Influence function variable of the aggregation
.         cap drop S_`pairwise'`pla'XX
571.         gen S_`pairwise'`pla'XX = SbisV_XX
572.         
.         // + Imbalanced panel adjustment: replace S_t by S_t*H_t in the aggreagation of the point estimat
> es formula
.         replace  S_`pairwise'`pla'XX = Ht_XX if Ht_XX==0 //(=S_t*H_t)
573.         replace  S_`pairwise'`pla'XX = S_`pairwise'`pla'XX //S_t*V_t
574. }
575. 
. ********************************************************************************
. **# Bookmark #2 WAS
. ********************************************************************************
. if (`was' == 1){
576. cap drop absdeltaDV_XX
577. gen absdeltaDV_XX = absdeltaD_XX*weights_XX //sgn(\DeltaD)*V
578.         sum absdeltaDV_XX //absdeltaD_XX
579.         scalar EabsdeltaD_`pla'XX = r(mean)
580.         //For aggregation of the point estimates
.         scalar EabsdeltaD_`pairwise'`pla'XX =  r(mean) 
581.         //+ Imbalanced panel data: This is actually E(V|deltaD||H_t=1), we need to adjust with PHt`pai
> rwise'`pla'XX to have  E(V|deltaD|, H_t=1) 
.         scalar EabsdeltaD_`pairwise'`pla'XX = scalar(EabsdeltaD_`pairwise'`pla'XX )*scalar(PHt`pairwise'`
> pla'XX)
582.         
.         scalar EabsdeltaD_sum_`pla'XX = scalar(EabsdeltaD_sum_`pla'XX) + scalar(EabsdeltaD_`pairwise'`pla
> 'XX) //EabsdeltaD_sum_XX is initialized outside of this program
583.         
.         cap drop Phi2_`pairwise'`pla'XX //This influence function Phi2_{1,t}
584. 
. /**************************************************************************
>             1. COMPUTING THE POINT ESTIMATE \hat{delta}_2: START
> **************************************************************************/
.         foreach suffix in  "Minus" "Plus"{
585.                 cap drop trimmed_out2_XX
586.                 //i)compute \hat{delta}_2+ and \hat{delta}_2-, and w+
. 
.                 if ("`suffix'" =="Plus"){
587.                         cap drop Ster_XX
588.                         gen Ster_XX = (S_XX==1) 
589.                         //replace Ster_XX =. if S_XX==-1
.                 }
590.                 if ("`suffix'" =="Minus") {
591.                         cap drop Ster_XX
592.                         gen Ster_XX = (S_XX==-1)
593.                         //replace Ster_XX =. if S_XX==1
.                 }
594.                 
.                 //use r(sum) instead of r(mean) since in case there is no observation r(mean) gives ., wh
> eras r(sum) will give 0: this is for the r-based approach.
.                 cap drop deltaDV_XX
595.                 gen deltaDV_XX = deltaD_XX*weights_XX
596.                 sum deltaDV_XX  if Ster_XX==1
597.                 scalar denom_delta2`suffix'_`pairwise'`pla'XX = r(sum)
598. 
. /**************************************************************************
>                            IF REGRESSION-BASED APPROACH 
> **************************************************************************/
.                 if ("`estimation_method'" == ""|"`estimation_method'" == "ra"){
599.                 
.                 if (denom_delta2`suffix'_`pairwise'`pla'XX ==0){
600.                         scalar denom_delta2`suffix'_`pairwise'`pla'XX = 1 //in case it is zero set it 
> to 1 to avoid dividing by 0, in that case the numerator is also equal to 0
601.                 }
602.                 cap drop Vinner_sumdelta12_XX
603.                 gen Vinner_sumdelta12_XX = inner_sumdelta12_XX*weights_XX
604.                 sum  Vinner_sumdelta12_XX  if Ster_XX==1
605.                 scalar num_delta2`suffix'_`pairwise'`pla'XX = r(sum)
606.                 
.                 scalar delta2`suffix'_`pairwise'`pla'XX = scalar(num_delta2`suffix'_`pairwise'`pla'XX)/sc
> alar(denom_delta2`suffix'_`pairwise'`pla'XX) // = E[V(\DeltaD){\DeltaY - E(\DeltaY|S=0, D1,  V)}]/E(V\Del
> taD)
607.                 }
608.                 
. /**********************************************************************************
>           o. Preliminaries: All the variables needed regardless the estimation_method
> **********************************************************************************/
.                cap drop  PS1`suffix'D1_XX
609.                    
.                //1. Estimate P(S`suffix'=1)
.                    count if Ster_XX ==1
610.                    scalar nb_Switchers`suffix'`pla'XX = r(N) // I need the non-weightsed number of swi
> tchers to display
611.                    
.                    scalar PS`suffix'1`pla'XX = scalar(nb_Switchers`suffix'`pla'XX)/scalar(N_`pla'XX)
612.         
.                    
. if ("`exact_match'"==""){ //We only do the logit regression if we have continuous treatment, i.e., when e
> xact_match is not specified    
613.                    if (scalar(PS`suffix'1`pla'XX)==0){ //I do the regression iff there is at least one
>  switcher up/down.
614.                    scalar delta2`suffix'_`pairwise'`pla'XX  = 0 // the weightss as well -see above-is 
> set to 0 if {i: Ster_XX==1} = empty.
615.                    
.                    cap drop PS1`suffix'D1_XX //create it and set it to zero, since I will call it outside
>  this loop for the dr method.
616.                    gen PS1`suffix'D1_XX = 0
617.                         if ("`cross_fitting'"!="0"){
618.                                 gen cf_PS1`suffix'D1_XX = 0
619.                         }
620.                    
.                    }
621.                    else{ 
622.                         //2. Estimate P(S`suffix' = 1|D_1) 
.                         
.                                 capture logit Ster_XX `logit_`suffix'_pol_XX'     , asis
623.                                 predict PS1`suffix'D1_XX , pr asif
624.                         if ("`cross_fitting'"!="0"){
625.                                 
.                                 capture logit Ster_XX `logit_`suffix'_pol_XX' if cf_sample_id != 1     , 
> asis
626.                                 predict cf_PS1`suffix'D1_XX  if cf_sample_id == 1 , pr asif
627.                                 
.                                 forvalues cf_id = 2/`cross_fitting'{
628.                                 tempvar cf_PS1`suffix'D1_`cf_id'XX
629.                                 capture logit Ster_XX `logit_`suffix'_pol_XX' if cf_sample_id != `cf_i
> d'     , asis
630.                                 predict `cf_PS1`suffix'D1_`cf_id'XX' if cf_sample_id == `cf_id', pr as
> if
631.                                 replace cf_PS1`suffix'D1_XX = `cf_PS1`suffix'D1_`cf_id'XX'  if cf_samp
> le_id == `cf_id'
632.                                 }
633.                                 
.                         *gen trimmed_out2_XX = 1 if (cf_PS1`suffix'D1_XX<`trimming_down'|cf_PS1`suffix'D1
> _XX>`trimming_up')&cf_PS1`suffix'D1_XX!=.
.                         *replace cf_PS1`suffix'D1_XX = . if trimmed_out2_XX == 1
.                         }
634.                         /*else{
>                         gen trimmed_out2_XX = 1 if (PS1`suffix'D1_XX<`trimming_down'|PS1`suffix'D1_XX>`tr
> imming_up')&PS1`suffix'D1_XX!=.
>                         replace PS1`suffix'D1_XX = . if trimmed_out2_XX == 1
>                         }*/
.                         //Convention Logit STATA R
.                         replace PS1`suffix'D1_XX=0 if PS1`suffix'D1_XX<=10^(-10)
635.                         
. 
. /**************************************************************************
>                                        IF PS-based APPROACH
> **************************************************************************/
.                 if ("`estimation_method'" == "ps"){
636.                         //3. Compute deltaY*[(PS1`suffix'D1_XX*PS0_XX)/(PS0D1_XX*PS`suffix'1XX)]
.                         cap drop deltaYP_`suffix'XX
637.                         gen deltaYP_`suffix'XX = weights_XX*deltaY_XX*(PS1`suffix'D1_XX/PS0D1_XX)*(sca
> lar(PS0_`pla'XX)/scalar(PS`suffix'1XX))
638.                         sum deltaYP_`suffix'XX if S_XX==0
639.                         scalar mean_deltaYP_`suffix'`pla'XX = r(mean)
640.                         
.                         cap drop deltaYV_XX
641.                         gen deltaYV_XX = deltaY_XX*weights_XX
642.                         sum deltaY_XX  if Ster_XX ==1
643.                         scalar mean_deltaY_`pla'XX = r(mean) //E(\DeltaY V)
644.                         
.                         sum deltaDV_XX  if Ster_XX==1
645.                         
.                         scalar delta2`suffix'_`pairwise'`pla'XX = (scalar(mean_deltaY_`pla'XX) - scalar(m
> ean_deltaYP_`suffix'`pla'XX))/r(mean)
646.                 }
647.                 } //End of the else
648. } //End of the if with exact_match
649. 
. /**************************************************************************
>        i. COMPUTING THE contribution-weightsS (wPlus and wMinus)
> **************************************************************************/
.                 cap drop prod_sgndeltaDdeltaD_XX
650.                 gen prod_sgndeltaDdeltaD_XX = S_XX*deltaD_XX
651.                 sum prod_sgndeltaDdeltaD_XX if Ster_XX==1
652.                 //scalar w`suffix'_`pairwise'`pla'XX = r(sum)/scalar(N_`pla'XX)
.                 scalar w`suffix'_`pairwise'`pla'XX = r(sum)/scalar(N_`pla'XX) //scalar(W_`pla'XX) // beca
> use of the weights option 
653. //The sum at the denominator of \hat{\delta}_2`suffix'
. 
.         } //End of the suffix loop
654.                 
. /**************************************************************************
>       ii. COMPUTING THE FINAL weightsS WPLus = wPlus/(wPlus+wMinus)
> **************************************************************************/
.                 
. if ("`estimation_method'" == ""|"`estimation_method'" == "ps"|"`estimation_method'" == "ra"){
655.         scalar W_Plus_`pairwise'`pla'XX = scalar(wPlus_`pairwise'`pla'XX)/(scalar(wPlus_`pairwise'`pla
> 'XX)+scalar(wMinus_`pairwise'`pla'XX))
656. }
657.         
.         
. /**************************************************************************
>                        COMPUTING THE POINT ESTIMATE: END
> **************************************************************************/
. if ("`exact_match'"==""){
658.             cap drop dr_deltaYV_XX
659.                 gen dr_deltaYV_XX = weights_XX*(S_XX - [(PS1PlusD1_XX - PS1MinusD1_XX)/PS0D1_XX]*(1-Sb
> is_XX))*inner_sumdelta12_XX if Sbis_XX == 0
660.                 
.                 replace dr_deltaYV_XX = weights_XX*(S_XX)*inner_sumdelta12_XX if Sbis_XX == 1 // Modif Do
> ulo: RF or FS giving 0.
661.         
.                 if ("`cross_fitting'"=="0"){
662.                 sum dr_deltaYV_XX //if Sbis_XX==1 //WIll use it for the dr point estimate and for the 
> estimation of the variance!
663.                 scalar num_dr_delta2_`pla'XX = r(sum)
664.                 }
665.                 else{
666.                 cap drop cf_dr_deltaYV_XX
667.             gen cf_dr_deltaYV_XX = weights_XX*(S_XX - [(cf_PS1PlusD1_XX - cf_PS1MinusD1_XX)/cf_PS0D1_X
> X]*(1-Sbis_XX))*cf_inner_sumdelta12_XX if Sbis_XX == 0
668.                 replace cf_dr_deltaYV_XX = weights_XX*(S_XX)*cf_inner_sumdelta12_XX if Sbis_XX == 1 
669.                 
.                 //Initialize the poit estimate's components:
.                 scalar cf_sum_w_delta2_`pairwise'`pla'XX = 0
670.                 scalar delta2_num_`pairwise'`pla'XX    = 0              
671.                 
.                 forvalues cf_id = 1/`cross_fitting'{
672.                 sum cf_dr_deltaYV_XX if cf_sample_id == `cf_id' //&Sbis_XX==1
673.                 
.                 scalar num_dr_delta2_`cf_id'_`pla'XX = r(sum)
674. 
.                 sum absdeltaDV_XX if cf_sample_id == `cf_id'&cf_dr_deltaYV_XX!=.
675.                 scalar cf_deltaD_`cf_id'_`pairwise'`pla'XX = r(sum)
676.                 if (scalar(cf_deltaD_`cf_id'_`pairwise'`pla'XX)==0){
677.                         scalar cf_delta2_`cf_id'_`pairwise'`pla'XX = 0 //convention in the paper.
678.                 }
679.                 else{
680.                 scalar cf_delta2_`cf_id'_`pairwise'`pla'XX = scalar(num_dr_delta2_`cf_id'_`pla'XX)/sca
> lar(cf_deltaD_`cf_id'_`pairwise'`pla'XX)
681.                 
.                 scalar cf_sum_w_delta2_`pairwise'`pla'XX = scalar(cf_sum_w_delta2_`pairwise'`pla'XX) + sc
> alar(cf_deltaD_`cf_id'_`pairwise'`pla'XX)
682.                 scalar delta2_num_`pairwise'`pla'XX   = scalar(delta2_num_`pairwise'`pla'XX) + scalar(
> cf_deltaD_`cf_id'_`pairwise'`pla'XX)*scalar(cf_delta2_`cf_id'_`pairwise'`pla'XX)
683.                 }
684.                 }
685.                 }
686. }               
687.                 if ("`estimation_method'" == ""|"`estimation_method'" == "ps"|"`estimation_method'" ==
>  "ra"){
688.                 scalar delta2_`pairwise'`pla'XX = scalar(W_Plus_`pairwise'`pla'XX)*scalar(delta2Plus_`
> pairwise'`pla'XX) + (1 - scalar(W_Plus_`pairwise'`pla'XX))*scalar(delta2Minus_`pairwise'`pla'XX ) 
689.                 
.                 }
690.         
.                 if ("`estimation_method'" == "dr"){
691.                         if ("`cross_fitting'"=="0"){
692.                                 sum absdeltaDV_XX 
693. 
.                                 scalar delta2_`pairwise'`pla'XX = scalar(num_dr_delta2_`pla'XX)/r(sum)
694.                         }
695.                         else{
696.                                                                 
.                                 scalar delta2_`pairwise'`pla'XX = scalar(delta2_num_`pairwise'`pla'XX)/sc
> alar(cf_sum_w_delta2_`pairwise'`pla'XX)
697.                                 
.                         }
698.                 }
699. /**************************************************************************
>           2. COMPUTING THE VARIANCE (The variance is not method-specific) // but we use linear regression
>  if exact_match, and logit otherwise
> **************************************************************************/
.         if ("`exact_match'"==""){
700.                 gen Phi2_`pairwise'`pla'XX = (dr_deltaYV_XX -scalar(delta2_`pairwise'`pla'XX)*absdelta
> DV_XX) //DS TS weights_XX*(dr_deltaYV_XX -scalar(delta2_`pairwise'`pla'XX)*absdeltaDV_XX) 
701.                 }
702.                 else{
703.                 gen Phi2_`pairwise'`pla'XX = weights_XX*[(S_XX - ES_XX_D1*(1-Sbis_XX)/(1-ESbis_XX_D1))
> *inner_sumdelta12_XX -scalar(delta2_`pairwise'`pla'XX)*absdeltaD_XX]
704.                 }
705.                 // + Imbalanced panel adjustment: Adjust the IF
.                         //a. Adjust the denominator of the IF
.                 replace Phi2_`pairwise'`pla'XX = Phi2_`pairwise'`pla'XX/[scalar(PHt`pairwise'`pla'XX)*sca
> lar(EabsdeltaD_`pla'XX)]
706.                         //b. Replace the IF by 0 if Ht_XX==0
.                 replace Phi2_`pairwise'`pla'XX = 0 if Ht_XX==0  
707.                 replace Phi2_`pairwise'`pla'XX = . if S_XX==.   //Jan,25: mismatch between se of place
> bos with and without cluster(ID) solved.
708.                                 
.                 
.                 //save "dr_`pairwise'.dta", replace
.                 sum  Phi2_`pairwise'`pla'XX 
709.                 if ("`cluster'"!=""){ // Clustering the variance
710.                 cap drop Phi2_`pairwise'`pla'_cXX //I create a new variable, because I need the one wi
> thout clustering in the aggregation
711.                 bysort `cluster': egen Phi2_`pairwise'`pla'_cXX = total(Phi2_`pairwise'`pla'XX)
712.                 bysort `cluster': replace Phi2_`pairwise'`pla'_cXX=. if _n!=1|S_XX==.
713.                 replace Phi2_`pairwise'`pla'_cXX = Phi2_`pairwise'`pla'_cXX/scalar(N_bar_c_`pairwise'`
> pla'XX)
714.                 sum Phi2_`pairwise'`pla'_cXX   
715.                 }
716.         
.                 scalar sd_delta2_`pairwise'`pla'XX = r(sd)/sqrt(r(sum_w)) // sqrt(r(sum_w)) instead of r(
> N) same
717.                 scalar LB2_`pairwise'`pla'XX = scalar(delta2_`pairwise'`pla'XX) - 1.96*scalar(sd_delta
> 2_`pairwise'`pla'XX)
718.                 scalar UB2_`pairwise'`pla'XX = scalar(delta2_`pairwise'`pla'XX) + 1.96*scalar(sd_delta
> 2_`pairwise'`pla'XX)
719.                 
.                 //Now Let's store absdeltaD_t for the Influence function variable of the aggregated point
>  estimate
.                 cap drop absdeltaD_`pairwise'`pla'XX
720.                 gen absdeltaD_`pairwise'`pla'XX = absdeltaD_XX
721.                 // + Imbalanced panel adjustment: replace |deltaD_t| by |deltaD_t|*H_t in the aggreaga
> tion of the point estimates formula
.                 replace absdeltaD_`pairwise'`pla'XX  = 0 if Ht_XX == 0
722.                 replace absdeltaD_`pairwise'`pla'XX =  absdeltaD_`pairwise'`pla'XX*weights_XX //AbsDel
> ta_t*V_t
723. }
724. 
. if ("`exact_match'"==""&(`trimming'!=0)){
725. **************************************************************
. *Adjust N switchers and N stayers when trimming
. sum Sbis_XX [w = weights_XX] if trimmed_out_XX==1&Sbis_XX==0
726. local adj_nb_stayers = `r(sum_w)'
727. 
. sum Sbis_XX [w = weights_XX] if trimmed_out_XX==1&Sbis_XX==1
728. local adj_nb_switchers = `r(sum_w)'
729. 
. if (`as' == 1){
730. scalar Nstayers1_`pairwise'`pla'XX = scalar(Nstayers1_`pairwise'`pla'XX) - `adj_nb_stayers'
731. 
. scalar N_Switchers1_`pairwise'`pla'XX = scalar(N_Switchers1_`pairwise'`pla'XX) - `adj_nb_switchers'
732. }
733. 
. if (`was' == 1){
734. scalar Nstayers2_`pairwise'`pla'XX = scalar(Nstayers2_`pairwise'`pla'XX) - `adj_nb_stayers'
735. scalar N_Switchers2_`pairwise'`pla'XX = scalar(N_Switchers2_`pairwise'`pla'XX) - `adj_nb_switchers'
736. }
737. }
738. 
. }
739. //End of non-IV feasible estimation
. else{
740.         forvalues i=1/2{
741.         scalar delta`i'_`pairwise'`pla'XX  = . //0
742.         scalar sd_delta`i'_`pairwise'`pla'XX = .
743.         scalar LB`i'_`pairwise'`pla'XX = .
744.         scalar UB`i'_`pairwise'`pla'XX = .
745.         gen Phi`i'_`pairwise'`pla'XX = .
746.         
.         //If we are in gaps cases
.                 if (scalar(gap_`pairwise'`pla'XX) !=0){
747.                 scalar N_Switchers`i'_`pairwise'`pla'XX = .
748.                 scalar Nstayers`i'_`pairwise'`pla'XX = .
749.                 }
750.                 else{
751.         //If we are in only one type cases
.                 if (scalar(n_stayers_XX)<2){
752.                 scalar N_Switchers`i'_`pairwise'`pla'XX = _N - scalar(n_stayers_XX)
753.                 scalar Nstayers`i'_`pairwise'`pla'XX = scalar(n_stayers_XX)
754.                 }       
755.                 
.                 if (scalar(n_switchers_XX)==0){
756.                 scalar N_Switchers`i'_`pairwise'`pla'XX = 0
757.                 scalar Nstayers`i'_`pairwise'`pla'XX = _N
758.                 }       
759.         }
760.         }
761.         gen absdeltaD_`pairwise'`pla'XX = .
762.         gen S_`pairwise'`pla'XX = .
763.         scalar EabsdeltaD_`pairwise'`pla'XX = 0
764.         scalar P_`pairwise'`pla'XX = 0
765. }
766. }
767. ********************************************************************************
. **# Bookmark #3 IWAS
. ********************************************************************************
. if (`iwas' == 1){
768. cap drop absdeltaZV_XX
769. gen absdeltaZV_XX = absdeltaZ_XX*weights_XX 
770.           // Sample splitting : Cross-fitting.
.         if ("`cross_fitting'"!="0"){
771.         //Cross-fitting samples splitting: 
.         set seed 1234 //To ensure that the sample does not change when the code is ran multiple times. 
772.         cap drop rnd_sorter 
773.         gen rnd_sorter_XX = rnormal()
774.         *Sort by D1_XX and then the random variable to break ties
.         sort Z1_XX rnd_sorter_XX
775.         *Generate a new variable equal to 1 if the order is odd, 2 if even
.         gen cf_sample_id = 1 + mod(_n, `cross_fitting')
776.         }
777.         
. if (scalar(gap_`pairwise'`pla'XX)==0&scalar(n_switchersIV_`pla'XX)>0&scalar(n_stayersIV_`pla'XX)>10){ //S
> tart of IV feasible estimation
778. ************************************************
. 
. 
. /*******************************************************************
>         Call polynomials_generator here: Start
>         *******************************************************************/
. if ("`cross_validation'" == ""){
779. polynomials_generator, order(`order_1')   /* order(`order_1')*/      prefix(reg)         controls(`con
> trols') other_treatments(`other_treatments')      `pla' reduced_form
780.         local reg_vars_pol_XX        "`s(reg_pol_XX)'"
781.         
. polynomials_generator, order(`order_2')         prefix(logit_bis)         controls(`controls') other_trea
> tments(`other_treatments')     `pla' reduced_form
782.         local logit_bis_pol_XX       "`s(logit_bis_pol_XX)'"
783. polynomials_generator, order(`order_3')         prefix(logit_Plus)         controls(`controls') other_
> treatments(`other_treatments')    `pla' reduced_form
784.         local logit_Plus_pol_XX      "`s(logit_Plus_pol_XX)'"
785.         
. polynomials_generator, order(`order_4')         prefix(logit_Minus)         controls(`controls') other_tr
> eatments(`other_treatments')   `pla' reduced_form
786.         local logit_Minus_pol_XX     "`s(logit_Minus_pol_XX)'"
787.         
. polynomials_generator, order(`order_2')         prefix(reg)                 controls(`controls') other_tr
> eatments(`other_treatments') `pla' first_stage
788.         local reg_vars_pol_FSXX        "`s(reg_pol_XX)'"
789. }
790. else{
791.         
. polynomials_generator, order(`reg_order')         prefix(reg)         controls(`controls') other_treatmen
> ts(`other_treatments') `pla' reduced_form
792. polynomials_generator, order(`logit_bis_order')   prefix(logit_bis)   controls(`controls') other_treat
> ments(`other_treatments') `pla' reduced_form
793. polynomials_generator, order(`logit_Plus_order')  prefix(logit_Plus)  controls(`controls') other_treat
> ments(`other_treatments') `pla' reduced_form
794. polynomials_generator, order(`logit_Minus_order') prefix(logit_Minus) controls(`controls') other_treat
> ments(`other_treatments') `pla' reduced_form
795. 
.         local reg_vars_pol_XX        "`s(reg_pol_XX)'"
796.         local logit_bis_pol_XX       "`s(logit_bis_pol_XX)'"
797.         local logit_Plus_pol_XX      "`s(logit_Plus_pol_XX)'"
798.         local logit_Minus_pol_XX     "`s(logit_Minus_pol_XX)'"
799. 
.         //For FS
.         local reg_order_FS = scalar(reg_order_FS)
800. polynomials_generator, order(`reg_order_FS')         prefix(reg)         controls(`controls') other_tr
> eatments(`other_treatments') `pla' first_stage
801.         local reg_vars_pol_FSXX        "`s(reg_pol_XX)'"
802.         
. //di as red "order reg FS: " scalar(reg_order_FS)
. }
803. 
.         /*******************************************************************
>         Call polynomials_generator here: End
> ******************************************************************************/ 
.         
. cap drop innerSumIV_num_XX
804. //cap drop absdeltaZ_XX
. 
. cap drop SIbis_XX
805. cap drop SIPlus_XX
806. cap drop SIMinus_XX
807. 
.         //gen absdeltaZ_XX = SI_XX*deltaZ_XX
.         sum absdeltaZV_XX //Weights
808.         scalar EabsdeltaZ_`pairwise'`pla'XX = r(mean)
809.         
.     gen SIbis_XX = (SI_XX!=0&SI_XX!=.) 
810.         gen SIPlus_XX = (SI_XX==1)
811.         gen SIMinus_XX = (SI_XX==-1)
812.         
. cap drop Phi_Y_`pairwise'`pla'XX
813. cap drop Phi_D_`pairwise'`pla'XX
814. cap drop Phi3_`pairwise'`pla'XX
815. 
. 
. /************************************************       
> o. Preliminaries: Perform the logit regressions
> ************************************************/
. 
.         // 1. Estimate P(SI = 0|Z_1) 
.         cap drop S_IV0_XX
816.         gen S_IV0_XX = 1-SIbis_XX
817. if ("`exact_match'"==""){
818. 
.         cap logit S_IV0_XX `logit_bis_pol_XX'     , asis // `varsIV_pol_XX'
819.         if (_rc==430){
820.                                 //di as error "Warning: convergence not achieved."
.                         }
821.         predict PS_IV0Z1_XX , pr asif
822.         //Convention Logit STATA R
.         replace PS_IV0Z1_XX=0 if PS_IV0Z1_XX<=10^(-10)
823.         
.         if ("`cross_fitting'" != "0"){
824.                         cap logit S_IV0_XX `logit_bis_pol_XX'   if  cf_sample_id != 1 , asis
825.                         predict cf_PS_IV0Z1_XX if cf_sample_id == 1, pr asif
826.                         
.                         forvalues cf_id = 2/`cross_fitting'{
827.                                 cap logit S_IV0_XX `logit_bis_pol_XX'   if  cf_sample_id != `cf_id' , 
> asis
828.                                 tempvar PS_IV0Z1_`cf_id'XX
829.                                 predict `PS_IV0Z1_`cf_id'XX' if cf_sample_id == `cf_id', pr asif
830.                                 
.                                 replace cf_PS_IV0Z1_XX = `PS_IV0Z1_`cf_id'XX'  if cf_sample_id == `cf_id'
831.                         }
832.                 
.                         //Convention Logit STATA R
.                 replace cf_PS_IV0Z1_XX=0 if cf_PS_IV0Z1_XX<=10^(-10)
833.                         //Trimming
.                         gen trimmed_out_XX = 1 if (cf_PS_IV0Z1_XX <`trimming')&cf_PS_IV0Z1_XX!=.
834.                         replace cf_PS_IV0Z1_XX =. if trimmed_out_XX == 1 
835.         }
836.         else{
837.                 //Trimming
.                         gen trimmed_out_XX = 1 if (PS_IV0Z1_XX <`trimming')&PS_IV0Z1_XX!=.
838.                         replace PS_IV0Z1_XX =. if trimmed_out_XX == 1 
839.         }
840. }
841. else{           //This is for the IF and point estimate of the was when we have discrete treatment, in
> stead of using logit use regressions
842.         
.                 //Estimation of 1-E(SI|Z1) = P(SI = 0|Z_1) in exact_match case
.                 reg SIbis_XX `reg_vars_pol_XX'   
843.                 predict ESIbis_XX_Z1, xb
844.                 //Estimation of  \hat{E}(SI+-SI-|Z1) 
.                 reg SI_XX `reg_vars_pol_XX'   
845.                 predict ESI_XX_Z1 , xb  
846.         }       
847.         //2. P(SI=0) //For PS and DR-BASED APPROACHES
.         sum S_IV0_XX 
848.         scalar PS_IV0_`pla'XX = r(mean)
849.         
.         //3. P(SI+=1|Z_1), P(SI-=1|Z_1) (For \hat{E}(SI+-SI-|Z1)), P(SI+=1) and P(SI-=1) //For the influe
> nce function, PS and DR
. 
.        cap drop  PSIPlus1Z1_XX
850.            cap drop  PSIMinus1Z1_XX
851.                    
.            foreach suffix in  "Minus" "Plus"{
852.                 cap drop trimmed_out2_XX
853.                 cap drop  PSI`suffix'1Z1_XX
854.                //1. Estimate P(SI`suffix'=1)
.                    count if SI`suffix'_XX ==1
855.                    scalar nb_SwitchersI`suffix'`pla'XX = r(N) 
856.                    scalar PSI`suffix'1`pla'XX = scalar(nb_SwitchersI`suffix'`pla'XX)/scalar(N_`pla'XX)
>    //P(SI+=1) and P(SI-=1) 
857.                    
. 
.                    
.                    
.                    if (scalar(PSI`suffix'1`pla'XX)==0){ //I do the regression iff there is at least one s
> witcher up/down.
858.                                    
.              //create it and set it to zero, since I will call it outside this loop for the dr method.
.                    gen PSI`suffix'1Z1_XX = 0
859.                    gen cf_PSI`suffix'1Z1_XX = 0
860.                    }
861.                    else{ 
862.                         if ("`exact_match'"==""){
863.                         
. 
.                                 capture logit SI`suffix'_XX `logit_`suffix'_pol_XX'    , asis
864.                                 if (_rc==430){
865.                                         //di as error "Warning: convergence not achieved."
.                                 }
866.                                 
.                                 predict PSI`suffix'1Z1_XX , pr asif //P(SI+=1|Z_1) and P(SI-=1|Z_1)
867.                                 //Convention Logit STATA R
.                                 replace PSI`suffix'1Z1_XX=0 if PSI`suffix'1Z1_XX<=10^(-10)
868.                         
.                         if ("`cross_fitting'" != "0"){
869.                                 cap drop cf_PSI`suffix'1Z1_XX
870.                                 
.                                 cap logit SI`suffix'_XX `logit_`suffix'_pol_XX'   if  cf_sample_id !=1 , 
> asis
871.                                 predict cf_PSI`suffix'1Z1_XX if cf_sample_id ==1, pr asif  
872.                                 
.                                 forvalues cf_id = 2/`cross_fitting'{
873.                                 cap logit SI`suffix'_XX `logit_`suffix'_pol_XX'   if  cf_sample_id != 
> `cf_id' , asis
874.                                 tempvar PSI`suffix'1Z1_`cf_id'XX
875.                                 predict `PSI`suffix'1Z1_`cf_id'XX' if cf_sample_id == `cf_id', pr asif
>   
876.                                 replace cf_PSI`suffix'1Z1_XX = `PSI`suffix'1Z1_`cf_id'XX' if cf_sample
> _id == `cf_id'
877.                         }
878.                 
.                         //Convention Logit STATA R
.                 replace cf_PSI`suffix'1Z1_XX =0 if cf_PSI`suffix'1Z1_XX <=10^(-10)
879.                         
.                         *gen trimmed_out2_XX = 1 if ( cf_PSI`suffix'1Z1_XX<`trimming_down'| cf_PSI`suffix
> '1Z1_XX>`trimming_up')& cf_PSI`suffix'1Z1_XX!=.
.                         *replace  cf_PSI`suffix'1Z1_XX = . if trimmed_out2_XX == 1
.                         }
880.                         /*else{
>                         gen trimmed_out2_XX = 1 if (PSI`suffix'1Z1_XX<`trimming_down'| PSI`suffix'1Z1_XX>
> `trimming_up')& PSI`suffix'1Z1_XX!=.
>                         replace  PSI`suffix'1Z1_XX = . if trimmed_out2_XX == 1
>                         }*/
.                         } //end of if exact_match
881.                    }
882.            }
883.            
. /**************************************************************************
>             1. COMPUTING THE POINT ESTIMATE \hat{delta}_IV: START
> **************************************************************************/
.         //i. Estimation of  \hat{E}(deltaY|Z1, SI=0)
.         cap drop meandeltaY_predIV_XX
884.         reg deltaY_XX `reg_vars_pol_XX'     if SI_XX==0
885.         predict meandeltaY_predIV_XX , xb 
886.         //scalar Nstayers3_`pairwise'XX  = e(N) 
.         
.         cap drop innerSumIV_num_XX
887.         gen innerSumIV_num_XX = deltaY_XX - meandeltaY_predIV_XX
888.         
.         //The nuisance function E(\deltaY - \mu^Y_0(Z_1, D_1)) when cross-fitting is requested.
.         if ("`cross_fitting'" !="0") {
889.                 cap drop cf_innerSumIV_num_XX
890.                 gen cf_innerSumIV_num_XX = . 
891.                 
.                 reg deltaY_XX `reg_vars_pol_XX'   if SI_XX==0 & cf_sample_id != 1
892.                 tempvar mean_pred_1XX
893.                 predict `mean_pred_1XX' if cf_sample_id ==1, xb
894.                 replace cf_innerSumIV_num_XX = deltaY_XX - `mean_pred_1XX' if cf_sample_id ==1 
895.                 
.                 forvalues cf_id = 2/`cross_fitting'{
896.                         reg deltaY_XX `reg_vars_pol_XX'   if SI_XX==0 & cf_sample_id != `cf_id'
897.                         tempvar mean_pred_`cf_id'XX
898.                         predict `mean_pred_`cf_id'XX' if cf_sample_id == `cf_id', xb // Remark: We do 
> cf_sample_id == 2, instead of cf_sample_id == 1, because we do cross-fitting. We want to use \deltaY - \m
> u^Y(1)_0(Z_1, D_1) when we estimate \delta^{(2)}.
899.                         replace cf_innerSumIV_num_XX = deltaY_XX - `mean_pred_`cf_id'XX' if cf_sample_
> id == `cf_id' // {\deltaY - \mu^Y_0(Z_1, D_1)}^(2) or  {\deltaY - \mu^Y_0(Z_1, D_1)}^(1)                 
>          
900.                 }               
901.         }
902.         //ii. Estimation of \hat{E}(deltaD|Z1, SI=0)
.         cap drop meandeltaD_predIV_XX
903.         reg deltaD_XX `reg_vars_pol_FSXX'      if SI_XX==0
904.         predict meandeltaD_predIV_XX , xb 
905.         
.         cap drop innerSumIV_denom_`pairwise'`pla'XX
906.         gen innerSumIV_denom_`pairwise'`pla'XX = deltaD_XX - meandeltaD_predIV_XX
907.         
.         //The nuisance function E(\deltaD - \mu^D_0(Z_1, D_1)) when cross-fitting is requested.
.         if ("`cross_fitting'" !="0") {
908.                 cap drop cf_innerSumIV_denom_`pairwise'`pla'XX
909.                 gen cf_innerSumIV_denom_`pairwise'`pla'XX = . 
910.                 
.                 // {\deltaD - \mu^D_0(Z_1, D_1)}^(2)
.                 // {\deltaD - \mu^D_0(Z_1, D_1)}^(1)    
.                         reg deltaD_XX `reg_vars_pol_FSXX'      if SI_XX==0 & cf_sample_id !=1
911.                         tempvar meandeltaD_predIV_1XX
912.                         predict `meandeltaD_predIV_1XX' if cf_sample_id ==1, xb 
913.                         replace cf_innerSumIV_denom_`pairwise'`pla'XX = deltaD_XX - `meandeltaD_predIV
> _1XX' if cf_sample_id ==1 
914.                         
.                 forvalues cf_id = 2/`cross_fitting'{
915.                         reg deltaD_XX `reg_vars_pol_FSXX'      if SI_XX==0 & cf_sample_id != `cf_id'
916.                         tempvar meandeltaD_predIV_`cf_id'XX
917.                         predict `meandeltaD_predIV_`cf_id'XX' if cf_sample_id == `cf_id', xb // Remark
> : We do cf_sample_id == 2, instead of cf_sample_id == 1, because we do cross-fitting. We want to use \del
> taY - \mu^Y(1)_0(Z_1, D_1) when we estimate \delta^{(2)}.
918.                         replace cf_innerSumIV_denom_`pairwise'`pla'XX = deltaD_XX - `meandeltaD_predIV
> _`cf_id'XX' if cf_sample_id ==`cf_id'
919.                 }
920.                 
.                         
.         }       
921. 
. /**************************************************************************
>                            1.1 IF REGRESSION-BASED APPROACH 
> **************************************************************************/
. if ("`estimation_method'" == ""|"`estimation_method'" == "ra"){
922.         
.         replace innerSumIV_num_XX = SI_XX*innerSumIV_num_XX
923.         sum innerSumIV_num_XX 
924.         scalar num_deltaIV`pairwise'`pla'XX = r(mean)
925.  
.     replace innerSumIV_denom_`pairwise'`pla'XX = SI_XX*innerSumIV_denom_`pairwise'`pla'XX
926.         sum innerSumIV_denom_`pairwise'`pla'XX 
927.         scalar denom_deltaIV`pairwise'`pla'XX = r(mean)
928.  }
929. 
. /**************************************************************************
>                            1.2 IF PS or DR-BASED APPROACH 
> **************************************************************************/
.         
.                         if ("`estimation_method'" == "ps"){
930.                                 
.                         //1. The numerator      
.                         
.                          //1.1. Compute deltaY*[(PSIPlus1Z1_XX-PSIMinus1Z1_XX)*PS_IV0_XX)/(PS_IV0Z1_XX)]
.                          cap drop deltaYP_IVXX
931.                          gen deltaYP_IVXX = deltaY_XX*[(PSIPlus1Z1_XX-PSIMinus1Z1_XX)/PS_IV0Z1_XX*(sca
> lar(PS_IV0_`pla'XX))]
932.                          sum deltaYP_IVXX  if SIbis_XX==0
933.                          scalar mean_deltaYP_IV`pla'XX = r(mean)
934.                          
.                          //1.2 Compute sgn(deltaZ)*deltaY = SI_XX*deltaY_XX: Remember SI_XX = (deltaZ_XX>
> 0) - (deltaZ_XX<0)
.                          cap drop prod_sgndeltaZdeltaY_XX
935.                          gen prod_sgndeltaZdeltaY_XX = SI_XX*deltaY_XX
936.                          sum prod_sgndeltaZdeltaY_XX 
937.                          scalar mean_sgndeltaZdeltaY_`pla'XX = r(mean)
938.                          
.                          //1.3
.                          scalar num_deltaIV`pairwise'`pla'XX = scalar(mean_sgndeltaZdeltaY_`pla'XX) - sca
> lar(mean_deltaYP_IV`pla'XX)
939. 
.                         //2. The denominator    
.                         
.                      //2.1. Compute deltaD*[(PSIPlus1Z1_XX-PSIMinus1Z1_XX)*PS_IV0_XX)/(PS_IV0Z1_XX)]
.                          cap drop deltaDP_IVXX
940.                          gen deltaDP_IVXX = deltaD_XX*[(PSIPlus1Z1_XX-PSIMinus1Z1_XX)/PS_IV0Z1_XX*(sca
> lar(PS_IV0_`pla'XX))]
941.                          sum deltaDP_IVXX  if SIbis_XX==0
942.                          scalar mean_deltaDP_IV`pla'XX = r(mean)        
943.                          
.                         //2.2 Compute sgn(deltaZ)*deltaD = SI_XX*deltaD_XX
.                          cap drop prod_sgndeltaZdeltaD_XX
944.                          gen prod_sgndeltaZdeltaD_XX = SI_XX*deltaD_XX
945.                          sum prod_sgndeltaZdeltaD_XX 
946.                          scalar mean_sgndeltaZdeltaD_`pla'XX = r(mean)  
947.                          
.                     //2.3
.                         scalar denom_deltaIV`pairwise'`pla'XX = scalar(mean_sgndeltaZdeltaD_`pla'XX) - sc
> alar(mean_deltaDP_IV`pla'XX)
948.                         }
949.                 
.                 if ("`estimation_method'" == "dr"){
950.                         
.                         //2. The denominatoR: We need it even when cross-fitting is specified.
.                         cap drop dr_IVdeltaD_XX
951.                 gen dr_IVdeltaD_XX = weights_XX*(SI_XX - [(PSIPlus1Z1_XX - PSIMinus1Z1_XX)/PS_IV0Z1_XX
> ]*(1-SIbis_XX))*innerSumIV_denom_`pairwise'`pla'XX if SIbis_XX == 0
952.                         replace  dr_IVdeltaD_XX = weights_XX*(SI_XX)*innerSumIV_denom_`pairwise'`pla'X
> X if SIbis_XX == 1
953.                         
.                         
.                         sum dr_IVdeltaD_XX //if SIbis_XX == 1
954.                         scalar denom_deltaIV`pairwise'`pla'XX = r(sum)
955.                         
.                         if ("`cross_fitting'" == "0"){
956.                         //1. The numerator      
.                         cap drop dr_IVdeltaY_XX
957.                 gen dr_IVdeltaY_XX = weights_XX*(SI_XX - [(PSIPlus1Z1_XX - PSIMinus1Z1_XX)/PS_IV0Z1_XX
> ]*(1-SIbis_XX))*innerSumIV_num_XX if SIbis_XX == 0
958.                         replace dr_IVdeltaY_XX = weights_XX*(SI_XX)*innerSumIV_num_XX if SIbis_XX == 1
959.                         
.                         sum dr_IVdeltaY_XX  //if SIbis_XX == 1
960.                         scalar num_deltaIV`pairwise'`pla'XX = r(sum) 
961. 
.                         }
962.                         else{
963.                                         //1. The numerator      
.                                 cap drop cf_dr_IVdeltaY_XX
964.                                 gen cf_dr_IVdeltaY_XX = weights_XX*(SI_XX - [(cf_PSIPlus1Z1_XX - cf_PS
> IMinus1Z1_XX)/cf_PS_IV0Z1_XX]*(1-SIbis_XX))*cf_innerSumIV_num_XX if SIbis_XX == 0
965.                                 replace cf_dr_IVdeltaY_XX = weights_XX*(SI_XX)*cf_innerSumIV_num_XX if
>  SIbis_XX == 1
966. 
.                                 //2. The denominator    
.                                 cap drop dr_IVdeltaD_XX
967.                                 gen cf_dr_IVdeltaD_XX = (SI_XX - [(cf_PSIPlus1Z1_XX - cf_PSIMinus1Z1_X
> X)/cf_PS_IV0Z1_XX]*(1-SIbis_XX))*cf_innerSumIV_denom_`pairwise'`pla'XX if SIbis_XX == 0
968.                                 replace  cf_dr_IVdeltaD_XX = (SI_XX)*cf_innerSumIV_denom_`pairwise'`pl
> a'XX if SIbis_XX == 1
969.                                 
.                                 
.                                 //Initialize the point estimate's components: 
.                                                 scalar RF_`pairwise'`pla'XX = 0
970.                                                 scalar FS_`pairwise'`pla'XX = 0
971.                                                 scalar cf_sum_weights_`pairwise'`pla'XX = 0 
972.                                                 
.                                 forvalues cf_id = 1/`cross_fitting'{
973.                                         
.                                 sum cf_dr_IVdeltaY_XX if cf_sample_id == `cf_id' //&SIbis_XX == 1
974.                                 scalar num_deltaIV_`cf_id'_`pairwise'`pla'XX = r(sum) 
975.                                 
.                                 sum cf_dr_IVdeltaD_XX if cf_sample_id == `cf_id' //&SIbis_XX == 1
976.                                 scalar denom_deltaIV_`cf_id'_`pairwise'`pla'XX = r(sum)
977.                                 
.                                 //The point estimates : (\delta_3^{(k)})_{k=1, 2}
.                                 //scalar delta3_`cf_id'_`pairwise'`pla'XX = scalar(num_deltaIV_`cf_id'_`p
> airwise'`pla'XX)/scalar(denom_deltaIV_`cf_id'_`pairwise'`pla'XX)               
.                                 
.                                 //The weights components : None.
.                                 sum absdeltaZV_XX /*SIbis_XX*/ if cf_sample_id == `cf_id'
978.                                 scalar cf_deltaZ_`cf_id'_`pairwise'`pla'XX = r(sum)
979.                                 
.                                 if (scalar(cf_deltaZ_`cf_id'_`pairwise'`pla'XX) == 0){
980.                                         scalar RF_`cf_id'_`pairwise'`pla'XX  = 0 
981.                                         scalar FS_`cf_id'_`pairwise'`pla'XX  = 0 
982.                                 }
983.                                 else{
984.                                         scalar RF_`cf_id'_`pairwise'`pla'XX = scalar(num_deltaIV_`cf_i
> d'_`pairwise'`pla'XX) // /scalar(cf_deltaZ_`cf_id'_`pairwise'`pla'XX)             
985.                                         scalar FS_`cf_id'_`pairwise'`pla'XX = scalar(denom_deltaIV_`cf
> _id'_`pairwise'`pla'XX) // /scalar(cf_deltaZ_`cf_id'_`pairwise'`pla'XX)           the division is simplif
> ied by the weighting.
986.                                                                                 
.                                 }
987.                                 
.                                 //Increment the point estimate's components: 
.                                 scalar cf_sum_weights_`pairwise'`pla'XX = scalar(cf_sum_weights_`pairwise
> '`pla'XX) + scalar(cf_deltaZ_`cf_id'_`pairwise'`pla'XX)
988.                                 scalar RF_`pairwise'`pla'XX = scalar(RF_`pairwise'`pla'XX) + scalar(RF
> _`cf_id'_`pairwise'`pla'XX) 
989.                                 scalar FS_`pairwise'`pla'XX = scalar(FS_`pairwise'`pla'XX) + scalar(FS
> _`cf_id'_`pairwise'`pla'XX) 
990.                                 }
991.                         }
992.         
.                 }
993. 
.  
.  //Compute the point estimate by scalar(num_deltaIV)/scalar(denom_deltaIV)
.         if ("`cross_fitting'" == "0"){ 
994.                 scalar delta3_`pairwise'`pla'XX = scalar(num_deltaIV`pairwise'`pla'XX)/scalar(denom_de
> ltaIV`pairwise'`pla'XX)
995.         }
996.         else{
997.                 scalar delta3_`pairwise'`pla'XX = scalar(RF_`pairwise'`pla'XX)/scalar(FS_`pairwise'`pl
> a'XX) //  = DR_RF/DR_FS
998.                 //di as error "FS `pairwise'`pla' = " scalar(FS)
.                 
.                 scalar denom_deltaIV`pairwise'`pla'XX = scalar(FS_`pairwise'`pla'XX) //Use the DR_FS as w
> eights.
999.         }
1000.  //a. For aggreagation + correcting imbalance panels
.  scalar denom_deltaIV`pairwise'`pla'XX  = scalar(denom_deltaIV`pairwise'`pla'XX)*scalar(PHt`pairwise'`pla
> 'XX)
1001.  scalar denom_deltaIV_sum_`pla'XX = scalar(denom_deltaIV_sum_`pla'XX ) + scalar(denom_deltaIV`pairwis
> e'`pla'XX) //denom_deltaIV_sum_`pla'XX is initialized outside of this program
1002.  //replace innerSumIV_denom_`pairwise'`pla'XX = innerSumIV_denom_`pairwise'`pla'XX*weights_XX //\hat{
> \pi}_{i,t}V_t
.  replace innerSumIV_denom_`pairwise'`pla'XX = 0  if Ht_XX == 0
1003.  /**************************************************************************
>             2. COMPUTING the variance of \hat{delta}_IV: START
> **************************************************************************/
.          //i. Compute phi_Y
.          sum innerSumIV_num_XX 
1004.          scalar delta_Y_`pairwise'`pla'XX = r(mean)
1005.          //scalar delta_Y_`pairwise'`pla'XX = r(mean)/scalar(EabsdeltaZ_`pairwise'`pla'XX)
. 
.          //reg deltaY_XX `vars_pol_XX' if SI_XX==0 
.          reg deltaY_XX `reg_vars_pol_XX'     if SI_XX==0 // meandeltaY_predIV_XX
1006.          predict mean_pred_Y_IV_XX , xb 
1007.          
.          if ("`exact_match'"==""){
1008.          gen Phi_Y_`pairwise'`pla'XX = (SI_XX - (PSIPlus1Z1_XX-PSIMinus1Z1_XX)*(1-SIbis_XX)/(PS_IV0Z1
> _XX))*(deltaY_XX - mean_pred_Y_IV_XX) - scalar(delta_Y_`pairwise'`pla'XX)*absdeltaZ_XX
1009.          }
1010.          else{
1011.          gen Phi_Y_`pairwise'`pla'XX = (SI_XX - (ESI_XX_Z1)*(1-SIbis_XX)/(1-ESIbis_XX_Z1))*(deltaY_XX
>  - mean_pred_Y_IV_XX) - scalar(delta_Y_`pairwise'`pla'XX)*absdeltaZ_XX
1012.          }
1013.          replace Phi_Y_`pairwise'`pla'XX = Phi_Y_`pairwise'`pla'XX/scalar(EabsdeltaZ_`pairwise'`pla'X
> X)*scalar(PHt`pairwise'`pla'XX )
1014. 
.          //ii. Compute phi_D
.          sum innerSumIV_denom_`pairwise'`pla'XX
1015.          scalar delta_D_`pairwise'`pla'XX = r(mean)
1016.                 //b. For aggreagation + correcting imbalance panels
.                  replace innerSumIV_denom_`pairwise'`pla'XX = innerSumIV_denom_`pairwise'`pla'XX*weights_
> XX //\hat{\pi}_{i,t}V_t
1017.          
.          //reg deltaD_XX `vars_pol_XX' if SI_XX==0 
.          reg deltaD_XX `reg_vars_pol_FSXX'     if SI_XX==0 
1018.          predict mean_pred_D_IV_XX , xb 
1019.          
.          if ("`exact_match'"==""){       
1020.          gen Phi_D_`pairwise'`pla'XX = (SI_XX - (PSIPlus1Z1_XX-PSIMinus1Z1_XX)*(1-SIbis_XX)/(PS_IV0Z1
> _XX))*(deltaD_XX - mean_pred_D_IV_XX) - scalar(delta_D_`pairwise'`pla'XX )*absdeltaZ_XX
1021.          }
1022.          else{
1023.          gen Phi_D_`pairwise'`pla'XX = (SI_XX - (ESI_XX_Z1)*(1-SIbis_XX)/(1-ESIbis_XX_Z1))*(deltaD_XX
>  - mean_pred_D_IV_XX) - scalar(delta_D_`pairwise'`pla'XX )*absdeltaZ_XX    
1024.          }
1025.          replace Phi_D_`pairwise'`pla'XX = Phi_D_`pairwise'`pla'XX/scalar(EabsdeltaZ_`pairwise'`pla'X
> X)*scalar(PHt`pairwise'`pla'XX )
1026.          
.          //iii. Now compute Phi_IV
.          gen Phi3_`pairwise'`pla'XX = weights_XX*(Phi_Y_`pairwise'`pla'XX - scalar(delta3_`pairwise'`pla'
> XX)*Phi_D_`pairwise'`pla'XX)/scalar(delta_D_`pairwise'`pla'XX )
1027.          replace Phi3_`pairwise'`pla'XX = 0 if Ht_XX == 0 
1028.          replace Phi3_`pairwise'`pla'XX = . if SI_XX == . 
1029.          
.          **Adding AR CI:
.          foreach a in "Y" "D" {
1030.          replace Phi_`a'_`pairwise'`pla'XX= 0 if Ht_XX == 0 
1031.          replace Phi_`a'_`pairwise'`pla'XX = . if SI_XX == . 
1032.          }
1033.          
.         sum Phi3_`pairwise'`pla'XX 
1034.         //scalar mean_IF3`pairwise'`pla' = r(mean) //check if the mean is close to zero when I will o
> utput the simulations (to be drop in the final version)
.         
.         if ("`cluster'"!=""){ // Clustering the variance //CLUSTER OPTION
1035.                 cap drop Phi3_`pairwise'`pla'_cXX //I create a new variable, because I need the one w
> ithout clustering in the aggregation
1036.                 bysort `cluster': egen Phi3_`pairwise'`pla'_cXX = total(Phi3_`pairwise'`pla'XX)
1037.                 bysort `cluster': replace Phi3_`pairwise'`pla'_cXX=. if _n!=1|SI_XX==.
1038.                 replace Phi3_`pairwise'`pla'_cXX = Phi3_`pairwise'`pla'_cXX/scalar(N_bar_c_`pairwise'
> `pla'XX)
1039.                 sum Phi3_`pairwise'`pla'_cXX   //we use the weights of the cluster here
1040.         }
1041.                 
.         scalar sd_delta3_`pairwise'`pla'XX = r(sd)/sqrt(r(sum_w))
1042. 
.         scalar LB3_`pairwise'`pla'XX = scalar(delta3_`pairwise'`pla'XX) - 1.96*scalar(sd_delta3_`pairwise
> '`pla'XX)
1043.         scalar UB3_`pairwise'`pla'XX = scalar(delta3_`pairwise'`pla'XX) + 1.96*scalar(sd_delta3_`pair
> wise'`pla'XX)
1044.         
. **************************************************************
. if ("`exact_match'"==""){
1045. *Adjust N switchers and N stayers in cases of trimming  (2025)
. sum SIbis_XX [w = weights_XX] if trimmed_out_XX==1&SIbis_XX==0
1046. local adj_nb_stayers = `r(sum_w)'
1047. 
. sum SIbis_XX [w = weights_XX] if trimmed_out_XX==1&SIbis_XX==1
1048. local adj_nb_switchers = `r(sum_w)'
1049. 
. scalar Nstayers3_`pairwise'`pla'XX = scalar(Nstayers3_`pairwise'`pla'XX) - `adj_nb_stayers'
1050. scalar N_Switchers3_`pairwise'`pla'XX = scalar(N_Switchers3_`pairwise'`pla'XX) - `adj_nb_switchers'
1051. }
1052. }
1053. //End of IV feasible estimation
. else{
1054. 
.         scalar delta3_`pairwise'`pla'XX  = . //0
1055.         scalar delta_Y_`pairwise'`pla'XX  = .  //DS: adding ar_ci
1056.         scalar delta_D_`pairwise'`pla'XX  = . //DS: adding ar_ci
1057.         scalar sd_delta3_`pairwise'`pla'XX = .
1058.         scalar LB3_`pairwise'`pla'XX = .
1059.         scalar UB3_`pairwise'`pla'XX = .
1060.         scalar denom_deltaIV`pairwise'`pla'XX =0
1061.         gen Phi3_`pairwise'`pla'XX = .
1062.         gen Phi_Y_`pairwise'`pla'XX = . //DS: adding ar_ci
1063.         gen Phi_D_`pairwise'`pla'XX = . //DS: adding ar_ci
1064.         gen innerSumIV_denom_`pairwise'`pla'XX = .
1065.         
.         //If we are in gaps cases
.                 if (scalar(gap_`pairwise'`pla'XX) !=0){
1066.                 scalar N_Switchers3_`pairwise'`pla'XX = .
1067.                 scalar Nstayers3_`pairwise'`pla'XX = .
1068.                 }
1069.                 else{
1070.         //If we are in only one type cases
.                 if (scalar(n_stayersIV_`pla'XX)<2){
1071.                 scalar N_Switchers3_`pairwise'`pla'XX = _N - scalar(n_stayersIV_`pla'XX)
1072.                 scalar Nstayers3_`pairwise'`pla'XX = scalar(n_stayersIV_`pla'XX)
1073.                 }       
1074.                 
.                 if (scalar(n_switchersIV_`pla'XX)==0){
1075.                 scalar N_Switchers3_`pairwise'`pla'XX = 0
1076.                 scalar Nstayers3_`pairwise'`pla'XX = _N
1077.                 }
1078.                 }
1079. }
1080. } 
1081. } //End of else from if (_N==0)
1082. 
. if (`bootstrap'==0){ //This is only needed to comupte the aggregated IFs.
1083. sort ID_XX
1084. ///////I will merge the datasets here! This is to compute the aggregated influence function
> //di as error "Here `pairwise':`data_1XX'"
. save "data_test`pairwise'.dta", replace
1085. cap drop absdeltaD_errorXX //This in case was is not requested: just to avoid doing many ifs.
1086. gen absdeltaD_errorXX=.
1087. cap drop S_errorXX 
1088. gen S_errorXX=.
1089. cap drop innerSumIV_denom_errorXX
1090. gen innerSumIV_denom_errorXX = .
1091. //Keep ID_XX, Phi1_t, Phi2_t, S_t, and absdeltaD_t, P_`pairwise'XX
. keep ID_XX Phi?_*XX S_*XX absdeltaD_*XX used_in_*_XX innerSumIV_denom_*XX `cluster' weights_XX weights_cX
> X Phi*XX  //Phi* //Ster_XX ESbis_XX_D1 meanS_over_deltaD_XX inner_sumdelta12_XX mean_pred_XX deltaY_XX de
> ltaD_XX outOfBounds_XX
1092. drop absdeltaD_errorXX
1093. drop S_errorXX
1094. drop innerSumIV_denom_errorXX
1095. //di as erro "`pla' `pairwise'"
. merge 1:1 ID_XX using "`data_1XX'.dta", gen(merge_`pairwise'`pla'XX)
1096. 
. //Note Doulo: The merge_`pairwise'XX variable will be very usefull if we need afterward to give informati
> on about which units are used in each DID when for instance we have unbalanced panel.
. 
. if ("`pla'" == "" ) {
1097. tempfile data_1XX
1098. save "`data_1XX'.dta", replace
1099. }
1100. else{
1101. tempfile data_1plaXX
1102. save "`data_1plaXX'.dta", replace       
1103. }
1104. }
1105. if ("`pla'" == "" ) glob data_1XX = "`data_1XX'"
1106. else glob data_1plaXX = "`data_1plaXX'"
1107. //> CORE restore
. use "`OG_dataPathcore'.dta", clear
1108. 
. }
1109. //End of quietly
. 
. end

