.         forvalues p = 2/`=max_T'{
608.                 
.         //as: Phi1^{T>2}
.         if (`as_XX' == 1){
609.                 //Effects
.                 replace Phi1_`p'XX = [scalar(P_`p'XX)*Phi1_`p'XX + (scalar(delta1_`p'XX) - scalar(delta1_
> 1XX))*(S_`p'XX - scalar(P_`p'XX))]/scalar(PS_sum_XX)
610.                 local Phi1_ts_XX `Phi1_ts_XX' Phi1_`p'XX
611.         }
612.         
.         //was: Phi2^{T>2}
.         if (`was_XX' == 1){
613.                 
.                 //Effects
.                 replace Phi2_`p'XX = [scalar(EabsdeltaD_`p'XX)*Phi2_`p'XX + (scalar(delta2_`p'XX) - scala
> r(delta2_1XX))*(absdeltaD_`p'XX - scalar(EabsdeltaD_`p'XX))]/scalar(EabsdeltaD_sum_XX)
614.                 
.                 ////tEST
>                 sum  Phi2_`p'XX
615.                 //scalar mean_IF2bis_`p' = r(mean)
.                 ////
>                 local Phi2_ts_XX `Phi2_ts_XX' Phi2_`p'XX
616.         }
617.                 
