707.                         gegen not_to_useD_XX = rownonmiss(`Phi_D_ts_XX')
708.                         replace Phi_D_XX =. if not_to_useD_XX==0
709. 
.                         if ("`cluster'"!=""){
710.                                  ar_ci, ifrf(Phi_Y_XX) iffs(Phi_D_XX) ///
>                                         rf(`=scalar(delta_Y_1XX)') fs(`=scalar(delta_D_1XX)') ///
>                                         cluster(`cluster') level(95) weights(weights_XX)
711.                         }
712.                         else{
713.                                  ar_ci, ifrf(Phi_Y_XX) iffs(Phi_D_XX) ///
>                                         rf(`=scalar(delta_Y_1XX)') fs(`=scalar(delta_D_1XX)') ///
>                                         level(95) weights(weights_XX)
714.                         }
715.                         scalar ar_lb_1XX = r(lb)
716.                         scalar ar_ub_1XX = r(ub)
717.                         local  ar_type_1XX = "`r(ci_type)'"
718.                 }
719.         }
