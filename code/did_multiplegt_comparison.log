. *This program estimates the three estimators (as, was, iv-as) developped in 
. **de Chaisemartin, Clément and d'Haultfoeuille, Xavier and Pasquier, Félix and Vazquez‐Bare, Doulo Sow, G
> onzalo,
. ** Difference-in-Differences Estimators for Treatments Continuously Distributed at Every Period (2025). 
. **https://arxiv.org/pdf/2201.06898
. 
. *VERSION AS OF February 2026.
. *--------------------------------------------------------------------------------------------------------
> --------------------------------------------------
. *
. * MAIN PROGRAM 1: THIS PROGRAM MAKES SOME SANITY CHECKS, DEFINES VARIABLES, CHECKS IF WE NEEED TO CALL TH
> E FIRST STAGE, DOES IF SO ETC.
. *
. *--------------------------------------------------------------------------------------------------------
> --------------------------------------------------
. capture program drop did_multiplegt_stat

. program did_multiplegt_stat, eclass sortpreserve byable(recall)
  1.         version 12.0
  2.         syntax varlist(min=4 max=5 numeric) [if] [in] [, estimator(string) estimation_method(string) O
> Rder(string) NOEXTRApolation placebo(integer 0) switchers(string) DISAGgregate as_vs_was exact_match bys_
> graph_off by_fd(integer 1) by_baseline(integer 1) other_treatments(varlist numeric) cluster(varlist max=1
> ) controls(varlist numeric) weights(varlist numeric max=1)  bootstrap(integer 0) seed(integer 0) twfe(str
> ing) cross_validation(string) cross_fitting(integer 0) graph_off trimming(integer 0) on_placebo_sample ar
> _ci] 
  3. 
.         marksample touse 
  4.         if _by() {
  5.                 quietly replace `touse' = 0 if `_byindex' != _byindex()
  6.         }
  7. // Add some kind of preamble to ensure "meaningful" inputs ///
. 
.  if (`cross_fitting'<2&`cross_fitting'!=0) {
  8.         di as error 
  9.         di as error "option cross_fitting incorrectly specified: "
 10.         di as error "The number of subsamples must be higher than 1."
 11.         exit
 12.  }
 13. // bootstrap has to be POSITIVE integer
. if `bootstrap'<0{
 14.         di ""
 15.         di as error "The input of the bootstrap() option has to be a positive integer!"
 16.         di as input _continue ""
 17.         exit
 18. }
 19. 
. // seed has to be POSITIVE integer
. if `seed'<0{
 20.         di ""
 21.         di as error "The input of the seed() option has to be a positive integer!"
 22.         di as input _continue ""
 23.         exit
 24. }
 25. 
. // switchers has to be up or down (or empty)
. if ("`switchers'"!="up" & "`switchers'"!="down" & "`switchers'"!=""){
 26.         di ""
 27.         di as error "The input of the switchers() option has to be either up or down!"
 28.         di as input _continue ""
 29.         exit
 30. }
 31. 
.         //tokenize the varlist
. tokenize `varlist'
 32. 
. /*******************************************************************************
> //Drop missing values to avoid errors: (Dec, 2024)
> *******************************************************************************/
. foreach var of varlist `1' `2' `3' `4' `5' `controls' `weights' `other_treatments' `cluster' {
 33.         cap drop if `var' == .
 34.         cap drop if `var' == ""
 35.  }
 36.  
. //Count number of arguments in order option
. local order_count: word count `order'
 37. //di as error  "`order_count'"
. if (`order_count'==0) {
 38.         local order = 1 //default
 39.         local order_count = 1
 40.         
. }
 41. 
. if ("`5'"!=""&"`5'"!=","){
 42. local IV_feed_XX = "yes"
 43. local IV_var_XX  `5' 
 44. 
. // Add warning at the beginning
. if "`estimator'"!="iv-was"{
 45.                 di ""
 46.                 di as error "You specified the 5th input variable (Instrumental variable) which is onl
> y compatible with the iv-was estimator."
 47.                 di as error "Therefore your estimator will be replaced by iv-was."
 48.                 di as input _continue ""
 49.         }
 50. 
. //Show the First Stage
. 
.                 local first_stage_specification `4' `2' `3' `5'
 51.                 
.                 if (`order_count'==8){
 52.                         //Take the first for as order of the first stage
.                         tokenize `order'
 53.                         local first_stage_orders `1' `2' `3' `4'
 54.                         local reduced_form_orders `5' `6' `7' `8'
 55.                 }
 56.                 else{
 57.                         if (`order_count'==4){
 58.                         //Take the first for as order of the first stage
.                         tokenize `order'
 59.                         local first_stage_orders `1' `2' `3' `4'
 60.                         local reduced_form_orders `first_stage_orders'
 61.                         }
 62.                         else{
 63.                                 if (`order_count'==1) {
 64.                                         local first_stage_orders `order'
 65.                                         local reduced_form_orders `order'
 66.                                         }
 67.                                         else {
 68.                                                 di as error "Error with the option order: only 1, 4, o
> r 8 (with iv-was) arguments are allowed."
 69.                                                 exit
 70.                                         }
 71.                         }
 72.                 }
 73.                 di as input "{hline 80}"
 74.                 di as input _skip(30) "First stage estimation"
 75.                 di as input "{hline 80}"
 76.                 
.                 //if strpos("`5'", ",") != 0 local 5 = strtrim(substr("`5'", 1, strpos("`5'", ",") - 1))
.                 local estimator = "was"
 77.                 if ("`if'"!="") local if_touse = "`if'&`touse' == 1"
 78.                 else local if_touse = "if `touse' == 1"
 79.                 
.                 did_multiplegt_stat2 `first_stage_specification'  `if_touse',  estimator(`estimator') est
> imation_method(`estimation_method') order(`first_stage_orders') `noextrapolation' placebo(`placebo') swit
> chers(`switchers') `disagregate' `as_vs_was' `exact_match' `bys_graph_off' by_fd(`by_fd') by_baseline(`by
> _baseline') other_treatments(`other_treatments') cluster(`cluster') controls(`controls') weights(`weights
> ') cross_validation(`cross_validation') `graph_off' `disaggregate' first_stage  cross_fitting(`cross_fitt
> ing') trimming(`trimming')
 80. }
 81. 
. 
. //Show the main results:
. if ("`if'"!="") {
 82.         local if_touse = "`if'&`touse' == 1"
 83.         local cmd = subinstr("`0'", "`if'", " `if_touse'", 1)
 84.         
.         if (strpos("`0'", ",")>0)  did_multiplegt_stat2 `cmd' reduced_form_orders(`reduced_form_orders')
 85.         else did_multiplegt_stat2 `cmd' , reduced_form_orders(`reduced_form_orders') 
 86. }
 87. else {
 88.                 local if_touse = "if `touse' == 1"
 89.                 local cmd = subinstr("`0'", ",", " `if_touse' , ", 1)
 90.                 
.                 if (strpos("`0'", ",")>0) did_multiplegt_stat2 `cmd' reduced_form_orders(`reduced_form_or
> ders') 
 91.                 else did_multiplegt_stat2 `cmd' `if_touse' , reduced_form_orders(`reduced_form_orders'
> ) 
 92. } //(Dec, 2024) DS: The if here conflicts with the if of the main command, if any. Corrected above.
 93.                 
. 
.                                 
.                 //Drop scalar created by the program
.                 cap scalars_to_drop  //a subprogram dropping all scalars with the pattern _XX
 94.                 cap scalar drop aggregated_data  max_mT
 95.                 cap scalar drop N_var
 96.                 cap scalar drop set_chosen_order_linear
 97.                 cap scalar drop N_drop_noextra_XX 
 98.                 cap scalar drop max_T
 99. end 

. 
. 
. *--------------------------------------------------------------------------------------------------------
> --------------------------------------------------
. *
. * MAIN PROGRAM 2: THIS IS THE MAIN PROGRAM COMPUTING ALL THE AGGREGATED ESTIMATORS AND DISPAYS THE RESULT
> S. IT CALLS THE SECONDARY PAIRWISE PROGRAM MULTIPLE TIMES.
. *
. *--------------------------------------------------------------------------------------------------------
> --------------------------------------------------
. capture program drop did_multiplegt_stat2

. program did_multiplegt_stat2, eclass sortpreserve byable(recall)
  1.         version 12.0
  2.         syntax varlist(min=4 max=5 numeric) [if] [in] [, estimator(string) estimation_method(string) O
> Rder(string) NOEXTRApolation placebo(integer 0) switchers(string) DISAGgregate as_vs_was exact_match bys_
> graph_off by_fd(integer 1) by_baseline(integer 1) other_treatments(varlist numeric) cluster(varlist max=1
> ) controls(varlist numeric) weights(varlist numeric max=1)  bootstrap(integer 0) seed(integer 0) twfe(str
> ing) cross_validation(string) graph_off FIRST_stage reduced_form_orders(string) cross_fitting(integer 0) 
>  trimming(integer 0) on_placebo_sample ar_ci] // FIRST_stage   twfe(percentile same_sample)
  3. 
.         if ("`reduced_form_orders'"!="") {
  4.                 local order = "`reduced_form_orders'"
  5.         }
  6.         
.         // Felix: Do not show "event-study" graph with by_baseline or by_fd
.         if (`by_baseline'!=1 | `by_fd'!=1){
  7.                 local graph_off="graph_off"
  8.         }
  9.         
.         // Felix: Only show "event-study" graph when at least one placebo is requested
.         if `placebo'==0{
 10.                 local graph_off="graph_off"
 11.         }       
 12.         
.         //>MAIN: Preserve the inputted dataset
.         preserve
 13.         
.         //If the user specify twfe without setting the bootstrap, take 100 as default.
.         //And store all the suboptions of twfe: percentile, same_sample (default are normal and maybe dif
> ferent samples.)
.         if ("`twfe'"!=""){
 14.         // Felix: This is a problem as twfe is a string (this wont get triggered then with twfe() plus
>  for the same reason an error with the bootstrap option will be triggered because it is only allowed with
>  twfe(which the command thinks is not specified)), what are you supposed to input as default -> force use
> r to specify something, see helpfile
.                 parse_select_twfe_suboptions, `twfe'
 15.                 if (`bootstrap'==0) local bootstrap = 100
 16.                 local percentile "`s(percentile)'"
 17.                 local same_sample "`s(same_sample)'"
 18.         }               
 19.         
.                 //Bootstrap running bar Start   
. if (`bootstrap'>0){
 20. di _newline
 21. _dots 0, title(Bootstrap running) reps(`bootstrap')
 22. }
 23. quietly{
 24. //Shut down the option weights and cluster: 
. //local weights = "" 
. //local cluster = ""
. 
. // Check if gtools is installed, if not present link to install
. qui cap which gtools
 25. if _rc{
 26.         di ""
 27.         di as error "You have not installed the gtools package which is used within the did_multiplegt
> _stat command."
 28.         di `"{stata "ssc install gtools": Click here to install gtools}"'
 29.         exit
 30. }       
 31. 
. //tokenize the varlist
. tokenize `varlist'
 32.  
. //dropping observations not included in the if condition
.         if "`if'" !=""{
 33.         keep `if'
 34.         count 
 35.         if (r(N)==0){
 36.                 mata: exit(error(2000))
 37.         }
 38.         }
 39. // dropping observations not included in the in condition
.         if "`in'" !=""{
 40.         keep `in'
 41.         } 
 42. 
. 
. //capdrop varlist
. cap drop Y_XX
 43. cap drop D_XX
 44. cap drop T_XX
 45. cap drop ID_XX
 46. cap drop weights_XX
 47. cap drop weights_cXX
 48. cap drop S_XX
 49. cap drop D1_XX
 50. cap drop deltaD_XX
 51. cap drop deltaY_XX
 52. cap drop to_drop_XX
 53. cap drop tsfilled_XX
 54. cap drop T_OG_XX
 55. 
. 
. ///// Collapse and weights
>         
. // Checking wether data has to be collapsed, because at a more disaggregated level than group*time.
.  
. capture drop counter_XX
 56. capture drop counter_temp_XX
 57. gen counter_temp_XX=1
 58. bys `2' `3' : gegen counter_XX=count(counter_temp_XX)
 59. sum counter_XX
 60. scalar aggregated_data=0
 61. if r(max)==1{
 62. scalar aggregated_data=1
 63. }
 64. 
. /*
> // Collapsing the data when necessary:
> 
> if scalar(aggregated_data)==0{
>         
>         replace weights_XX=0 if `1'==.
>         
>         if "`1'"!="`4'"{
>                                 //Averging the outcome and treatment
>                 collapse (mean) `1' `4' (count) weights_XX [iw=weights_XX], by(`2' `3')
>         }
>         
>         if "`1'"=="`4'"{                        
>                 collapse (mean) `1' (count) weights_XX [iw=weights_XX], by(`2' `3')
>         }       
> }
> */
. 
. //gen main varlist
. //Doulo: (Dec, 2024)
. clonevar Y_XX = `1'
 65. clonevar ID_XX =  `2'
 66. clonevar T_OG_XX = `3'
 67. clonevar D_XX = `4' 
 68. local depname  = "`1'" //for estout
 69. local OG_nameID_XX = "`2'"
 70. local OG_nameD_XX  = "`4'" //August 2025.
 71. //2. IV method:
. local IV_feed_XX = "no"
 72. 
. if ("`5'"!=""&"`5'"!=","){
 73. local IV_feed_XX = "yes"
 74. local IV_var_XX  `5' 
 75. 
. // Replace the estimator we are actually using
.         if "`estimator'"!="iv-was"{             
 76.                 local estimator = "iv-was" 
 77.         }
 78. 
. }
 79. 
.  xtset `2'  `3' 
 80. 
. /*******************************************************************************
> //Check all the estimators that are requested - to customize the display
> *******************************************************************************/
. 
.         local 1 ""
 81.         local 2 ""
 82.         local 3 ""
 83.         
. if("`estimator'" ==""){
 84.         if ("`IV_feed_XX'" == "no"){
 85.         local 1 "as"
 86.         local 2 "was"
 87.         //local 3 "iwas" //Now the default (when estimator is not specified) is to compute as and was 
> only if Z is not given
.         local as_XX = 1
 88.         local was_XX = 1
 89.         local iwas_XX= 0
 90.         local estimator = "as was"  //Doulo: Set estimator values
 91.         }
 92.         else{
 93.         //local 1 "as"
.         //local 2 "was"
.         local 3 "iv-was" //Now the default (when estimator is not specified) is to computes iwas only if 
> Z is specify
 94.         local as_XX = 0
 95.         local was_XX = 0
 96.         local iwas_XX= 1
 97.         local estimator = "iv-was" //Doulo: Set estimator values
 98.         }
 99. }
100. else{
101.         //Count the number of estimators requested
.         //scalar nb_estimatorts_XX = `:word count `estimator''
.                 tokenize `estimator'
102.                 local as_XX = inlist("as", "`1'", "`2'", "`3'")
103.                 local was_XX = inlist("was", "`1'", "`2'", "`3'")
104.                 local iwas_XX= inlist("iv-was", "`1'", "`2'", "`3'")
105.                 
.                 if ("`as_XX'"=="1"){
106.                         local 1 = "as" 
107.                 }
108.                 if ("`was_XX'"=="1"){
109.                         local 2 = "was" 
110.                 }
111.                 if ("`iwas_XX'"=="1"){
112.                         local 3 = "iv-was" 
113.                 }
114. 
. }
115. 
. local total_estimator = `as_XX' + `was_XX' + `iwas_XX'
116. 
. ***Display error of AR CI requested without IV-WAS:
. 
. if (`iwas_XX'==0 & "`ar_ci'"!="") di as error "The ar_ci option is only for the IV-WAS."
117. // count the number of arguments in `estimator' compare them to total_estimator to see if there are ot
> her things specified that should not be
. local nb_estimatorts_XX = `:word count `estimator'' //Doulo: Set estimator values above, in case estimnat
> or is empty
118. 
. /********************************************************************************
>                         ERRORS MESSAGES FOR :
> ********************************************************************************/
. 
. //0. Estimators
. if (`total_estimator'!=`nb_estimatorts_XX'){ // Modif Felix, see above
119.                 di as error "Error in the option estimator."
120.                 di as error "The arguments allowed are: as, was, or iv-was." //Doulo: This is to restr
> ictive. By default if the user does not specify estimator and Z, we should automatically produce as and w
> as. And if he specifies we displays automatically iv-was. Solved above(See //Doulo: Set estimator values)
121.                 exit
122. }
123. //1. Estimation method:
. 
. /*
> if ("`estimation_method'" == "ps"|"`estimation_method'" == "dr"){
>         if ("`was_XX'"=="0"&"`iwas_XX'"=="0"){
>                 di as error "The propensity/doubly-robust -based approach is only available for the was a
> nd the iv-was."
>                 exit
>         }
> }
> local req_est_method = inlist("`estimation_method'", "" , "ra", "ps", "dr")
> 
> if (`req_est_method' == 0){
>                 di as error "Error in the option estimation_method."
>                 di as error "The arguments allowed are: ra, ps, or dr."
>                 exit
> 
> }
> */
. if ("`exact_match'" =="") local estimation_method = "dr" //By default, the command estimates now the doub
> ly-robust estimator for all estimators.
124. 
. //2. IV
. if ("`IV_feed_XX'"=="no"&("`iwas_XX'" == "1")){
125.         di as error "To compute the iv-was you must specify the IV variable."
126.         exit
127. }
128. 
. 
. //3. Combination of estimators //Shut this constraint down: before I will need to modify the way the pair
> wise is called: We will need to call the pairwise program for each estimator and not once. Otherwise, if 
> the user specifies for instance the option noextrapolation, the command will apply the two conditions (no
> extra on the iV and noextra on the treatment): Ask Clement?
. 
. if ("`iwas_XX'" == "1"&("`was_XX'" == "1"|"`as_XX'" == "1")){
129.         di as error "The estimation of AS or WAS cannot be combined with the estimation of IV-WAS (see
>  helpfile)."
130.         exit
131. }
132. 
. 
. //4. The test of equality between as and was
. local a_vs_w = `as_XX' + `was_XX'
133. if ("`as_vs_was'"!=""&`a_vs_w'!=2){
134.         di as error "To test the equility between AS and WAS you must specify as and was in the estima
> tor option."
135.         exit
136. }
137. 
. 
. //Count number of arguments in order option
. local order_count: word count `order'
138. 
. if (`order_count'==0) {
139.         local order = 1 //default
140.         local order_count = 1   
141. }
142. 
. if (`order_count'!=4&`order_count'!=1&`order_count'!=8) {
143.         di as error "Error with the option order: only 1, 4, or 8 (with iv-was) arguments are allowed.
> "
144.         exit
145. }
146. 
. if (`order_count'==1){
147. if (!(mod(`order', 1)  == 0 & `order' > 0)) {
148.         di as error "Order should be a positive integer"
149.         exit
150. }
151. else{
152.         forvalues num_order = 1/4{
153.                 local order_`num_order' = `num_order'
154.         }
155. }
156. 
. }
157. 
. if (`order_count'==4|`order_count'==8) {
158.         local num_order = 0
159.         foreach level of local order{
160.                 if (!(mod(`level', 1)  == 0 & `level' > 0)) {
161.                         di as error "Each order should be a positive integer"
162.                         exit
163.                 }
164.                 else{
165.                         local num_order = `num_order' + 1
166.                         local order_`num_order' = `level'
167.                 }
168.                         
.         }
169. 
. }
170. 
. //5.
. if (`total_estimator'!=`nb_estimatorts_XX'){ // Modif Felix, see above
171.                 di as error "Error in the option estimator."
172.                 di as error "The arguments allowed are: as, was, or iv-was."
173.                 exit
174. }
175. 
. //6. exact_match and noextrapolation
. if ("`exact_match'"!=""&"`noextrapolation'"!=""){
176.                 di as error "As the exact_match option is specified,"
177.                 di as error "the noextrapolation option is ignored."
178.         local noextrapolation = ""
179. }
180. 
. //7. Order and cross_validation
. if (`order_count'==1) {
181.         if (`order'>1&"`cross_validation'"!=""){
182.                 di as error ""
183.                 di as error "The option order is not allowed along with cross-validation."
184.                 di as error "The command will ignore the option order()."
185.                 local order = 1
186.                 }
187. }
188. else{
189.                 if ("`cross_validation'"!=""){
190.                         di as error ""
191.                         di as error "The option order is not allowed along with cross-validation."
192.                         di as error "The command will ignore the option order()."
193.                         local order = 1
194.                         }               
195. }
196. 
. //8. exact_match and [order, estimation_method, order]
. if ("`exact_match'"!=""){
197.         /*Deprecated because we shut down the option estimation_method
>         if ("`estimation_method'"!=""){
>                 di as error "As the exact_match option is specified,"
>                 di as error "the estimation_method option is ignored."
>         }
>         */
.         
.         if ("`order'"!="1"){ //The values are then set within the pairwise program.  To se where search l
> ocal order = r(r)
198.                 di as error "As the exact_match option is specified,"
199.                 di as error "the order option is ignored."
200.         }
201. local estimation_method = "ra"  //set the default if exact_match>
202.         
. }
203. else{
204.         
.         //Set the default to 1 if the option is not specified and without exact_match
.         // Modif. -> now the default is always 1
.         /*
>         if (`order'==0){
>                 local order =1 
>         }
>         */
.         if ((`was_XX'==1|`iwas_XX'==1)&"`estimation_method'"==""){
205.                 local estimation_method = "dr" //default option
206.                 
.         }
207. }
208. 
. //9. Cluster non-nested  //CLUSTER OPTION
. if ("`cluster'"!=""&"`cluster'"!="`OG_nameID_XX'"){
209.         cap drop cluster_numeric_XX 
210.         egen cluster_numeric_XX = group(`cluster')
211.         bysort ID_XX: gegen cluster_sd_XX = sd(cluster_numeric_XX)
212.         sum cluster_sd_XX
213.         scalar max_cluster_sd_XX = `r(max)'
214.         if (scalar(max_cluster_sd_XX) >0){
215.         di as error ""
216.         di as error "The ID variable should be nested within the clustering variable."
217.         exit
218.         }
219. }       
220. 
. //10.Bootstrap is only allowed with iv-was
. if (`bootstrap'!=0&`iwas_XX'==0&"`twfe'"==""){
221.         di as error ""
222.         di as error "The bootstrap option is only available for the iv-was,"
223.         di as error "or combined with twfe."
