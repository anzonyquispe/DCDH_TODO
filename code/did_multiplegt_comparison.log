> ''"
 20.                         sreturn local label_quantile`q' =  "Baseline D in `label_q_`q''"
 21.                 }
 22.                 if (`iwas'==1)  {
 23.                         if ("`display_message'"!="")  di as input _skip(25) "Baseline Z in `label_q_`q
> ''"               
