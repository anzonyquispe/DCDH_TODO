. /*******************************************************************************
> AR / FIELLER CI FOR IV-WAS  //DS: adding ar_ci
> *******************************************************************************/
. cap program drop ar_ci  //DS: adding ar_ci

. program define ar_ci, rclass
  1.     version 17.0
  2.     /*
>     Computes an Anderson-Rubin (Fieller) confidence interval for the IV ratio
>     estimand delta = RF/FS, using influence functions as input.
> 
>     Syntax:
>         ar_ci [if] [in] [aw fw pw], ///
>             ifrf(var) iffs(var) rf(#) fs(#) ///
>             [level(#) cluster(var)]
>     */
.     syntax [if] [in] [aw fw pw], ///
>         IFRF(varname numeric) IFFS(varname numeric) ///
>         RF(real) FS(real) ///
>         [Level(real 95) CLuster(varname) weights(varname)]
  3. 
.     marksample touse
  4. 
.     tempvar w
  5.     if ("`weights'"!="") {
  6.                 quietly gen `w' = `weights' 
  7.                 }
  8.                 else{
  9.                         quietly gen `w' = 1
 10.                 }
 11.                 
. 
.     quietly count if `touse'
 12.     local n = r(N)
 13. 
.     if (`n' <= 1) {
 14.         di as err "ar_ci: not enough observations."
 15.         exit 2001
 16.     }
 17.     if (`level' <= 0 | `level' >= 100) {
 18.         di as err "ar_ci: level() must be between 0 and 100."
 19.         exit 198
 20.     }
 21. 
.     tempname Sigma11 Sigma22 Sigma12 W_ar
 22.     if "`cluster'" == "" {
 23.         tempvar cross ifrf2 iffs2
 24.         quietly gen `cross' = `w'*`ifrf'*`iffs' 
 25.         quietly gen `ifrf2' = `w'*(`ifrf')^2        
 26.         quietly gen `iffs2' = `w'*(`iffs')^2        
 27.         quietly summarize `w' if `touse', meanonly
 28.         scalar `W_ar'    =  r(sum_w)
 29.         quietly summarize `ifrf2' if `touse', meanonly
 30.         scalar `Sigma11' = r(sum)/`W_ar'
 31.         quietly summarize `iffs2' if `touse', meanonly
 32.         scalar `Sigma22' = r(sum)/`W_ar'
 33.         quietly summarize `cross' if `touse', meanonly
 34.         scalar `Sigma12' = r(sum)/`W_ar'
 35. 
.         local clustered 0
 36.     }
 37.     else {
 38.         preserve
 39.             keep if `touse'
 40.             keep `ifrf' `iffs' `cluster' `w'
 41.             quietly gen ifrf_w = `ifrf' //* `w'
 42.             quietly gen iffs_w = `iffs' //* `w'
 43.             collapse (sum) ifrf_w iffs_w `w', by(`cluster')
 44.             rename ifrf_w `ifrf'
 45.             rename iffs_w `iffs'
 46.             quietly count
 47.             local G = r(N)
 48.             tempvar cross ifrf2 iffs2
 49.             quietly gen `cross' = `w' *`ifrf' *`iffs'
 50.             quietly gen `ifrf2' = `w'*(`ifrf')^2
 51.             quietly gen `iffs2' = `w'*(`iffs')^2
 52.             quietly summarize `w',     meanonly
 53.                         scalar `W_ar'    =  r(sum_w)
 54.                         quietly summarize `ifrf2', meanonly
 55.                         scalar `Sigma11' = r(sum)/`W_ar'
 56.                         quietly summarize `iffs2' , meanonly
 57.                         scalar `Sigma22' = r(sum)/`W_ar'
 58.                         quietly summarize `cross' , meanonly
 59.                         scalar `Sigma12' = r(sum)/`W_ar'
 60.         restore
 61.         local clustered 1
 62.     }
 63. 
.     tempname chi2c a_s b_s c_s disc_s r1_s r2_s lb_s ub_s
 64.     scalar `chi2c'  = invchi2(1, `level'/100)
 65.     scalar `a_s'    = `n' * (`fs'^2)          - `chi2c' * `Sigma22'
 66.     scalar `b_s'    = -2 * `n' * `rf' * `fs'  + 2 * `chi2c' * `Sigma12'
 67.     scalar `c_s'    = `n' * (`rf'^2)           - `chi2c' * `Sigma11'
 68.     scalar `disc_s' = `b_s'^2 - 4*`a_s'*`c_s'
 69. 
.     // Handle degenerate cases (|a| ≈ 0)
.     if (abs(scalar(`a_s')) < 1e-10) {
 70.         if (abs(scalar(`b_s')) < 1e-10) {
 71.             if (scalar(`c_s') <= 0) {
 72.                 return local ci_type "allreal"
 73.                 return scalar lb = .
 74.                 return scalar ub = .
 75.                 exit
 76.             }
 77.             else {
 78.                 return local ci_type "empty"
 79.                 return scalar lb = .
 80.                 return scalar ub = .
 81.                 exit
 82.             }
 83.         }
 84.         tempname cut_s
 85.         scalar `cut_s' = -scalar(`c_s') / scalar(`b_s')
 86.         if (scalar(`b_s') > 0) {
 87.             return local ci_type "unbounded"
 88.             return scalar lb = .
 89.             return scalar ub = scalar(`cut_s')
 90.         }
 91.         else {
 92.             return local ci_type "unbounded"
 93.             return scalar lb = scalar(`cut_s')
 94.             return scalar ub = .
 95.         }
 96.         exit
 97.     }
 98. 
.     if (scalar(`disc_s') < 0) {
 99.         if (scalar(`a_s') > 0) {
100.             return local ci_type "empty"
101.         }
102.         else {
103.             return local ci_type "allreal"
104.         }
105.         return scalar lb = .
106.         return scalar ub = .
107.         exit
108.     }
109. 
.     scalar `r1_s' = (-scalar(`b_s') - sqrt(scalar(`disc_s'))) / (2*scalar(`a_s'))
110.     scalar `r2_s' = (-scalar(`b_s') + sqrt(scalar(`disc_s'))) / (2*scalar(`a_s'))
111.     scalar `lb_s' = min(scalar(`r1_s'), scalar(`r2_s'))
112.     scalar `ub_s' = max(scalar(`r1_s'), scalar(`r2_s'))
113. 
.     if (scalar(`a_s') > 0) {
114.         return local ci_type "bounded"
115.         return scalar lb = scalar(`lb_s')
116.         return scalar ub = scalar(`ub_s')
117.     }
118.     else {
119.         return local ci_type "unbounded"
120.         return scalar lb = scalar(`lb_s')
121.         return scalar ub = scalar(`ub_s')
122.     }
123. end

. 
. 
