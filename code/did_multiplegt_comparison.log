. capture program drop did_multiplegt_stat_pairwise

. program did_multiplegt_stat_pairwise, eclass
  1.         version 12.0
  2.         syntax varlist(min=4 max=5 numeric) [if] [in] [, estimator(string) ORder(string) NOEXTRApolati
> on weights(varlist numeric) switchers(string) pairwise(integer 2) data_1XX(string) as(integer 0) was(inte
> ger 0) iwas(integer 0) estimation_method(string) placebo(integer 0) exact_match cluster(varlist max=1) qu
> antile(integer 1) by_fd(integer 1) by_baseline(integer 1) other_treatments(varlist numeric) controls(varl
> ist numeric)  bootstrap(integer 0) reg_order(integer 1) logit_bis_order(integer 1)  logit_Plus_order(inte
> ger 1) logit_Minus_order(integer 1) cross_validation(string) cross_fitting(integer 0) trimming(integer 0)
>  on_placebo_sample]
  3.         
. quietly{
  4. //> CORE preserve
. tempfile OG_dataPathcore
  5.         save "`OG_dataPathcore'.dta", replace
  6.         
.         //Trimming: 
.         local trimming  = `=`trimming'/100'
  7.         
. //IV method:
. local IV_feed_XX = "no"
  8. 
. if ("`5'"!=""&"`5'"!=","){
  9. local IV_feed_XX = "yes"
 10. }
 11. 
. if ("`IV_feed_XX'"=="no"&(`iwas' == 1|"`estimator'" == "")){
 12.         //di as error "To compute the iwas you must specify the IV variable."
.         local iwas = 0
 13.         //exit
. }
 14. 
. **# Bookmark #1: Format the data: Subselect the two times we are interested in
. if ("`placebo'"=="0"){
 15.         keep if inlist(T_XX,  `pairwise'-1,  `pairwise')
 16. 
.         **To estimate the model on placebos: comment it out.
.         if ("`on_placebo_sample'"!="") {
 17.                 replace deltaDt_XX = . if T_XX == `pairwise'
 18.                 bysort ID_XX: egen temp_deltaDt_XX = mean(deltaDt_XX)
 19.         }
 20. 
. }
 21. else{
 22.                 
.         keep if inlist(T_XX,  `pairwise'-`placebo' -1, `pairwise'-`placebo', `pairwise'-1, `pairwise')
 23.         //Controls: Take X_{t-1} (automatically done since we drop if t==2) if Effect and X_{t-2} if P
> lacebo1 and X_{t-3} if Placebo2
.         if ("`controls'"!=""){
 24.                 foreach control in `controls'{
 25.                         cap drop temp_`control'XX temp_`control'2XX
 26.         xtset ID_XX T_XX
 27.                         //bysort ID_XX: gen temp_`control'2XX  = L.`control'
. 
.                         //gen temp_`control'2XX  = L.`control' if T_XX == `pairwise' - `placebo' - 1
.                         gen temp_`control'2XX  = `control' if T_XX == `pairwise' - `placebo' - 1 //(Dec, 
> 2024)
 28.                         
.                         bysort ID_XX: egen temp_`control'XX = mean(temp_`control'2XX )
 29.                         replace `control' = temp_`control'XX
 30.                 }
 31.         }
 32.         //keep if inlist(T_XX,  `pairwise'-2, `pairwise'-1, `pairwise')
.         keep if inlist(T_XX,  `pairwise'-`placebo' -1, `pairwise'-`placebo', `pairwise'-1, `pairwise')
 33.         local pla = "pla"
 34. 
. }
 35.  
. 
. //Check if one of the two periods was a gap:
. bysort T_XX: gegen tsfilled_minXX = min(tsfilled_XX)
 36. sum tsfilled_minXX
 37. scalar gap_`pairwise'`pla'XX =  r(max) 
 38. 
. sort T_XX
 39. gegen Tbis_XX = group(T_XX)
 40. replace T_XX = Tbis_XX
 41. drop Tbis_XX
 42. 
. xtset ID_XX  T_XX
 43. 
. //Generate deltaY = Y_t - Y_(t-1)
. bysort ID_XX: gen deltaY_XX = D.Y_XX
 44. ///>put it  at the same level of Y_(t-1)
> if ("`placebo'"=="0"){
 45.         bysort ID_XX: gegen delta_temp = mean(deltaY_XX)
 46.         replace deltaY_XX = delta_temp
 47.         drop delta_temp
 48. }
 49. else{
 50.         gen delta_temp = deltaY_XX if T_XX == 2 // = Y_{t-1} - Y_{t-2} or in general Y_{t-placebo} - Y
> _{t-placebo-1}
 51.         bysort ID_XX: gegen delta_temp2 = mean(delta_temp)
 52.         replace deltaY_XX = delta_temp2
 53.         drop delta_temp2 
 54.         drop delta_temp
 55. }
 56. 
. 
. //Generate deltaD_t = D_t - D_(t-1)
. sort ID_XX T_XX
 57. bysort ID_XX : gen deltaD_XX = D.D_XX
 58. 
. if ("`placebo'"!="0"&(`as'==1|`was'==1)){
 59.         cap drop inSamplePlacebo_tempXX
 60.         cap drop inSamplePlacebo_XX
 61.         gen inSamplePlacebo_tempXX = (deltaD_XX==0)&(T_XX==2) if (deltaD_XX!=.) //Units such that D_{t
> -2} = D_{t-1} or in general such that D_{t-placebo} - D_{t-placebo-1}
 62.         bysort ID_XX: gegen inSamplePlacebo_XX = max(inSamplePlacebo_tempXX)
 63.         
.         //Only keep Units such that D_{t-2} = D_{t-1}
.         //keep if inSamplePlacebo_XX==1
.         drop if T_XX == 1 //We do not need that line since we've already computed Y_{t-2} - Y_{t-1}, and 
> selected Units such that D_{t-2} = D_{t-1} // And evrything that follows is the same as the computation o
> f the effects:)
 64.         if(`placebo'>1) drop if T_XX == 2
 65.         if(`placebo'==1) bysort ID_XX: replace deltaD_XX = . if T_XX!=3 //We need the DeltaD_t only an
> d we will take the mean after to keep the same value for all the dates
 66.         if(`placebo'>1) bysort ID_XX: replace deltaD_XX = . if T_XX!=4
 67.         
. }
 68. 
. if (`iwas' == 1){
 69.         //IV
.         cap drop deltaZ_XX
 70.         cap drop SI_XX
 71.         cap drop Z_XX
 72.         cap drop outOfBoundsiV_XX
 73.         
.         gen Z_XX = `5'
 74.         
.         //Generate deltaZ_t = Z_t - Z_(t-1)
.         sort ID_XX T_XX
 75.         bysort ID_XX : gen deltaZ_XX = D.Z_XX
 76.         if ("`placebo'"!="0"){
 77.                 
.                 /*Start Correction*/
.                 //First we need deltaD_{t-1} instead of deltaD_t: No, in fact we need D_t to avoid dividi
> ng by 0 when the FS PT is verified; Ask Clement, why not showing the Placebos of the FS and the RF when I
> V is specified.
.         replace deltaD_XX = . if T_XX!= 3 // = D_{t-1} - D_{t-2}
 78. 
.         
.                 ///*End Correction*/
>                 
.         cap drop inSamplePlaceboIV_tempXX
 79.         cap drop inSamplePlaceboIV_XX
 80.         gen inSamplePlaceboIV_tempXX = (deltaZ_XX==0)&(T_XX==2) //Units such that Z_{t-2} = Z_{t-1}
 81.         bysort ID_XX: gegen inSamplePlacebo_XX = max(inSamplePlaceboIV_tempXX)
 82.         
.         //Only keep Units such that Z_{t-2} = Z_{t-1}
.         //keep if inSamplePlacebo_XX==1
.         drop if T_XX == 1 //We do not need that line since we've already computed Y_{t-2} - Y_{t-1}, and 
> selected Units such that Z_{t-2} = Z_{t-1} // And evrything that follows is the same as the computation o
> f the effects:)
 83.         if(`placebo'>1) drop if T_XX == 2
 84.         if(`placebo'==1) bysort ID_XX: replace deltaZ_XX = . if T_XX!=3 //We need the DeltaZ_t only an
> d we will take the mean after to keep the same value for all the dates
 85.         if(`placebo'>1) bysort ID_XX: replace deltaZ_XX = . if T_XX!=4
 86.         }
 87.         
. }
 88.                 
. if (_N == 0){ //If the placebo cannot be estimated (because the subsample {i: D_{t-2} = D_{t-1}} is empty
> ), create the variables,and scalars and set them to .
 89.         if (`was'==1|`as'==1){
 90.         forvalues i=1/2{
 91.         scalar delta`i'_`pairwise'`pla'XX  = . // 0
 92.         scalar sd_delta`i'_`pairwise'`pla'XX = .
 93.         scalar LB`i'_`pairwise'`pla'XX = .
 94.         scalar UB`i'_`pairwise'`pla'XX = .
 95.         
.         cap drop Phi`i'_`pairwise'`pla'XX
 96.         gen Phi`i'_`pairwise'`pla'XX = .
 97.         
.         scalar N_Switchers`i'_`pairwise'`pla'XX = .
 98.         scalar Nstayers`i'_`pairwise'`pla'XX = .
 99.                 
.         }
100.         cap drop absdeltaD_`pairwise'`pla'XX
101.         cap drop S_`pairwise'`pla'XX
102.         gen absdeltaD_`pairwise'`pla'XX = .
103.         gen S_`pairwise'`pla'XX = .
104.         scalar EabsdeltaD_`pairwise'`pla'XX = 0
105.         scalar P_`pairwise'`pla'XX = 0
106.         cap drop used_in_`pairwise'_XX
107.         gen used_in_`pairwise'_XX=.
108.         
.         
.         }
109. else{
110.         scalar delta3_`pairwise'`pla'XX  = . //0
111.         scalar sd_delta3_`pairwise'`pla'XX = .
112.         scalar LB3_`pairwise'`pla'XX = .
113.         scalar UB3_`pairwise'`pla'XX = .
114.         scalar denom_deltaIV`pairwise'`pla'XX = 0
115.         cap drop Phi3_`pairwise'`pla'XX
116.         gen Phi3_`pairwise'`pla'XX = .
117.         gen innerSumIV_denom_`pairwise'`pla'XX = .
118.         
.         scalar N_Switchers3_`pairwise'`pla'XX = .
119.         scalar Nstayers3_`pairwise'`pla'XX = .
120.         
.         cap drop used_in_IV`pairwise'_XX
121.         gen used_in_IV`pairwise'_XX =.
122. }
123. }
124. else{
125. ///>put deltaD_t at the same level of D_(t-1) 
> cap drop deltaD_temp
126. bysort ID_XX: gegen deltaD_temp = mean(deltaD_XX)
127. replace deltaD_XX = deltaD_temp
128. drop deltaD_temp 
129. 
. if (`iwas'==1){
130.         ///>put deltaZ_t at the same level of Z_(t-1)
>         bysort ID_XX: gegen deltaZ_temp = mean(deltaZ_XX)
131.         replace deltaZ_XX = deltaZ_temp
132.         drop deltaZ_temp
133.         
.         gen SI_XX = (deltaZ_XX>0)-(deltaZ_XX<0) // = SI+ - SI-, note that SI_XX = sgn(deltaZ_XX) which wi
> ll be then used below
134.         rename  Z_XX Z1_XX
135. }
136. 
. //First we need to tag observations that are used: this is related to the problem with unbalanced panel, 
> and in a particular case I remarked when dealing with the aggregated influence functions
. cap drop used_in_`pairwise'_XX
137. gen used_in_`pairwise'_XX = (deltaY_XX!=.&deltaD_XX!=.) //This variable will be used in aggreagation t
> o set to . the influence function of the units that are not used in all the different two-periods we cons
> ider.
138. if (`iwas' == 1){
139.         cap drop used_in_IV`pairwise'_XX
140.         gen used_in_IV`pairwise'_XX = (used_in_`pairwise'_XX==1&deltaZ_XX!=.) 
141.         drop if !used_in_IV`pairwise'_XX 
142. }
143. else{
144.         //drop if !used_in_`pairwise'_XX //missing values: after the merge, below, with all the datase
> ts that variable will be set to . for the unused units then we will exploit that to tag those units.(depr
> ecated, I used rownonmiss instead)
. }
145. 
. 
. 
. //generate Switcher : S = 1 if switcher-up, -1 if switcher-down, 0 if stayer
. gen S_XX = (deltaD_XX>0)-(deltaD_XX<0) // = S+ - S-
146. 
. if (`was'==1|`as'==1){
147. cap drop absdeltaD_XX
148. gen absdeltaD_XX = S_XX*deltaD_XX
149. 
.         if ("`switchers'" =="up"){
150.          drop if S_XX==-1
151.         }
152.         if ("`switchers'" =="down"){
153.          drop if S_XX==1
154.         }
155. }
156. 
. if (`iwas'==1){
157. cap drop absdeltaZ_XX
158. gen absdeltaZ_XX = SI_XX*deltaZ_XX
159. 
.         if ("`switchers'" =="up"){
160.          drop if SI_XX==-1
161.         }
162.         if ("`switchers'" =="down"){
163.          drop if SI_XX==1
164.         }
165. }
166. 
. 
. *******************************************************************************************
. //Other treatments option 
. *******************************************************************************************
. if ("`other_treatments'"!=""){
167. cap drop group_other_treatments_XX
168. egen group_other_treatments_XX = group(`other_treatments')
169.         //1. Create the first difference of each treatment
.         xtset ID_XX T_XX
170.         foreach var in `other_treatments'{
171.                 cap drop fd_`var'_tmpXX 
172.                 cap drop fd_`var'_XX 
173.                 bysort ID_XX: gen fd_`var'_tmpXX = D.`var'
174.                 //drop if the other treatment has changed. //We do not drop but set H_t to 0 afterward
>  
.                 bysort ID_XX: egen fd_`var'_XX = total(fd_`var'_tmpXX) 
175.                 //drop if fd_`var'_XX !=0
.                 
.         }
176. }
177. //We have all the variable we need at the first year so we can drop the 'second' year line
. //  But before let's also take the right line of weightss we need: W_{g,t} if we consider the cell (t-1,t
> ) (Effect), and even with Plaxebo
. 
. replace weights_XX = F.weights_XX
178. replace weights_cXX = F.weights_cXX
179. 
. //Do it for the quantile to consider: 
.         if (`quantile'>0){
180.                 if (`by_fd'>1){ //FD:
181.                         if (`as'==1|`was'==1)    replace Q_XX = F.Q_XX
182.                         if (`iwas'==1)             replace QZ_XX = F.QZ_XX
183.                 }
184.         }
185. 
. 
. if ("`placebo'"=="0"){
186. quietly drop if T_XX == 2 
187. }
188. else{ //Keep only line t-1.
189. if (`placebo'==1) quietly drop if T_XX == 3
190. if (`placebo'>1) quietly drop if T_XX == 4
191. }
192. rename  D_XX D1_XX
193. 
. //+ Imbalanced panel adjustment : The missing value indicator: A 
. cap drop Ht_XX
194. gen Ht_XX = (deltaD_XX!=.&deltaY_XX!=.)
195. replace S_XX =. if Ht_XX==0 // keep defined only for units with no missing data
196. if (`iwas'==1){
197.         replace Ht_XX = 1 if Ht_XX==1&deltaZ_XX!=.
198.         replace  SI_XX =. if Ht_XX==0
