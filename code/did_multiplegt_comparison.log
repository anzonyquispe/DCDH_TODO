>  option, as in the help file, and then the command should stop.
. if ("`twfe'"!=""&(`nb_estimatorts_XX'>1)){
232.         di as error ""
233.         di as error "Only one estimator (as was or iv-was) can be requested with twfe option."
234.         exit
235. }
236. 
. if ("`twfe'"!=""&(`as_XX'==1)){
237.         di as error ""
238.         di as error "The option twfe is only compatible with the estimators was and iv-was."
239.         exit
240. }
241. 
. /*Deprecated because we shut down the option estimation_method
> //12. Default estimqtor when cross-fitting is DR:
> if ("`cross_fitting'"!="0"&!inlist("`estimation_method'", "", "dr")){
>         di as error ""
>         di as error "When the option cross_fitting is specified,"
>         di as error "by default, the command uses the doubly-robust estimator."
>         local estimation_method = "dr"
>         }
> */      
. //13. exact_match vs cross_fitting:
. if ("`cross_fitting'"!="0"&"`exact_match'"!=""){
242.         di as error ""
243.         di as error "The options exact_match and cross_fitting are not compatible."
244.         exit
245.         }
246.         
. ********************************************************************************
. 
. //Handle missing values i)
. //gen to_drop_XX = (Y_XX==.|T_OG_XX==.|D_XX==.|ID_XX==.)
. //Handle missing values ii)
. if ("`iwas_XX'" == "1"){
247.         //local controls "`controls' D_XX"
. //replace to_drop_XX = (to_drop_XX==.|`IV_var_XX'==.)
. }
248. //Handle missing values iii)END
