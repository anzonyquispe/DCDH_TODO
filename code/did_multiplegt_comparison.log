481.                         
.                         reg S_XX `reg_vars_pol_XX' if cf_sample_id != `cf_id'
482.                         tempvar cf_ES_XX_`cf_id'D1
483.                         predict `cf_ES_XX_`cf_id'D1' if cf_sample_id == `cf_id' , xb
484.                         replace cf_ES_XX_D1 = `cf_ES_XX_`cf_id'D1' if cf_sample_id == `cf_id'         
>   
485.                         
.                         }
