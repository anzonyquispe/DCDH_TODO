618. 
.                 //Effects
.                 replace Phi3_`p'XX = [scalar(denom_deltaIV`p'XX)*Phi3_`p'XX + (scalar(delta3_`p'XX) - sca
> lar(delta3_1XX))*(innerSumIV_denom_`p'XX - scalar(denom_deltaIV`p'XX))]/scalar(denom_deltaIV_sum_XX)
619.                 local Phi3_ts_XX `Phi3_ts_XX' Phi3_`p'XX
