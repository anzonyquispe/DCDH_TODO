625.                 }
626.         }
627.         } //END OF THE LOOP
628. if ("`cluster'"!=""){ 
629.         //Compute E(N_c)
. bysort `cluster': gen N_c_XX = _N if _n==1
630. replace N_c_XX = . if S_XX == . //Dec, 24
631. sum N_c_XX
632. scalar N_bar_c_XX = r(mean)
633. }
634.         //as
.         if (`as_XX' == 1){
635.                 
.                 //Effect
.                 cap drop Phi1_XX
636.                 cap drop not_to_use1_XX
637.                 //di as error "`Phi1_ts_XX'"
.                 gegen Phi1_XX = rowtotal(`Phi1_ts_XX')
638.                 gegen not_to_use1_XX = rownonmiss(`Phi1_ts_XX') //Count the number of nonmiss, then if
>  not_to_use_XX==0, we set Phi1_XX==.
639.                 replace Phi1_XX=. if not_to_use1_XX==0
640.                 
.                 sum Phi1_XX 
641. 
.                 //scalar mean_IF1 = r(mean) //for test 
.                 
.                 if ("`cluster'"!=""){ // Clustering the variance //CLUSTER OPTION
642.                 cap drop Phi1_cXX
643.                 bysort `cluster': gegen Phi1_cXX = total(Phi1_XX)
644.                 bysort `cluster': replace Phi1_cXX=. if _n!=1
645.                 replace Phi1_cXX = Phi1_cXX/scalar(N_bar_c_XX)
646.                 
.                 sum Phi1_cXX 
647. 
.                 }
648.                 scalar sd_delta1_1XX = r(sd)/sqrt(r(sum_w)) //Doulo: In case of unbalanced panel, some
>  units do not contribute to the influence function at some dates, what about the N, in the asymptotic nor
> mal distribution?
649.                 
.                 scalar LB1_1XX = delta1_1XX - 1.96*sd_delta1_1XX
650.                 scalar UB1_1XX = delta1_1XX + 1.96*sd_delta1_1XX
651.         }
652.         
.         //was
.         if (`was_XX' == 1){
653.                 
.                 //Effect
.                 cap drop Phi2_XX
654.                 cap drop not_to_use2_XX
655.                 gegen Phi2_XX = rowtotal(`Phi2_ts_XX')
656.         gegen not_to_use2_XX = rownonmiss(`Phi2_ts_XX') //Count the number of nonmiss, then if not_to_
> use_XX==0, we set Phi2_XX==.
657.                 replace Phi2_XX=. if not_to_use2_XX==0
658.                 
.                 sum Phi2_XX 
659.                 //scalar mean_IF2 = r(mean) //for test
.                 scalar N_var = r(sum_w)
660.                 if ("`cluster'"!=""){ // Clustering the variance //CLUSTER OPTION
661.                 cap drop Phi2_cXX
662.                 bysort `cluster': gegen Phi2_cXX = total(Phi2_XX)
663.                 bysort `cluster': replace Phi2_cXX=. if _n!=1|S_XX==.
664.                 replace Phi2_cXX = Phi2_cXX/scalar(N_bar_c_XX)
665.                 
.                                 if ("`weights'"!=""){
666.                                 sum Phi2_cXX // use the weights of the cluster, which is the total of 
> the weightss of groups in that cluster.
667.                                 }
668.                                 else{
669.                                 sum Phi2_cXX 
670.                                 /*di as error "hh" r(sd)
>                                 di as error r(sum_w)
>                                 di as error scalar(N_var)*/
.                                 }
671.                 }
672.                 
.                 scalar sd_delta2_1XX = r(sd)/sqrt(r(sum_w)) 
673.                 
.                 scalar LB2_1XX = delta2_1XX - 1.96*sd_delta2_1XX
674.                 scalar UB2_1XX = delta2_1XX + 1.96*sd_delta2_1XX
675.                 
.         }
676. 
.         //iwas
.         if (`iwas_XX' == 1){
677.                 
.                 //Effect
.                 cap drop Phi3_XX
678.                 cap drop not_to_use3_XX
679.                 gegen Phi3_XX = rowtotal(`Phi3_ts_XX')
680.         gegen not_to_use3_XX = rownonmiss(`Phi3_ts_XX') //Count the number of nonmiss, then if not_to_
> use_XX==0, we set Phi2_XX==.
681.                 replace Phi3_XX=. if not_to_use3_XX==0
682.                 
.                 sum Phi3_XX 
683.                 //scalar mean_IF3 = r(mean) //for test
.                 
.                 if ("`cluster'"!=""){ // Clustering the variance //CLUSTER OPTION
684.                 cap drop Phi3_cXX
685.                 bysort `cluster': gegen Phi3_cXX = total(Phi3_XX)
686.                 bysort `cluster': replace Phi3_cXX=. if _n!=1
687.                 replace Phi3_XX = Phi3_XX/scalar(N_bar_c_XX)            
688.                                 if ("`weights'"!=""){
689.                                 sum Phi3_cXX // use the weights of the cluster, which is the total of 
> the weightss of groups in that cluster.
690.                                 }
691.                                 else{
692.                                 sum Phi3_cXX 
693.                                 }
694.                 }
695.                 
.                 scalar sd_delta3_1XX = r(sd)/sqrt(r(sum_w))
696. 
.                 scalar LB3_1XX = delta3_1XX - 1.96*sd_delta3_1XX
697.                 scalar UB3_1XX = delta3_1XX + 1.96*sd_delta3_1XX
698. 
.                 //DS: adding ar_ci — build aggregated RF/FS influence functions and compute AR CI
.                 if ("`ar_ci'"!=""){
699.                         cap drop Phi_Y_XX
700.                         cap drop not_to_useY_XX
701.                         gegen Phi_Y_XX = rowtotal(`Phi_Y_ts_XX')
702.                         gegen not_to_useY_XX = rownonmiss(`Phi_Y_ts_XX')
703.                         replace Phi_Y_XX =. if not_to_useY_XX==0
704. 
.                         cap drop Phi_D_XX
705.                         cap drop not_to_useD_XX
