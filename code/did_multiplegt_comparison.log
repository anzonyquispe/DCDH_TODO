.                 if ("`ar_ci'"!=""){
621.                         replace Phi_Y_`p'XX = [scalar(denom_deltaIV`p'XX)*Phi_Y_`p'XX + (scalar(delta_
> Y_`p'XX) - scalar(delta_Y_1XX))*(innerSumIV_denom_`p'XX - scalar(denom_deltaIV`p'XX))]/scalar(denom_delta
> IV_sum_XX)
622.                         local Phi_Y_ts_XX `Phi_Y_ts_XX' Phi_Y_`p'XX
623. 
.                         replace Phi_D_`p'XX = [scalar(denom_deltaIV`p'XX)*Phi_D_`p'XX + (scalar(delta_D_`
> p'XX) - scalar(delta_D_1XX))*(innerSumIV_denom_`p'XX - scalar(denom_deltaIV`p'XX))]/scalar(denom_deltaIV_
> sum_XX)
