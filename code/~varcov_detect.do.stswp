// Set the directory to load the datasets and to store the resulting log files


clear all
cd "/Users/anzony.quisperojas/Documents/GitHub/DCDH_TODO"

use "_data/wagepan.dta",clear

* Base variables
local y = "lwage"
local g = "nr"
local t = "year"
local d = "union"
//
// * Number of effects/placebos
local n_eff = 5
local n_pl = 2

* Cluster variables
local clust hisp

did_multiplegt_dyn `y' `g' `t' `d', graph_off effects(`n_eff') placebo(`n_pl') cluster(hisp)
matrix list e(V)

matrix dir

matrix list  didmgt_Var_all_XX
matrix eigenvalues real imag = didmgt_Var_all_XX
di "Eigenvalues of V:"
matrix list real



