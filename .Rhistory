next
}
# No controls - subsetting by agri_tree_am
res <- run_did(dat_sub, yvar, ~ 1)
if (!is.null(res)) {
cat(sprintf("ATE = %.4f (SE = %.4f)\n", res$ate, res$se))
p <- plot_event_study(res$es, res$ate, res$se, res$y0, ylim = ylims_list[[i]])
i <- i + 1
ggsave(file.path(out_dir, sprintf("plot_%s_agri_tree_am_%s.png", yvar, k)), p, width = 8, height = 6, dpi = 300)
if (is.null(all_results[["agri_tree_am"]][[yvar]])) all_results[["agri_tree_am"]][[yvar]] <- list()
all_results[["agri_tree_am"]][[yvar]][[k]] <- res
} else {
cat("FAILED\n")
}
}
}
